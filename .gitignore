# build output
dist/
# generated
.astro/
# deps
node_modules/
# рабочий кэш зеркалирования (сырьё и скриншоты) — не тащим в репо
_capture/
# ...но инструменты переноса нужны в репозитории
!_capture/scrape_page.mjs
!_capture/shot.mjs
!_capture/build_quest.py
!_capture/build_venue.py
!_capture/build_misc.py
!_capture/check_pages.py
!_capture/check_assets.py
!_capture/compare.py
!_capture/encrypt_site.py
!_capture/build_holiday.py
!_capture/dump_page.py
!_capture/extract_recs.py
!_capture/tabs_shot.mjs
