/var/log/nginx/chezakvest.*.log {
    daily
    missingok
    rotate 14
    maxage 14
    compress
    delaycompress
    notifempty
    create 0640 www-data adm
    sharedscripts
    ignoreduplicates
    postrotate
        if [ -s /run/nginx.pid ]; then
            kill -USR1 "$(cat /run/nginx.pid)"
        fi
    endscript
}
