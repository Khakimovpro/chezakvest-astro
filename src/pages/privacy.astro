---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VenuesSection from '../components/VenuesSection.astro';
import policyHtml from '../data/privacy-policy.html?raw';
import '../styles/page.css';

// This route deliberately mirrors the live page's head: the source has a
// title but no description or document H1. The visible title below is a Tilda
// title block, not an H1, and keeping that distinction prevents invented SEO.
const title = 'Политика обработки персональных данных';
const description = '';
const keywords = '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Public assets are normally root-absolute, but this page must also render from the checked
// GitHub Pages base path. Keep the source tile local while resolving it from Astro's configured
// base. Внутри `<style is:inline>{`...`}</style>` подстановка не выполняется и `${base}` уходил
// в CSS буквально, поэтому строка собирается здесь и вставляется через set:html.
const baseAwareCss = `
  @font-face {
    font-family: 'Nunito';
    font-style: normal;
    font-weight: 200 1000;
    font-display: swap;
    src: url('${base}/assets/fonts.gstatic.com/s/nunito/v32/XRXV3I6Li01BKofIMeaBXso.woff2') format('woff2');
    unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
  }

  body.privacy-page-body {
    background-image: url('${base}/assets/static.tildacdn.com/tild3463-3931-4833-b565-346437376365/_GPT_light.png');
    background-repeat: repeat;
    background-size: auto;
    background-position: center;
  }
`;
---
<Layout
  title={title}
  description={description}
  keywords={keywords}
  path="/privacy"
  noindex={true}
  robots="noindex"
  ogImage={null}
  preloadImage={null}
  bodyClass="privacy-page-body"
>
  <Header />
  <main class="privacy-parity">
    <section class="privacy-parity__hero" aria-label="Политика обработки персональных данных">
      <div class="privacy-parity__inner">
        <div class="privacy-parity__requisites">
          <p>ИП Мелешкин Юрий Иванович</p>
          <p>ИНН 164409771610</p>
          <p>ОГРНИП: 322169000094990</p>
        </div>
        <div class="privacy-parity__title">Политика в отношении обработки персональных данных</div>
      </div>
    </section>

    <section class="privacy-parity__copy" aria-label="Текст политики">
      <div class="privacy-parity__inner" set:html={policyHtml}></div>
    </section>

    <VenuesSection id="privacy-venues" base={base} />
  </main>
  <Footer />
</Layout>

<style is:inline set:html={baseAwareCss}></style>

<style>
  /* The live policy is set in Nunito. Keep the matching Cyrillic face local so
     this static route does not create a font request to Google. */
  .privacy-parity__inner {
    width: calc(100% - 40px);
    max-width: 960px;
    margin: 0 auto;
  }

  .privacy-parity__hero {
    padding: 105px 0 75px;
  }

  .privacy-parity__requisites {
    padding: 10px 0 40px;
    color: #333;
    font-family: 'Nunito', Arial, sans-serif;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 2.5px;
    line-height: 1.4;
    text-align: right;
    text-transform: uppercase;
  }

  .privacy-parity__requisites p {
    margin: 0;
  }

  .privacy-parity__title {
    padding: 8px 0 3px;
    color: #333;
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 42px;
    font-weight: 700;
    line-height: 1.23;
    text-align: center;
    text-transform: uppercase;
  }

  .privacy-parity__copy {
    padding: 60px 0;
    color: #333;
    font-family: 'Nunito', Arial, sans-serif;
    font-size: 20px;
    font-weight: 300;
    line-height: 1.55;
  }

  .privacy-parity__copy .privacy-parity__inner {
    padding: 8px 0 6px;
  }

  .privacy-parity__copy :global(ul) {
    margin: 0 0 10px;
    padding-left: 20px;
    list-style: disc;
  }

  .privacy-parity__copy :global(li) {
    margin: 0;
    padding: 0;
  }

  .privacy-parity :global(.venues) {
    margin-top: 0;
    padding-top: 20px;
  }

  .privacy-parity :global(.venues .section-title) {
    font-size: 40px;
  }

  @media (max-width: 640px) {
    .privacy-parity__hero {
      padding: 105px 0 75px;
    }

    .privacy-parity__requisites {
      padding: 10px 0 40px;
      font-size: 12px;
      line-height: 1.4;
    }

    .privacy-parity__title {
      font-size: 30px;
      line-height: 1.23;
    }

    .privacy-parity__copy {
      padding: 60px 0;
      font-size: 16px;
      line-height: 1.45;
    }

    .privacy-parity :global(.venues) {
      padding-top: 20px;
    }

    .privacy-parity :global(.venues .section-title) {
      font-size: 20px;
    }

    .privacy-parity :global(.venues__sub) {
      max-width: 310px;
      font-size: 14px;
      line-height: 1.15;
    }

    .privacy-parity :global(.venues__chips) {
      gap: 14px;
      margin: 16px 0;
    }

    .privacy-parity :global(.chip) {
      padding: 9px 16px;
      font-size: 12px;
    }

    .privacy-parity :global(.venues__map) {
      border-radius: 12px;
    }
  }
</style>
