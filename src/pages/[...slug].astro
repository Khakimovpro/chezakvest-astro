---
// Единый роут внутренних страниц: слаг = имя файла в src/data/pages/.
// Тип страницы берётся из поля "type" — сейчас реализован quest, дальше добавятся venue/holiday.
import QuestPage from '../layouts/QuestPage.astro';

export async function getStaticPaths() {
  const files = import.meta.glob('../data/pages/*.json', { eager: true });
  const all = Object.entries(files).map(([path, mod]) => {
    const page = mod.default ?? mod;
    return { ...page, slug: page.slug || path.split('/').pop().replace('.json', '') };
  });
  // короткая карточка каждой страницы — из неё собирается перелинковка там, где её нет в оригинале
  const index = all.map((p) => ({ slug: p.slug, t: p.hero?.h1 || p.seo?.h1 || p.slug, img: p.hero?.bg }));
  return all.map((page) => ({ params: { slug: page.slug }, props: { page, index } }));
}

const { page, index } = Astro.props;
---
{page.type === 'quest' && <QuestPage page={page} index={index} />}
