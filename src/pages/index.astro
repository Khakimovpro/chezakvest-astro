---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuestCard from '../components/QuestCard.astro';
import CallbackForm from '../components/CallbackForm.astro';
import QuizPop from '../components/QuizPop.astro';
import Reviews from '../components/Reviews.astro';
import VenuesSection from '../components/VenuesSection.astro';
import ZoomImg from '../components/ZoomImg.astro';
import site from '../data/site.json';
import venues from '../data/venues.json';
import { siteHref } from '../lib/urls.js';
import '../styles/page.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p) => (p ? base + p : '#');
const link = (h) => siteHref(base, h);

const modules = import.meta.glob('../data/pages/*.json', { eager: true });
const pages = Object.entries(modules).map(([filePath, module]) => {
  const page = module.default ?? module;
  return { ...page, slug: page.slug || filePath.split('/').pop().replace('.json', '') };
});
const questsBySlug = Object.fromEntries(pages
  .filter((page) => page.type === 'quest')
  .map((page) => [page.slug, page]));
const venuesBySlug = Object.fromEntries(pages
  .filter((page) => page.type === 'venue')
  .map((page) => [page.slug, {
    slug: page.slug,
    address: (page.breadcrumbs || []).slice(-1)[0]?.t || page.hall?.address || page.seo?.h1 || '',
  }]));
const homeCards = site.cards.map((card) => {
  const canonicalHref = link(card.href);
  const quest = questsBySlug[canonicalHref.replace(/^\/+|\/+$/g, '')];
  // Tilda catalog thumbnails were often 359px delivery derivatives. Reuse the
  // linked quest's local hero, which is the canonical first-party image and is
  // already available at the responsive source size.
  return {
    ...card,
    photo: quest?.hero?.bg || card.photo,
    photoSet: quest?.hero?.bgset || null,
    venue: venuesBySlug[quest?.venueSlug],
  };
});

// категории в порядке появления
const catOrder = [];
for (const c of homeCards) if (!catOrder.includes(c.cat)) catOrder.push(c.cat);
const anchorForCat = {
  'Квесты в Ростове': 'kvesty',
  'Страшные квесты в Ростове': 'strashnye',
  'Прятки в лабиринте 200м²': 'pryatki',
  'Квест-шоу на площадке 200м²': 'kvestshou',
  'VR-игры на арене 300м²': 'vr',
};
const cardsByCat = (cat) => homeCards.filter((c) => c.cat === cat);
const s = site;
const tabs = s.tabs.map((tab, index) => ({
  ...tab,
  tabId: `catalog-tab-${index}`,
  panelId: `catalog-panel-${index}`,
}));
const panelIdByCategory = new Map(tabs.map((tab) => [tab.cat, tab.panelId]));
const origin = 'https://xn--80aehcht5ci1b.xn--p1ai';
const homeHeroSrcset = `${asset('/assets/_static/hero_dungeon_760.webp')} 760w, ${asset('/assets/_static/hero_dungeon_900.webp')} 900w, ${asset('/assets/_static/hero_dungeon_1200.webp')} 1479w`;
const homeHeroPreload = {
  href: asset('/assets/_static/hero_dungeon_760.webp'),
  srcset: homeHeroSrcset,
  sizes: '(max-width:700px) 100vw, 1200px',
};
const jsonld = [{
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origin}/#organization`,
      name: 'Чё за Квест',
      url: `${origin}/`,
      logo: `${origin}${s.header.logo}`,
      telephone: s.header.phone,
      sameAs: [s.header.vk],
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}/#website`,
      name: 'Чё за Квест',
      url: `${origin}/`,
      inLanguage: 'ru-RU',
      publisher: { '@id': `${origin}/#organization` },
    },
  ],
}];
---

<Layout jsonld={jsonld} preloadImage={homeHeroPreload}>
  <Header />

  <main>
    <!-- ============ ГЕРОЙ ============ -->
    <section class="hero">
      <div class="container-wide">
      <div class="hero__panel">
        <img class="hero__bg" src={asset('/assets/_static/hero_dungeon_1200.webp')}
             srcset={homeHeroSrcset}
             sizes="(max-width:700px) 100vw, 1200px"
             alt="" fetchpriority="high" width="1479" height="891" />
        <div class="hero__content">
          <h1 class="hero__title"><span>{s.hero.h1line1}</span><br />{s.hero.h1line2}</h1>
          <p class="hero__sub">{s.hero.subtitle}</p>
        </div>
        <img class="hero__ghost" src={asset(s.hero.ghost)} alt="Привидение — талисман «Чё за Квест»" width="665" height="773" fetchpriority="low" decoding="async" />
        <div class="hero__cta">
          <a class="hero__btn-calc" href={link(s.hero.btnCalcHref)} data-quiz={s.quiz.main}>{s.hero.btnCalc}</a>
          <a class="hero__btn-pick btn-orange" href={link(s.hero.btnPickHref)} data-quiz={s.quiz.main}>{s.hero.btnPick}</a>
        </div>
      </div>
      </div>
    </section>

    <!-- ============ ПРОМО-СЛАЙДЕР ============ -->
    <section class="promo">
      <!-- container (1160), НЕ container-wide: слайдер оригинала уже героя (поля 140px), как в Tilda -->
      <div class="promo__wrap container">
        <div class="slider" id="promo-slider" role="region" aria-roledescription="carousel" aria-label="Промо-предложения" aria-live="off">
          <div class="slider__viewport">
            <div class="slider__track">
              {s.slider.map((sl, i) => (
                <div class="slider__slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} из ${s.slider.length}`} aria-hidden={i === 0 ? 'false' : 'true'}>
                  {i === 0
                    ? <img src={asset(sl.img)} alt={sl.alt} width="1010" height="375" decoding="async" />
                    : <img data-src={asset(sl.img)} alt={sl.alt} width="1010" height="375" loading="lazy" decoding="async" />}
                </div>
              ))}
            </div>
          </div>
          <button class="slider__arrow slider__arrow--prev" type="button" aria-label="Предыдущий слайд">
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="none" stroke="#9b3800" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/></svg>
          </button>
          <button class="slider__arrow slider__arrow--next" type="button" aria-label="Следующий слайд">
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="none" stroke="#9b3800" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/></svg>
          </button>
          <button class="slider__pause" type="button" aria-pressed="false" aria-label="Остановить автопрокрутку" title="Остановить автопрокрутку">
            <span class="slider__pause-icon" aria-hidden="true">Ⅱ</span>
            <span class="visually-hidden slider__pause-text">Остановить автопрокрутку</span>
          </button>
          <div class="slider__dots" id="promo-dots" role="group" aria-label="Навигация по слайдам"></div>
        </div>
      </div>
    </section>

    <!-- ============ КАТАЛОГ (табы + карточки) ============ -->
    <section class="catalog" id="catalog">
      <div class="container">
        <!-- Табы (десктоп) -->
        <div class="tabs" role="tablist" aria-label="Категории игр">
          {tabs.map((t, i) => (
            <button class={`tab${i === 0 ? ' is-active' : ''}`} id={t.tabId} data-cat={t.cat} data-panel={t.panelId} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={t.panelId} tabindex={i === 0 ? '0' : '-1'}>
              {i !== 0 && <span class="tab__mark" aria-hidden="true">◆</span>}{t.t}{t.badge && <span class="tab__badge" aria-hidden="true">★</span>}
            </button>
          ))}
        </div>
        <!-- Дропдаун (мобайл) -->
        <div class="tabs-mobile">
          <select id="cat-select" aria-label="Категория игр">
            {tabs.map((t) => (<option value={t.cat}>{t.t}</option>))}
          </select>
          <svg class="tabs-mobile__chev" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="#1f2933" stroke-width="2" stroke-linecap="round" d="M6 9l6 6 6-6"/></svg>
        </div>
      </div>

      <div class="catalog__panels">
        <div class="catalog__panel" id={tabs[0].panelId} data-cat="all" role="tabpanel" aria-labelledby={tabs[0].tabId}>
          {catOrder.map((cat) => (
            <div class="catblock container" data-cat={cat} data-panel={panelIdByCategory.get(cat)} id={anchorForCat[cat]}>
              <h2 class="section-title catblock__title">{cat === 'Квесты в Ростове' ? 'Квесты в Ростове' : cat}</h2>
              <div class="grid">
                {cardsByCat(cat).map((card) => (
                  <QuestCard card={card} base={base} />
                ))}
              </div>
            </div>
          ))}
        </div>
        {tabs.slice(1).map((tab) => (
          <div class="catalog__panel" id={tab.panelId} data-cat={tab.cat} role="tabpanel" aria-labelledby={tab.tabId} hidden></div>
        ))}
      </div>
    </section>

    <!-- ============ ПРАЗДНИК + СТАТЫ ============ -->
    <section class="party" id="party">
      <div class="container">
        <h2 class="section-title">{s.stats.title}</h2>
        <p class="section-sub">{s.stats.subtitle}</p>
      </div>
      <div class="container-wide">
        <div class="party__card">
          <img class="party__bg" src={asset(s.stats.bg)} alt="Дети на празднике в квесте" width="1200" height="550" loading="lazy" decoding="async" />
          <div class="party__stats">
            {s.stats.items.map((it) => (
              <div class="pstat">
                {it.big
                  ? <img class="pstat__num" src={asset(s.stats.numImg)} alt="" width="60" height="73" loading="lazy" />
                  : <img class="pstat__icon" src={asset(it.icon)} alt="" width="56" height="56" loading="lazy" />}
                <span class="pstat__t">{it.t}</span>
              </div>
            ))}
          </div>
          <div class="party__btnrow"><a class="btn-grad" href="#callback">{s.stats.btn}</a></div>
        </div>
      </div>
    </section>

    <!-- ============ СЕРТИФИКАТ ============ -->
    <section class="gift">
      <div class="container gift__inner">
        <img class="gift__arrow gift__arrow--l" src={asset(s.gift.arrowL)} alt="" width="70" height="60" loading="lazy" />
        <img class="gift__arrow gift__arrow--r" src={asset(s.gift.arrowR)} alt="" width="70" height="60" loading="lazy" />
        <h2 class="section-title gift__title">{s.gift.title}</h2>
        <p class="gift__text">{s.gift.text}</p>
        <img class="gift__cert" src={asset(s.gift.cert)} alt="Подарочный сертификат «Чё за Квест»" width="503" height="358" loading="lazy" decoding="async" />
        <div class="gift__consult">
          <img class="gift__mark" src={asset(s.consult.logo)} alt="" width="80" height="69" loading="lazy" />
          <a class="btn-grad" href="#callback">{s.consult.btn}</a>
        </div>
      </div>
    </section>

    <!-- ============ ОТЗЫВЫ (локальный снимок без стороннего виджета) ============ -->
    <Reviews title={s.reviews.title} />

    <!-- ============ ФОРМА «ЕСТЬ ВОПРОС?» ============ -->
    <CallbackForm id="home-callback" sectionId="callback" />

    <!-- ============ ГАЛЕРЕЯ ============ -->
    <!-- построчная justified-раскладка (как в Tilda): ряды одной высоты, ширина фото по пропорции -->
    <section class="gallery">
      <div class="gallery__inner">
        {s.gallery.map((g, i) => (
          <ZoomImg src={asset(g.img)} group="home-gallery" imageClass="gallery__img" buttonClass="zoomable--gallery"
                   style={`flex-basis:${Math.round(g.ar * 310)}px;flex-grow:${g.ar}`}
                   width={Math.round(g.ar * 310)} height="310"
                   alt={`Фото с праздника в «Чё за Квест» ${i + 1}`} loading="lazy" decoding="async" reveal="zoom" />
        ))}
      </div>
    </section>

    <!-- ============ НАШИ ПЛОЩАДКИ ============ -->
    <VenuesSection id="contacts" base={base} title={venues.title} subtitle={venues.subtitle}
                   chips={venues.chips} mapEmbed={venues.mapEmbed} />
  </main>

  <Footer />
  <QuizPop id={s.quiz.main} />
</Layout>

<script>
  import '../scripts/main.js';
</script>
