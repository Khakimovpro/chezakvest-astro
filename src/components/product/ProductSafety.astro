---
import ProductSectionHeader from './ProductSectionHeader.astro';
import ProductButton from './ProductButton.astro';
import ProductIconList from './ProductIconList.astro';
import Icon from './Icon.astro';
import { typograf } from '../../lib/typograf.js';
import ProductInfoCard from './ProductInfoCard.astro';
const { data, surface = 'ink' } = Astro.props;
---
{data?.items?.length > 0 && <section class={`product-section product-section--${surface}`}><div class="container"><ProductSectionHeader title={data.title} /><ul class:list={['product-safety', { 'product-safety--four': data.items.length === 4 }]} data-product-reveal="group">{data.items.map((item) => <ProductInfoCard item={item} />)}</ul></div></section>}
