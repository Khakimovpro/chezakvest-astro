---
const { data } = Astro.props;
---
{data && <section class="product-section product-section--dark"><div class="container"><h2>{data.title}</h2><ul class="product-safety">{data.items.map((item) => <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 20 6v5c0 5-3.4 9.5-8 11-4.6-1.5-8-6-8-11V6l8-4Zm-1 13 5-5-1.5-1.5-3.5 3.5-1.5-1.5L8 12l3 3Z" fill="currentColor"/></svg><span>{item}</span></li>)}</ul></div></section>}
