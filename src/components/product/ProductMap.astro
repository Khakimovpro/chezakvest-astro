---
import ProductSectionHeader from './ProductSectionHeader.astro';
import ProductButton from './ProductButton.astro';
import ProductIconList from './ProductIconList.astro';
import Icon from './Icon.astro';
import { typograf } from '../../lib/typograf.js';
import LazyMap from '../LazyMap.astro';
const { data, base = '', surface = 'ground' } = Astro.props;
---
{data?.map?.embedUrl && data.map?.img && <section class={`product-section product-section--${surface}`} id="karta"><div class="container product-map"><div class="product-prose"><ProductSectionHeader title="Адрес и карта" /><p class="product-map__address"><Icon name="map-pin" />{typograf(data.address)}</p><ProductIconList items={data.howto?.variants?.map((item) => ({ ...(typeof item === 'string' ? {t: item} : item), icon: 'footprints' }))} fallback="footprints" />{data.routeUrl && <ProductButton href={data.routeUrl} target="_blank" rel="noopener" size="lg" icon="route" block>Построить маршрут</ProductButton>}</div><div data-product-reveal><LazyMap embedUrl={data.map.embedUrl} poster={`${base}${data.map.img}`} alt={`Карта: ${data.address}`} title={`Карта площадки: ${data.address}`} className="venues__map product-map__embed" /></div></div></section>}
