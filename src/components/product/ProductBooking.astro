---
import PrebookingForm from '../PrebookingForm.astro';
import scheduleStyles from '../../styles/source-schedule.css?raw';
const { data, phoneHref, phone, wa } = Astro.props;
---
{data && <>
  <!-- Calendar markup arrives from the booking service and depends on these scoped rules. -->
  <style set:html={scheduleStyles}></style>
  <section class="product-section product-section--booking" id="booking"><div class="container"><h2 class="section-title">{data.title || 'Онлайн-бронирование'}</h2>{data.lines?.map((line) => <p class="product-booking__line">{line}</p>)}<div class="product-schedule" data-source-schedule={data.calendarId} aria-live="polite"></div><div class="product-booking__fallback" data-product-booking-fallback hidden><p>Если расписание временно недоступно, позвоните, напишите нам или оставьте предварительную заявку.</p><p><a href={phoneHref}>{phone}</a> · <a href={wa} target="_blank" rel="noopener">WhatsApp</a></p><PrebookingForm id="product-booking" quest={data.quest} calendarId={data.calendarId} /></div></div></section><script>import { initSourceSchedule } from '../../scripts/source-schedule.js'; const schedule = document.querySelector('[data-source-schedule]'); const fallback = document.querySelector('[data-product-booking-fallback]'); let fallbackTimer; schedule?.addEventListener('source-schedule-status', (event) => { const status = event.detail?.status; if (status === 'loading') fallbackTimer = setTimeout(() => { if (fallback) fallback.hidden = false; }, 8000); if (status === 'loaded' || status === 'error') { clearTimeout(fallbackTimer); if (fallback) fallback.hidden = status !== 'error'; } }); initSourceSchedule();</script>
</>}
