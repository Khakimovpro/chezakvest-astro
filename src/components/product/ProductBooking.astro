---
import PrebookingForm from '../PrebookingForm.astro';
import scheduleStyles from '../../styles/source-schedule.css?raw';
const { data, phoneHref, phone, wa } = Astro.props;
---
{data && <>
  <!-- Calendar markup arrives from the booking service and depends on these scoped rules. -->
  <style set:html={scheduleStyles}></style>
  <section class="product-section product-section--booking" id="booking"><div class="container"><h2 class="section-title">{data.title || 'Онлайн-бронирование'}</h2>{data.lines?.map((line) => <p class="product-booking__line">{line}</p>)}<div class="product-schedule" data-source-schedule={data.calendarId} aria-live="polite"></div><div class="product-booking__fallback" data-product-booking-fallback hidden><p>Если расписание временно недоступно, позвоните, напишите нам или оставьте предварительную заявку.</p><p><a href={phoneHref}>{phone}</a> · <a href={wa} target="_blank" rel="noopener">WhatsApp</a></p><PrebookingForm id="product-booking" quest={data.quest} calendarId={data.calendarId} /></div></div></section><script>
  import { initSourceSchedule } from '../../scripts/source-schedule.js';
  document.querySelectorAll('.product-schedule[data-source-schedule]').forEach((schedule) => {
    const fallback = schedule.parentElement?.querySelector('[data-product-booking-fallback]');
    let fallbackTimer;
    const prepareSlots = () => {
      schedule.querySelectorAll('.quest_calendar .label_quest').forEach((slot) => {
        const available = slot.matches('.click_load_item:not(.close_item)') && !slot.hasAttribute('disabled');
        slot.setAttribute('role', 'button');
        slot.setAttribute('tabindex', available ? '0' : '-1');
        slot.setAttribute('aria-disabled', String(!available));
      });
    };
    schedule.addEventListener('keydown', (event) => {
      const slot = event.target.closest('.label_quest[role="button"]');
      if (!slot || slot.matches('button') || !['Enter', ' '].includes(event.key)) return;
      event.preventDefault();
      if (!event.repeat && slot.getAttribute('aria-disabled') === 'false') slot.click();
    });
    schedule.addEventListener('source-schedule-status', (event) => {
      const status = event.detail?.status;
      if (status === 'loading') fallbackTimer = setTimeout(() => { if (fallback) fallback.hidden = false; }, 8000);
      if (status === 'loaded' || status === 'error') {
        clearTimeout(fallbackTimer);
        if (fallback) fallback.hidden = status !== 'error';
        if (status === 'loaded') prepareSlots();
      }
    });
  });
  initSourceSchedule();
</script>
</>}
