---
import ProductSectionHeader from './ProductSectionHeader.astro';
import ProductButton from './ProductButton.astro';
import ProductIconList from './ProductIconList.astro';
import Icon from './Icon.astro';
import { typograf } from '../../lib/typograf.js';
import { siteHref } from '../../lib/urls.js';
const { data, base = '', surface = 'ground' } = Astro.props;
---
{data?.items?.length > 0 && <section class={`product-section product-section--${surface}`} id={data.id || 'zaly'}><div class="container"><ProductSectionHeader title={data.title} lead={data.subtitle} /><ul class="product-halls" data-product-reveal>{data.items.map((item) => <li><img src={`${base}${item.img}`} alt={`Зал: ${item.t}`} width="600" height="400" loading="lazy" decoding="async" /><div><h3>{item.href ? <a href={siteHref(base,item.href)}>{typograf(item.t)}</a> : typograf(item.t)}</h3><ProductIconList items={[item.size && {t:item.size,icon:'ruler'},item.capacity && {t:item.capacity,icon:'users'},item.format && {t:item.format,icon:'sparkles'}].filter(Boolean)} />{item.equipment?.length > 0 && <><p class="product-halls__equipment-title">Оснащение</p><ProductIconList items={item.equipment} variant="check" class="product-halls__equipment" /></>}</div></li>)}</ul><div class="product-halls__cta"><ProductButton href="#prazdnik" size="lg" icon="arrow-right" iconEnd block>{data.cta || 'Забронировать дату'}</ProductButton></div></div></section>}
