---
const { data } = Astro.props;
const score = String(data?.data?.ratings?.summaryWeight || '').replace('.', ',');
const count = new Intl.NumberFormat('ru-RU').format(data?.data?.counts?.summary || 0);
---
{data?.items?.length > 0 && <section class="product-section product-section--gray" id="otzyvy"><div class="container"><p class="product-kicker">Рейтинг компании</p><h2 class="section-title">{data.title}</h2><p class="product-reviews__summary">★ {score} · {count} отзывов</p><ul class="product-reviews__services">{Object.values(data.data.services || {}).filter((item) => item.count >= 10).map((item) => <li><a href={item.url} target="_blank" rel="noopener">{item.name}: {item.rating} ({item.count})</a></li>)}</ul><div class="product-reviews__grid">{data.items.map((item, index) => <article class:list={['product-review', { 'product-review--hidden': index > 5 }]} data-product-review><div>★★★★★ <time datetime={item.date_create.split('.').reverse().join('-')}>{item.date_create}</time></div><p>{item.message}</p><footer><strong>{item.username}</strong><span>{data.data.services[String(item.service)]?.name} · {item.firmName}</span></footer></article>)}</div>{data.items.length > 6 && <button class="product-more" type="button" data-product-more>Показать ещё</button>}<a class="product-reviews__all" href={data.data.feedbackUrl} target="_blank" rel="noopener">Все отзывы</a></div></section><script>document.querySelector('[data-product-more]')?.addEventListener('click', (event) => { document.querySelectorAll('[data-product-review]').forEach((card) => card.classList.remove('product-review--hidden')); event.currentTarget.hidden = true; });</script>}
