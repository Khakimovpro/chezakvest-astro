---
import HlsVideo from '../HlsVideo.astro';
const { data } = Astro.props;
---
{data && <section class="product-section product-section--dark" id="video"><div class="container product-video"><div><p class="product-kicker">Трейлер</p><h2>{data.title}</h2><p>Посмотрите атмосферу игры до бронирования.</p></div><HlsVideo slug={data.slug} title={data.title} /></div></section>}
