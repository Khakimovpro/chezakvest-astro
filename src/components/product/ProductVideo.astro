---
import ProductSectionHeader from './ProductSectionHeader.astro';
import ProductButton from './ProductButton.astro';
import ProductIconList from './ProductIconList.astro';
import Icon from './Icon.astro';
import { typograf } from '../../lib/typograf.js';
import HlsVideo from '../HlsVideo.astro';
const { data, surface = 'ink' } = Astro.props;
const videos = data?.items?.length ? data.items : data?.slug ? [data] : [];
const party = data?.kind === 'party';
---
{videos.length > 0 && <section class={`product-section product-section--${surface}`} id="video">
  <div class:list={['container', 'product-video', { 'product-video--multiple': videos.length > 1 }]}>
    <ProductSectionHeader title={data.title} eyebrow={party ? 'Как проходят наши праздники' : undefined} lead={data.intro || (party ? 'Посмотрите живые моменты с наших праздников.' : 'Посмотрите атмосферу игры до бронирования.')} />
    <div class="product-video__info"><ProductIconList items={data.points} variant="tile" tone="ink" class="product-video__points" /><div class="product-video__actions"><ProductButton href={party ? '#prazdnik' : '#booking'} size="lg" icon={party ? 'arrow-right' : 'calendar-check'} iconEnd={party} block>{party ? 'Узнать стоимость' : 'Забронировать'}</ProductButton></div></div>
    <div class="product-video__media" data-product-reveal>{videos.map((video) => <HlsVideo slug={video.slug} title={video.title} />)}</div>
  </div>
</section>}
