---
import ProductSectionHeader from './ProductSectionHeader.astro';
import ProductButton from './ProductButton.astro';
import ProductSlider from './ProductSlider.astro';
import ProductMediaCard from './ProductMediaCard.astro';
const { data, base = '', group = 'product-gallery', surface = 'ground', continue: continuation = false } = Astro.props;
const asset = (path) => `${base}${path}`;
const grid = data?.layout === 'grid';
---
{data?.items?.length > 0 && <section class:list={['product-section', `product-section--${surface}`, { 'product-section--continue': continuation }]}><div class="container"><ProductSectionHeader title={data.title} />{grid ? <><div class="product-photo-grid" data-product-photo-grid data-product-reveal>{data.items.map((item, index) => <ProductMediaCard src={asset(item.src || item)} group={group} alt={item.alt || 'Фото квеста'} width="800" height="560" imageClass="product-photo-grid__image" buttonClass={`product-photo-grid__item${index > 5 ? ' product-photo-grid__item--hidden' : ''}`} loading="lazy" decoding="async" />)}</div>{data.items.length > 6 && <ProductButton variant="secondary" icon="chevron-down" iconEnd block data-product-gallery-more>Показать все фото ({data.items.length})</ProductButton>}</> : <ProductSlider items={data.items} base={base} group={group} label={data.title} />}</div></section>}

<noscript><style is:global>.product-page .product-photo-grid__item--hidden { display: block !important; } .product-page [data-product-gallery-more] { display: none; }</style></noscript>
