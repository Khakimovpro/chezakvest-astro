---
import ZoomImg from '../ZoomImg.astro';
const { data, base = '', group = 'product-gallery' } = Astro.props;
const asset = (path) => `${base}${path}`;
---
{data?.items?.length > 0 && <section class="product-section product-section--white"><div class="container"><h2 class="section-title">{data.title}</h2><div class="product-rail" data-product-rail><button class="product-rail__arrow" type="button" data-product-previous aria-label="Предыдущая фотография">‹</button><div class="product-rail__track">{data.items.map((item, index) => <ZoomImg src={asset(item.src || item)} group={group} alt={item.alt || 'Фото квеста'} width="800" height="560" imageClass="product-rail__image" buttonClass="product-rail__item" loading={index ? 'lazy' : 'eager'} decoding="async" />)}</div><button class="product-rail__arrow" type="button" data-product-next aria-label="Следующая фотография">›</button></div></div></section>}
