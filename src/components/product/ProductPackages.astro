---
import ProductSectionHeader from './ProductSectionHeader.astro';
import ProductButton from './ProductButton.astro';
import ProductIconList from './ProductIconList.astro';
import Icon from './Icon.astro';
import { typograf } from '../../lib/typograf.js';
const { data } = Astro.props;
const groups = (data?.groups || []).filter((group) => group.items?.length > 0);
const activeIndex = Math.max(0, groups.findIndex((group) => group.items.some((item) => item.badge === 'Хит продаж')));
const featuredFirst = (items = []) => [...items].sort((left, right) => Number(right.badge === 'Хит продаж') - Number(left.badge === 'Хит продаж'));
---
{groups.length > 0 && <section class="product-section product-section--ground" id={data.id || 'pakety'}><div class="container"><ProductSectionHeader title={data.title} lead={data.subtitle} /><div class="product-packages" data-product-packages><div class="product-packages__tabs" role="tablist" aria-label="Формат праздника">{groups.map((group, index) => <button type="button" role="tab" id={`package-tab-${index}`} aria-controls={`package-panel-${index}`} aria-selected={index === activeIndex ? 'true' : 'false'} tabindex={index === activeIndex ? '0' : '-1'} data-product-package-tab={index} aria-label={group.tab}>{group.tab.replace(/^Праздник\s+/u, '').replace(/^./u, (letter) => letter.toLocaleUpperCase('ru'))}</button>)}<span class="product-packages__indicator" aria-hidden="true"></span></div>{groups.map((group, groupIndex) => <div class="product-packages__group" role="tabpanel" id={`package-panel-${groupIndex}`} aria-labelledby={`package-tab-${groupIndex}`} data-product-package-panel={groupIndex}><h3 class="visually-hidden">{typograf(group.tab)}</h3><p class="product-packages__swipe-hint">Листайте пакеты <Icon name="arrow-right" size={16} /></p><div class="product-packages__grid">{featuredFirst(group.items).map((item) => <article class:list={{'product-package--featured': item.badge === 'Хит продаж'}}><header class="product-packages__header"><div class="product-packages__badge-slot">{item.badge && <p class="product-packages__badge"><Icon name="flame" size={16} />{item.badge}</p>}</div><h4>{typograf(item.name)}</h4><p class="product-packages__duration"><Icon name="clock" size={16} />{typograf(item.duration)}</p></header><ul>{(item.includes || []).map((include) => <li><strong class="product-packages__item-name">{typograf(include.t)}</strong>{include.time && <span>{typograf(include.time)}</span>}</li>)}</ul>{item.bullets?.length > 0 && <ProductIconList items={item.bullets} variant="check" class="product-packages__bullets" />}<div class="product-packages__action"><ProductButton href="#prazdnik" variant={item.badge === 'Хит продаж' ? 'primary' : 'secondary'} block>{data.cta || 'Узнать стоимость'}</ProductButton></div></article>)}</div></div>)}</div></div></section><script>document.querySelectorAll('[data-product-packages]').forEach((root) => { const tabs = [...root.querySelectorAll('[data-product-package-tab]')]; const panels = [...root.querySelectorAll('[data-product-package-panel]')]; const tablist = root.querySelector('[role=tablist]'); tablist.style.setProperty('--product-tab-count', String(tabs.length)); const select = (index, focus = false) => { tablist.toggleAttribute('data-instant', focus); tablist.style.setProperty('--product-tab-index', String(index)); tabs.forEach((tab, current) => { const active = current === index; tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; }); panels.forEach((panel, current) => { panel.hidden = current !== index; }); if (focus) tabs[index]?.focus(); }; const initial = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true'); select(initial < 0 ? 0 : initial); tabs.forEach((tab, index) => { tab.addEventListener('click', () => select(index)); tab.addEventListener('keydown', (event) => { const keys = { ArrowRight: 1, ArrowLeft: -1, Home: -Infinity, End: Infinity }; if (!(event.key in keys)) return; event.preventDefault(); const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + keys[event.key] + tabs.length) % tabs.length; select(next, true); }); }); });</script>}
