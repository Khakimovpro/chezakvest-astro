---
const { data } = Astro.props;
---

{data?.groups?.some((group) => group.items?.length > 0) && <section class="product-section product-section--white" id={data.id || 'pakety'}><div class="container"><h2 class="section-title">{data.title}</h2>{data.subtitle && <p class="section-sub">{data.subtitle}</p>}<div class="product-packages">{data.groups.filter((group) => group.items?.length > 0).map((group) => <div class="product-packages__group"><h3>{group.tab}</h3><div class="product-packages__grid">{group.items.map((item) => <article>{item.badge && <p class="product-packages__badge">{item.badge}</p>}<h4>{item.name}</h4><p>{item.duration}</p><ul>{(item.includes || []).map((include) => <li>{include.t}{include.time && <span>{include.time}</span>}</li>)}</ul>{item.bullets?.length > 0 && <ul class="product-packages__bullets">{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}<a class="btn-orange" href="#prazdnik">{data.cta || 'Узнать стоимость'}</a></article>)}</div></div>)}</div></div></section>}
