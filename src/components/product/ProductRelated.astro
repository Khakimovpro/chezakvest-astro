---
import CardsRow from '../CardsRow.astro';
import { headingParts } from '../../lib/product-page.js';
import { typograf } from '../../lib/typograf.js';
const { data } = Astro.props;
const typesetCards = (items) => items.map(item => ({...item, t: typograf(item.t)}));
---
{data && <div class="product-related product-section--ink"><div data-product-reveal>{data.items.length > 0 && <CardsRow title={typograf(data.title)} items={typesetCards(data.items)} variant="poster" id="drugie" />}</div>{data.scenarios?.items?.length > 0 && <div class:list={['product-cards-continue', { 'product-cards-tail': headingParts(data.scenarios.subtitle).tail }]} data-product-reveal><CardsRow title={typograf(data.scenarios.title)} subtitle={typograf(data.scenarios.subtitle)} items={typesetCards(data.scenarios.items)} variant="square" /></div>}</div>}
