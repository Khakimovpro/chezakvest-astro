---
import ProductSectionHeader from './ProductSectionHeader.astro';
import ProductButton from './ProductButton.astro';
import ProductIconList from './ProductIconList.astro';
import Icon from './Icon.astro';
import { typograf } from '../../lib/typograf.js';
const { data, surface = 'ground' } = Astro.props;
---
{data && <section class={`product-section product-section--${surface}`}><div class="container product-short product-prose"><ProductSectionHeader title="Коротко о квесте" />{(Array.isArray(data) ? data : [data]).map((p) => <p>{typograf(p)}</p>)}</div></section>}
