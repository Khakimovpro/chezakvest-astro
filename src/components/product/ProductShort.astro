---
const { data } = Astro.props;
const paragraphs = Array.isArray(data) ? data : data ? [data] : [];
---
{data && <section class="product-section product-section--white"><div class="container product-short product-prose"><h2>Коротко о квесте</h2>{paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div></section>}
