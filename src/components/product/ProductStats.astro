---
import ProductSectionHeader from './ProductSectionHeader.astro';
import ProductButton from './ProductButton.astro';
import ProductIconList from './ProductIconList.astro';
import Icon from './Icon.astro';
import { typograf } from '../../lib/typograf.js';
const { data, surface = 'sheet' } = Astro.props;
---
{data?.items?.length > 0 && <section class={`product-section product-section--${surface}`} id={data.id}><div class="container"><ProductSectionHeader title={data.title} lead={data.subtitle} /><div class="product-stat-panel" data-product-reveal><ul class="product-stats">{data.items.map((item) => <li><p>{item.up}</p><strong>{item.n}</strong><span>{typograf(item.sub)}</span></li>)}</ul>{data.notes?.length > 0 && <ProductIconList items={data.notes} variant="tile" columns={2} class="product-stat-notes" />}</div></div></section>}
