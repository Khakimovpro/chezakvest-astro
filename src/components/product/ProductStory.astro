---
import ProductSectionHeader from './ProductSectionHeader.astro';
import ProductButton from './ProductButton.astro';
import ProductIconList from './ProductIconList.astro';
import Icon from './Icon.astro';
import { typograf } from '../../lib/typograf.js';
const { data, surface = 'sheet' } = Astro.props;
---
{data && <section class={`product-section product-section--${surface}`} id="story"><div class="container product-story"><div class="product-prose"><ProductSectionHeader title={data.story?.title} />{data.story?.paragraphs?.map((p) => <p>{typograf(p)}</p>)}</div>{data.features && <div class="product-story__features"><ProductSectionHeader title={data.features.title || 'Особенности'} class="product-sh--compact" />{data.features.lead?.map((p) => <p>{typograf(p)}</p>)}<ProductIconList items={data.features.items} variant="tile" /></div>}</div></section>}
