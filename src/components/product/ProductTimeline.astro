---
const { data } = Astro.props;
---

{data?.items?.length > 0 && <section class="product-section product-section--gray" id={data.id || undefined}><div class="container"><h2 class="section-title">{data.title}</h2>{data.subtitle && <p class="section-sub">{data.subtitle}</p>}<ol class="product-timeline">{data.items.map((item) => <li><b>{item.time}</b><div><h3>{item.t}</h3>{item.sub && <p>{item.sub}</p>}</div></li>)}</ol></div></section>}
