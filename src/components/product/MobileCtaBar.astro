---
import ProductButton from './ProductButton.astro';
const { phoneHref, bookingId = 'booking', bookingLabel = 'Забронировать' } = Astro.props;
---
<nav class="product-mobile-cta" data-product-mobile-cta aria-label="Быстрые действия"><ProductButton href={phoneHref} variant="secondary" icon="phone">Позвонить</ProductButton><ProductButton href={`#${bookingId}`} icon="calendar-check">{bookingLabel}</ProductButton></nav>
<script>
  const header = document.querySelector('.hdr');
  if (header) {
    const syncHeaderHeight = () => document.documentElement.style.setProperty('--product-header-height', `${header.getBoundingClientRect().height}px`);
    syncHeaderHeight();
    new ResizeObserver(syncHeaderHeight).observe(header);
  }
  const bar = document.querySelector('[data-product-mobile-cta]');
  const hero = document.querySelector('.product-hero');
  const fab = document.querySelector('.mfab');
  // YourGood replaces the local FAB after loading. Its button lives in an open shadow root.
  const placeSupportChat = () => {
    const root = document.querySelector('pf-widget')?.shadowRoot;
    if (!root) return false;
    if (!root.querySelector('[data-product-chat-position]')) {
      const style = document.createElement('style');
      style.setAttribute('data-product-chat-position', '');
      style.textContent = '@media(max-width:767px){#PWPreviewWidgetButtonWrapper{translate:0 var(--product-chat-shift,0px);transition:none!important}}';
      root.append(style);
    }
    return true;
  };
  if (!placeSupportChat()) {
    const chatObserver = new MutationObserver(() => { if (placeSupportChat()) chatObserver.disconnect(); });
    chatObserver.observe(document.body, { childList: true, subtree: true });
    customElements.whenDefined('pf-widget').then(() => { if (placeSupportChat()) chatObserver.disconnect(); });
    setTimeout(() => chatObserver.disconnect(), 30_000);
  }
  const targets = [...document.querySelectorAll('.product-page #booking, .product-page #prazdnik, .product-page #quiz')];
  const visibleTargets = new Set();
  const sync = () => {
    const visible = Boolean(hero && hero.getBoundingClientRect().bottom < 0 && visibleTargets.size === 0);
    bar?.classList.toggle('product-mobile-cta--visible', visible);
    bar?.toggleAttribute('inert', !visible);
    fab?.classList.toggle('mfab--above-product-cta', visible);
  };
  if (bar && hero) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => entry.isIntersecting ? visibleTargets.add(entry.target) : visibleTargets.delete(entry.target));
      sync();
    });
    targets.forEach((target) => observer.observe(target));
    addEventListener('scroll', sync, { passive: true });
    sync();
  }
</script>
