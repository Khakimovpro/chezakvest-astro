---
import ProductSectionHeader from './ProductSectionHeader.astro';
import ProductButton from './ProductButton.astro';
import ProductIconList from './ProductIconList.astro';
import Icon from './Icon.astro';
import { heroImageAttrs } from '../../lib/product-page.js';
import { typograf } from '../../lib/typograf.js';
import ProductFactChip from './ProductFactChip.astro';
const { data, phoneHref, wa, base = '' } = Astro.props;
const image = heroImageAttrs(data, base);
---

{data && <section class:list={['product-hero', 'product-hero--holiday', {'product-hero--contain': data.fit === 'contain'}]}>
  <div class="product-hero__media">
  {image.src && <img class="product-hero__image" {...image} width="1600" height="700" fetchpriority="high" decoding="async" alt="" />}
  <div class="product-hero__shade"></div>
  </div>
  <div class="product-hero__content container">
    {data.up && <p class="product-kicker">{typograf(data.up)}</p>}
    <h1>{typograf(data.h1)}</h1>
    {data.sub && <p class="product-hero__sub">{typograf(data.sub)}</p>}
    {(data.pills || []).length > 0 && <ul class="product-facts">{data.pills.map((fact) => <ProductFactChip text={fact} />)}</ul>}
    <div class="product-hero__actions"><ProductButton href="#prazdnik" size="lg" icon="arrow-right" iconEnd block>Узнать стоимость</ProductButton><ProductButton href={phoneHref} variant="on-photo" size="lg" icon="phone">Позвонить</ProductButton><ProductButton href={wa} variant="on-ink" size="lg" icon="whatsapp" target="_blank" rel="noopener">WhatsApp</ProductButton></div>
  </div>
</section>}
