---
const { data, phoneHref, wa, base = '' } = Astro.props;
const asset = (path) => `${base}${path || ''}`;
const source = data?.bgset?.['1600'] || data?.bgset?.['1200'] || data?.bg;
const srcset = Object.entries(data?.bgset || {}).map(([width, path]) => `${asset(path)} ${width}w`).join(', ');
---

{data && <section class="product-hero product-hero--holiday">
  {source && <img class="product-hero__image" src={asset(source)} srcset={srcset || undefined} sizes="100vw" width="1600" height="700" fetchpriority="high" decoding="async" alt="" />}
  <div class="product-hero__shade"></div>
  <div class="product-hero__content container">
    {data.up && <p class="product-kicker">{data.up}</p>}
    <h1>{data.h1}</h1>
    {data.sub && <p class="product-hero__sub">{data.sub}</p>}
    {(data.pills || []).length > 0 && <ul class="product-facts">{data.pills.map((fact) => <li>{fact}</li>)}</ul>}
    <div class="product-hero__actions">
      <a class="btn-orange" href="#prazdnik">Узнать стоимость</a>
      <a class="product-btn-light" href={phoneHref}>Позвонить</a>
      <a class="product-hero__wa" href={wa} target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </div>
</section>}
