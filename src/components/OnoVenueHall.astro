---
import ZoomImg from './ZoomImg.astro';

const { halls = [], asset = (value) => value, ctaHref = '' } = Astro.props;
const sourceHalls = halls.filter((hall) => hall?.address || hall?.photos?.length);
const primaryHall = sourceHalls[0] || {};
const splitLabel = (line) => {
  const separator = line.indexOf(':');
  return separator === -1
    ? { label: line, value: '' }
    : { label: `${line.slice(0, separator + 1)} `, value: line.slice(separator + 1).trimStart() };
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sourceFontCss = `
  @font-face {
    font-family: 'Nunito';
    font-style: normal;
    font-weight: 200 1000;
    font-display: swap;
    src: url('${base}/assets/fonts.gstatic.com/s/nunito/v32/XRXV3I6Li01BKofIMeaBXso.woff2') format('woff2');
    unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
  }

  @font-face {
    font-family: 'Montserratblack';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('${base}/assets/static.tildacdn.com/tild3134-3738-4465-a238-656132666435/Montserrat.woff2') format('woff2');
  }
`;
---

<section class="ono-hall" data-ono-hall-root>
  <div class="container ono-hall__heading">
    {primaryHall.title && <h2 class="ono-hall__title">{primaryHall.title}</h2>}
    {primaryHall.subtitle && <p class="ono-hall__subtitle">{primaryHall.subtitle}</p>}
  </div>

  <div class="container ono-hall__artboard">
    {sourceHalls.map((hall, slideIndex) => {
      const [capacity = '', format = '', equipment = '', ...equipmentItems] = hall.lines || [];
      const capacityLine = splitLabel(capacity);
      const formatLine = splitLabel(format);
      const galleryId = `ono-hall-gallery-${slideIndex + 1}`;
      return (
        <article
          class="ono-hall__slide"
          data-ono-hall-slide
          aria-hidden={slideIndex === 0 ? 'false' : 'true'}
          hidden={slideIndex !== 0}
        >
          <div class="ono-hall__gallery">
            <div class="ono-hall__photos" data-t396-gallery role="region" aria-roledescription="carousel"
                 aria-label={`Фотографии зала: ${hall.address || ''}`} aria-live="off">
              <div class="ono-hall__track" data-t396-gallery-track>
                {(hall.photos || []).map((photo, photoIndex) => (
                  <div class="ono-hall__photo-slide" id={`${galleryId}-slide-${photoIndex + 1}`}
                       data-t396-gallery-slide aria-hidden={photoIndex === 0 ? 'false' : 'true'}>
                    <ZoomImg
                      src={asset(photo)}
                      group={`quest-venue-ono-t396-${slideIndex}`}
                      buttonClass="ono-hall__zoom"
                      imageClass="ono-hall__photo"
                      alt={`Зал для праздника — ${hall.address || ''}`}
                      loading="lazy"
                      decoding="async"
                      width="600"
                      height="400"
                    />
                  </div>
                ))}
              </div>
              {(hall.photos || []).length > 1 && (
                <div class="ono-hall__dots" role="tablist" aria-label="Выбор фотографии зала">
                  {(hall.photos || []).map((_, photoIndex) => (
                    <button type="button" class="ono-hall__dot" role="tab" data-t396-gallery-dot
                            aria-label={`Фото ${photoIndex + 1} из ${(hall.photos || []).length}`}
                            aria-controls={`${galleryId}-slide-${photoIndex + 1}`}
                            aria-selected={photoIndex === 0 ? 'true' : 'false'}
                            aria-current={photoIndex === 0 ? 'true' : 'false'}></button>
                  ))}
                </div>
              )}
            </div>
          </div>

          {hall.caption && <p class="ono-hall__caption">{hall.caption}</p>}
          <h3 class="ono-hall__address">
            {hall.addressHref ? <a href={hall.addressHref}>{hall.address}</a> : hall.address}
          </h3>
          <div class="ono-hall__panel" aria-hidden="true"></div>
          <div class="ono-hall__copy">
            {capacity && <p><strong>{capacityLine.label}</strong>{capacityLine.value}</p>}
            {format && <p><strong>{formatLine.label}</strong>{formatLine.value}</p>}
            {equipment && <p><strong>{equipment}</strong></p>}
            {equipmentItems.length > 0 && (
              <ul>
                {equipmentItems.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </div>
          <a class="ono-hall__cta" href={ctaHref}>{hall.cta || 'Забронировать дату'}</a>
        </article>
      );
    })}

    {sourceHalls.length > 1 && (
      <nav class="ono-hall__pagination" aria-label="Выбор площадки">
        <button type="button" data-ono-hall-prev aria-label="Предыдущий зал">‹</button>
        <p data-ono-hall-pagination aria-live="polite" aria-atomic="true">1 из {sourceHalls.length}</p>
        <button type="button" data-ono-hall-next aria-label="Следующий зал">›</button>
      </nav>
    )}
  </div>
</section>

<script>
  import '../scripts/t396-gallery.js';

  document.querySelectorAll('[data-ono-hall-root]').forEach((root) => {
    const slides = [...root.querySelectorAll('[data-ono-hall-slide]')];
    const previous = root.querySelector('[data-ono-hall-prev]');
    const next = root.querySelector('[data-ono-hall-next]');
    const pagination = root.querySelector('[data-ono-hall-pagination]');

    if (slides.length < 2 || !previous || !next || !pagination) return;

    let activeIndex = 0;
    const setSlide = (nextIndex) => {
      activeIndex = nextIndex;
      slides.forEach((slide, index) => {
        const isActive = index === activeIndex;
        slide.hidden = !isActive;
        slide.setAttribute('aria-hidden', String(!isActive));
      });
      pagination.textContent = `${activeIndex + 1} из ${slides.length}`;
    };
    const move = (direction) => {
      const nextIndex = (activeIndex + direction + slides.length) % slides.length;
      setSlide(nextIndex);
    };

    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
  });
</script>

<style is:inline set:html={sourceFontCss}></style>

