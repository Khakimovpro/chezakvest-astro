---
// `/amongus-land/` is a complete Tilda campaign composition rather than a
// collection of shared holiday sections.  Its record dimensions are captured
// in route data so this renderer cannot leak onto another landing page.
import SourceArtboardRailControls from './SourceArtboardRailControls.astro';

const { source = {}, asset = (value) => value, href = (value) => value, phoneHref = '#', phone = '' } = Astro.props;
const records = source.records || {};
const recordIds = source.recordIds || {};
const hero = source.hero || {};
const intro = source.intro || {};
const video = source.video || {};
const bonus = source.bonus || {};
const trust = source.trust || {};
const footer = source.footer || {};
const footerVenues = footer.venues || source.venues || [];
const bookingHref = href(source.bookingHref || '#prazdnik');
const px = (value) => Number.isFinite(value) ? `${value}px` : String(value || '');
const recordStyle = (record = {}) => [
  record.desktop !== undefined && `--amongus-record-desktop:${px(record.desktop)}`,
  record.mobile !== undefined && `--amongus-record-mobile:${px(record.mobile)}`,
].filter(Boolean).join(';');
const organisation = [
  ['Детский День рождения', '/kids'], ['Взрослый День рождения', '/prazdniki-pod-kluch'],
  ['День Рождения в VR', '/den-rozhdeniya-na-vr-arene'], ['Выпускной', '/vypusknoj-kalmar'],
  ['Корпоратив | Тимбилдинг', '/prazdniki-pod-kluch'],
];
const entertainment = [
  ['Квеструмы', '/kvesty-v-rostove-na-donu'], ['VR-арены', '/den-rozhdeniya-na-vr-arene'],
  ['Активные игры', '/party-games'], ['Прятки в темноте', '/pryatki_v_temnote'],
  ['Страшные квесты', '/strashnye-kvesty'],
];
---

<div class="amongus-artboard" id="about" data-source-artboard="amongus">
  <section class="amongus-artboard__hero" data-parity-record={recordIds.hero} style={recordStyle(records.hero)} aria-labelledby="amongus-hero-title">
    <div class="amongus-artboard__rail amongus-artboard__hero-canvas">
      {hero.background && <img class="amongus-artboard__hero-world" src={asset(hero.background)} alt="" aria-hidden="true" width="1058" height="583" fetchpriority="high" decoding="async" />}
      {hero.ship && <img class="amongus-artboard__hero-ship" src={asset(hero.ship)} alt="" aria-hidden="true" width="583" height="419" fetchpriority="high" decoding="async" />}
      {hero.crewmate && <img class="amongus-artboard__hero-crewmate" src={asset(hero.crewmate)} alt="" aria-hidden="true" width="569" height="911" fetchpriority="high" decoding="async" />}
      <div class="amongus-artboard__hero-copy">
        <p class="amongus-artboard__hero-label">{hero.logo && <img src={asset(hero.logo)} alt="" aria-hidden="true" width="22" height="28" decoding="async" />}{hero.label}</p>
        <h1 id="amongus-hero-title">{hero.title}</h1>
        <p>{hero.text}</p>
        <a class="amongus-artboard__blue-button" href={bookingHref}>{hero.cta}</a>
      </div>
    </div>
  </section>

  <section class="amongus-artboard__intro" data-parity-record={recordIds.intro} style={recordStyle(records.intro)} aria-labelledby="amongus-intro-title">
    <div class="amongus-artboard__rail amongus-artboard__intro-canvas">
      <h2 id="amongus-intro-title">{intro.title}</h2>
      <p class="amongus-artboard__intro-text">{intro.text}</p>
      <p class="amongus-artboard__intro-label">Для вас:</p>
      <ul>{(intro.items || []).map((item) => (<li>{item}</li>))}</ul>
      {intro.photo && <img class="amongus-artboard__intro-photo" src={asset(intro.photo)} alt="Праздник в стиле Амонг Ас" width="700" height="470" loading="lazy" decoding="async" />}
      {intro.decor && <img class="amongus-artboard__intro-decor" src={asset(intro.decor)} alt="" aria-hidden="true" width="131" height="158" loading="lazy" decoding="async" />}
    </div>
  </section>

  <section class="amongus-artboard__video" data-parity-record={recordIds.video} style={recordStyle(records.video)} aria-labelledby="amongus-video-title">
    <div class="amongus-artboard__rail amongus-artboard__video-canvas">
      <h2 id="amongus-video-title">{video.title}</h2>
      {video.poster && <a class="amongus-artboard__video-poster" href={bookingHref}><img src={asset(video.poster)} alt="Посмотрите, как проходят праздники" width="650" height="380" loading="lazy" decoding="async" /><span aria-hidden="true">▶</span></a>}
      {video.decor && <img class="amongus-artboard__video-decor" src={asset(video.decor)} alt="" aria-hidden="true" width="159" height="181" loading="lazy" decoding="async" />}
    </div>
  </section>

  <section class="amongus-artboard__packages" data-parity-record={recordIds.packages} style={recordStyle(records.packages)} aria-labelledby="amongus-packages-title">
    <div class="amongus-artboard__rail amongus-artboard__packages-canvas">
      <h2 id="amongus-packages-title">ПАКЕТНЫЕ ПРЕДЛОЖЕНИЯ</h2>
      <div class="amongus-artboard__package-grid">
        {(source.packages || []).map((pack) => (
          <article class={`amongus-artboard__package amongus-artboard__package--${pack.tone}`}>
            {pack.badge && <span class="amongus-artboard__package-badge">{pack.badge}</span>}
            <div class="amongus-artboard__package-head"><h3>{pack.title}</h3><span>{pack.duration}</span></div>
            <h4>В программу входит:</h4>
            <ul class="amongus-artboard__package-program">{(pack.program || []).map((item) => (<li>{item}</li>))}</ul>
            <h4>В пакет включено:</h4>
            <ul class="amongus-artboard__package-includes">{(pack.includes || []).map((item) => (<li>{item}</li>))}</ul>
          </article>
        ))}
      </div>
      <a class="amongus-artboard__blue-button amongus-artboard__packages-cta" href={bookingHref}>Узнать стоимость</a>
    </div>
  </section>

  <section class="amongus-artboard__shows" data-parity-record={recordIds.shows} style={recordStyle(records.shows)} aria-labelledby="amongus-shows-title">
    <div class="amongus-artboard__rail">
      <h2 id="amongus-shows-title">ШОУ-ПРОГРАММЫ И МАСТЕР-КЛАССЫ</h2>
      <div class="amongus-artboard__show-grid">
        {(source.shows || []).map((item) => (
          <a class="amongus-artboard__show-card" href={bookingHref}>
            <img src={asset(item.src)} alt={item.title} width="700" height="467" loading="lazy" decoding="async" />
            <span>{item.title}</span><b>Заказать</b>
          </a>
        ))}
      </div>
    </div>
  </section>
  <div class="amongus-artboard__show-divider" data-parity-record={recordIds.showDivider} style={recordStyle(records.showDivider)} aria-hidden="true">{source.showDivider && <img src={asset(source.showDivider)} alt="" width="90" height="120" loading="lazy" decoding="async" />}</div>

  <section class="amongus-artboard__additions" data-parity-record={recordIds.additions} style={recordStyle(records.additions)} aria-labelledby="amongus-additions-title" data-source-artboard-rail data-source-artboard-rail-id="amongus-additions">
    <div class="amongus-artboard__rail">
      <h2 id="amongus-additions-title">ДОПОЛНЕНИЯ, КОТОРЫЕ УКРАСЯТ ВАШ ПРАЗДНИК</h2>
      <div class="amongus-artboard__addition-window" id="amongus-additions-viewport" data-source-artboard-rail-viewport tabindex="0" role="region" aria-roledescription="carousel" aria-label="Дополнения к празднику">
        <div class="amongus-artboard__addition-track">
          {(source.additions || []).map((item, index) => (
            <a class="amongus-artboard__addition-card" href={bookingHref} id={`amongus-additions-slide-${index + 1}`} data-source-artboard-rail-slide>
              <img src={asset(item.src)} alt={item.title} width="700" height="467" loading="lazy" decoding="async" />
              <span>{item.title}</span><b>Заказать</b>
            </a>
          ))}
        </div>
      </div>
    </div>
    <SourceArtboardRailControls railId="amongus-additions" label="Дополнения к празднику" items={source.additions || []} />
  </section>
  <div class="amongus-artboard__additions-gap" style={recordStyle(records.additionsGap)} aria-hidden="true"></div>

  <section class="amongus-artboard__trust-heading" data-parity-record={recordIds.trustHeading} style={recordStyle(records.trustHeading)} aria-labelledby="amongus-trust-title"><h2 id="amongus-trust-title">ПРИЧИНЫ <em>ДОВЕРИТЬ</em> НАМ<br />ОРГАНИЗАЦИЮ ВАШЕГО ПРАЗДНИКА</h2></section>
  <section class="amongus-artboard__trust" data-parity-record={recordIds.trust} style={recordStyle(records.trust)} aria-label="Причины доверить праздник">
    <div class="amongus-artboard__trust-grid">
      {(trust.cards || []).map((card) => (
        <article class={`amongus-artboard__trust-card amongus-artboard__trust-card--${card.kind}`} style={`--amongus-trust-mobile-order:${card.mobileOrder || 0}`}>
          {card.frame && <img class="amongus-artboard__trust-card-frame" src={asset(card.frame)} alt="" aria-hidden="true" width="300" height="285" loading="lazy" decoding="async" />}
          {card.src && <img class="amongus-artboard__trust-card-scene" src={asset(card.src)} alt="" aria-hidden="true" width="300" height="285" loading="lazy" decoding="async" />}
          {card.art && <img class="amongus-artboard__trust-card-art" src={asset(card.art)} alt="" aria-hidden="true" width="190" height="190" loading="lazy" decoding="async" />}
          {card.eyebrow && <span class="amongus-artboard__trust-card-eyebrow">{card.eyebrow}</span>}
          {card.value && <strong>{card.value}</strong>}
          {card.title && <h3>{card.title}</h3>}
          <p>{card.text}</p>
          {card.label && <b class="amongus-artboard__trust-card-label">{card.label}</b>}
        </article>
      ))}
    </div>
  </section>

  <section class="amongus-artboard__gallery-heading" data-parity-record={recordIds.galleryHeading} style={recordStyle(records.galleryHeading)} aria-labelledby="amongus-gallery-title"><h2 id="amongus-gallery-title">ФОТОГАЛЕРЕЯ</h2></section>
  <section class="amongus-artboard__gallery" data-parity-record={recordIds.gallery} style={recordStyle(records.gallery)} aria-label="Фотогалерея праздников">
    <div>{(source.gallery || []).map((image, index) => (<img src={asset(image)} alt={`Фотография праздника ${index + 1}`} width="600" height="400" loading="lazy" decoding="async" />))}</div>
  </section>

  <section class="amongus-artboard__bonus" data-parity-record={recordIds.bonus} style={recordStyle(records.bonus)} aria-labelledby="amongus-bonus-title">
    <div class="amongus-artboard__rail amongus-artboard__bonus-canvas">
      <h2 id="amongus-bonus-title">{bonus.title}</h2>
      <ul>{(bonus.items || []).map((item) => (<li>{item}</li>))}</ul>
      <a class="amongus-artboard__blue-button" href={bookingHref}>Рассчитать стоимость</a>
      <div class="amongus-artboard__bonus-art" aria-hidden="true">{(bonus.art || []).map((image) => (<img src={asset(image)} alt="" width="264" height="330" loading="lazy" decoding="async" />))}</div>
    </div>
  </section>

  <section class="amongus-artboard__venues-heading" data-parity-record={recordIds.venuesHeading} style={recordStyle(records.venuesHeading)} aria-labelledby="amongus-venues-title"><h2 id="amongus-venues-title">НАШИ ПЛОЩАДКИ</h2><p>Выбери одну из 9 современно оборудованных площадок с комнатами отдыха в Ростове-на-Дону</p><div class="amongus-artboard__venues-desktop" aria-label="Площадки">{(source.venues || []).map((item) => (<a href={href(item.href)}>{item.title}</a>))}</div></section>
  <section class="amongus-artboard__venues" data-parity-record={recordIds.venues} style={recordStyle(records.venues)} aria-label="Площадки"><div>{(source.venues || []).map((item) => (<a href={href(item.href)}>{item.title}</a>))}</div></section>

  <div class="amongus-artboard__footer-spacer" data-parity-record={recordIds.footerSpacer} style={recordStyle(records.footerSpacer)} aria-hidden="true"></div>
  <footer class="amongus-artboard__footer" data-parity-record={recordIds.footer} style={recordStyle(records.footer)}>
    <div class="amongus-artboard__footer-grid">
      <section><h2>ОРГАНИЗАЦИЯ МЕРОПРИЯТИЙ</h2>{organisation.map(([title, itemHref]) => (<a href={href(itemHref)}>{title}</a>))}</section>
      <section><h2>ВИДЫ РАЗВЛЕЧЕНИЙ</h2>{entertainment.map(([title, itemHref]) => (<a href={href(itemHref)}>{title}</a>))}</section>
      <section><h2>НАШИ ПЛОЩАДКИ</h2>{footerVenues.map((item) => (<a href={href(item.href)}>{item.title}</a>))}</section>
      <section class="amongus-artboard__footer-legal"><a href={href('/privacy')}>Политика обработки персональных данных</a><p>ИП Мелешкин Юрий Иванович<br />ОГРНИП: 322169000094990</p></section>
    </div>
  </footer>
  <div class="amongus-artboard__footer-bottom" data-parity-record={recordIds.footerBottom} style={recordStyle(records.footerBottom)}><a class="amongus-artboard__footer-logo" href={href('/')}><img src={asset(footer.logo)} alt="Чё за Квест" width="251" height="113" loading="lazy" decoding="async" /></a><span class="amongus-artboard__footer-copyright">© 2025 ЧЁ ЗА КВЕСТ</span><div class="amongus-artboard__footer-contact"><a class="amongus-artboard__footer-phone amongus-artboard__footer-phone--desktop" href={footer.phoneDesktopHref || phoneHref}>{footer.phoneDesktop || phone}</a><a class="amongus-artboard__footer-phone amongus-artboard__footer-phone--mobile" href={footer.phoneMobileHref || phoneHref}>{footer.phoneMobile || phone}</a><p>Работаем c 10:00 до 23:30</p>{footer.email && <a class="amongus-artboard__footer-email" href={footer.emailHref}>{footer.email}</a>}</div></div>
</div>

<style is:global>
  .amongus-artboard__booking .pform{display:none}
  .amongus-artboard__booking .pform:target{display:block}
</style>

<style>
  .amongus-artboard{overflow:hidden;background:#242137;color:#fff;font-family:Montserrat,Arial,sans-serif}
  .amongus-artboard a{color:inherit;text-decoration:none}.amongus-artboard__rail{position:relative;width:1200px;height:100%;margin:auto}
  .amongus-artboard__hero{height:var(--amongus-record-desktop,900px);overflow:hidden;background:#000}.amongus-artboard__hero-canvas{overflow:visible}.amongus-artboard__hero-world{position:absolute;right:-250px;bottom:20px;width:906px;height:490px;object-fit:cover}.amongus-artboard__hero-ship{position:absolute;top:145px;right:-107px;width:482px;height:281px;object-fit:cover}.amongus-artboard__hero-crewmate{position:absolute;bottom:-7px;left:-230px;width:364px;height:489px;object-fit:cover}.amongus-artboard__hero-copy{position:absolute;top:188px;left:60px;width:650px}.amongus-artboard__hero-label{display:flex;align-items:center;gap:7px;margin:0 0 11px;color:#e4e2e6;font:400 16px/1 Montserrat,Arial,sans-serif}.amongus-artboard__hero-label img{width:23px;height:31px}.amongus-artboard__hero-copy h1{width:650px;margin:0;color:#1188ff;font:800 37px/.95 Montserrat,Arial,sans-serif;letter-spacing:-.036em}.amongus-artboard__hero-copy>p:not(.amongus-artboard__hero-label){width:447px;margin:22px 0 34px;color:#fff;font:400 19px/1.27 Montserrat,Arial,sans-serif}.amongus-artboard__blue-button{display:inline-flex;box-sizing:border-box;min-width:230px;min-height:47px;align-items:center;justify-content:center;border-radius:28px;background:#128aff;color:#fff!important;font:700 12px/1 Montserrat,Arial,sans-serif;transition:filter .2s ease,transform .2s ease}.amongus-artboard__blue-button:hover{filter:brightness(1.08);transform:translateY(-1px)}
  .amongus-artboard__intro{height:var(--amongus-record-desktop,706px);overflow:hidden;background:#28243d}.amongus-artboard__intro-canvas h2{position:absolute;top:96px;left:207px;width:790px;margin:0;color:#1b93ff;text-align:center;font:800 32px/.96 Montserrat,Arial,sans-serif}.amongus-artboard__intro-text{position:absolute;top:208px;left:115px;width:970px;margin:0;color:#dedce6;text-align:center;font:400 12px/1.35 Montserrat,Arial,sans-serif}.amongus-artboard__intro-label{position:absolute;top:295px;left:0;margin:0;font:700 14px/1 Montserrat,Arial,sans-serif}.amongus-artboard__intro ul{position:absolute;top:330px;left:0;width:600px;margin:0;padding:0;list-style:none}.amongus-artboard__intro li{position:relative;margin-bottom:10px;padding-left:24px;color:#dddbe3;font:400 12px/1.15 Montserrat,Arial,sans-serif}.amongus-artboard__intro li::before{position:absolute;top:3px;left:0;width:10px;height:10px;border:2px solid #3d91ff;border-radius:50%;content:''}.amongus-artboard__intro-photo{position:absolute;top:300px;right:0;width:521px;height:337px;object-fit:cover;border-radius:12px}.amongus-artboard__intro-decor{position:absolute;right:-55px;bottom:-55px;width:131px;height:158px;object-fit:contain}
  .amongus-artboard__video{height:var(--amongus-record-desktop,712px);overflow:hidden;background:#242137}.amongus-artboard__video-canvas h2,.amongus-artboard__packages h2,.amongus-artboard__shows h2,.amongus-artboard__additions h2,.amongus-artboard__trust-heading h2,.amongus-artboard__gallery-heading h2,.amongus-artboard__venues-heading h2{margin:0;color:#fff;text-align:center;font:800 28px/1.05 Montserrat,Arial,sans-serif}.amongus-artboard__video-canvas h2{position:absolute;top:99px;left:206px;width:790px}.amongus-artboard__video-poster{position:absolute;top:232px;left:275px;display:block;overflow:hidden;width:651px;height:358px;border-radius:12px}.amongus-artboard__video-poster img{width:100%;height:100%;object-fit:cover}.amongus-artboard__video-poster span{position:absolute;top:50%;left:50%;display:grid;width:57px;height:57px;place-items:center;border-radius:50%;background:#168eff;color:#fff;font-size:24px;transform:translate(-50%,-50%)}.amongus-artboard__video-decor{position:absolute;top:255px;left:-125px;width:159px;height:181px}
  .amongus-artboard__packages{height:var(--amongus-record-desktop,1242px);overflow:hidden;background:#181628}.amongus-artboard__packages-canvas h2{position:absolute;top:150px;left:205px;width:790px}.amongus-artboard__package-grid{position:absolute;top:279px;left:0;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;width:1200px}.amongus-artboard__package{position:relative;box-sizing:border-box;min-height:795px;padding:31px 27px 25px;border-radius:4px;color:#fff;overflow:hidden}.amongus-artboard__package--standard{background:#c731ee}.amongus-artboard__package--super{background:#e53963}.amongus-artboard__package--maxi{background:#2a47e6}.amongus-artboard__package-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px}.amongus-artboard__package h3{margin:0;font:800 24px/1 Montserrat,Arial,sans-serif;text-transform:uppercase}.amongus-artboard__package-head span{padding:7px 13px;border-radius:4px;background:rgba(16,16,43,.78);font:700 11px/1 Montserrat,Arial,sans-serif}.amongus-artboard__package h4{margin:17px 0 10px;font:800 14px/1 Montserrat,Arial,sans-serif}.amongus-artboard__package ul{margin:0;padding:0;list-style:none}.amongus-artboard__package li{position:relative;margin:0 0 9px;padding-left:18px;font:400 12px/1.2 Montserrat,Arial,sans-serif}.amongus-artboard__package li::before{position:absolute;left:0;content:'✓';font-weight:800}.amongus-artboard__package-program li::before{content:'•'}.amongus-artboard__package-badge{position:absolute;top:-3px;left:50%;padding:8px 20px;border-radius:0 0 7px 7px;background:#ff2770;font:800 10px/1 Montserrat,Arial,sans-serif;transform:translateX(-50%);white-space:nowrap}.amongus-artboard__packages-cta{position:absolute;bottom:35px;left:430px;min-width:340px;min-height:62px}
