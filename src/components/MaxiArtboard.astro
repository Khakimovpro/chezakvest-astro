---
// Captured records from /prazdnik-maxi/.  This composition is deliberately
// isolated from the generic HolidayPage: the live landing is a dark Tilda
// artboard with fixed desktop/mobile record heights, not a card-template skin.
import site from '../data/site.json';

const { source = {}, asset = (value) => value, href = (value) => value } = Astro.props;
const records = source.records || {};
const bookingHref = href(source.bookingHref || '#callback');
const hall = source.hall || {};
const hallSlides = hall.slides || [];
const callback = source.callback || {};
const mobileFooterSeam = Number(source.mobileFooterSeam) || 0;
const recordStyle = (record = {}) => [
  record.desktop && `--maxi-record-desktop:${Number(record.desktop)}px`,
  record.mobile && `--maxi-record-mobile:${Number(record.mobile)}px`,
].filter(Boolean).join(';');
const artboardStyle = [
  source.background && `--maxi-background:url('${asset(source.background)}')`,
  `--maxi-mobile-footer-seam:${mobileFooterSeam}px`,
].filter(Boolean).join(';');
---

<div class="maxi-artboard" style={artboardStyle}>
  <div class="maxi-artboard__header-space" data-parity-record={records.header?.id} style={recordStyle(records.header)} aria-hidden="true"></div>

  <nav class="maxi-artboard__breadcrumbs" data-parity-record={records.breadcrumbs?.id} style={recordStyle(records.breadcrumbs)} aria-label="Хлебные крошки">
    <div class="maxi-artboard__hero-rail">
      {(source.breadcrumbs || []).map((item, index) => (
        <>
          {index > 0 && <span aria-hidden="true">/</span>}
          {item.href ? <a href={href(item.href)}>{item.title}</a> : <span>{item.title}</span>}
        </>
      ))}
    </div>
  </nav>

  <section class="maxi-artboard__hero" data-parity-record={records.hero?.id} style={recordStyle(records.hero)} aria-labelledby="maxi-hero-title">
    <div class="maxi-artboard__hero-rail">
      <div class="maxi-artboard__hero-image" style={source.hero?.background ? `background-image:url('${asset(source.hero.background)}')` : ''}>
        <div class="maxi-artboard__hero-copy">
          <h1 id="maxi-hero-title">{(source.hero?.title || []).map((line, index) => <span class:list={{ 'is-accent': index === 1 }}>{line}</span>)}</h1>
          <p>{source.hero?.subtitle}</p>
          <a class="maxi-artboard__button" href={bookingHref}>{source.hero?.cta}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="maxi-artboard__price" data-parity-record={records.price?.id} style={recordStyle(records.price)} aria-label="Стоимость программы">
    <div class="maxi-artboard__rail">
      <div class="maxi-artboard__price-card">
        <div class="maxi-artboard__price-copy">
          <span class="maxi-artboard__pill">{source.price?.label}</span>
          <strong>{source.price?.value}</strong>
          <span class="maxi-artboard__price-for">♟ {source.price?.for}</span>
          <small>{source.price?.note}</small>
        </div>
        <h2>{source.price?.title}</h2>
      </div>
    </div>
  </section>

  <section class="maxi-artboard__intro" data-parity-record={records.intro?.id} style={recordStyle(records.intro)} aria-labelledby="maxi-intro-title">
    <div class="maxi-artboard__rail">
      <p class="maxi-artboard__eyebrow">{source.intro?.eyebrow}</p>
      <h2 id="maxi-intro-title">{source.intro?.title}</h2>
      <p class="maxi-artboard__lead">{source.intro?.text}</p>
    </div>
  </section>

  <section class="maxi-artboard__features" data-parity-record={records.features?.id} style={recordStyle(records.features)} aria-label="Состав праздника">
    <div class="maxi-artboard__features-window" data-maxi-rail="features">
      <ul id="maxi-features-viewport" data-maxi-rail-viewport tabindex="0" aria-label="Состав праздника: листайте карточки">
        {(source.features || []).map((item) => (
          <li><strong>{item.title}</strong><span>{item.text}</span></li>
        ))}
      </ul>
      <div class="maxi-artboard__rail-controls" data-maxi-rail-controls>
        <button type="button" data-maxi-rail-prev aria-label="Предыдущие карточки состава праздника" aria-controls="maxi-features-viewport">‹</button>
        <span class="maxi-artboard__rail-status" data-maxi-rail-status aria-live="polite"></span>
        <button type="button" data-maxi-rail-next aria-label="Следующие карточки состава праздника" aria-controls="maxi-features-viewport">›</button>
      </div>
    </div>
  </section>

  <section class="maxi-artboard__timeline" data-parity-record={records.timeline?.id} style={recordStyle(records.timeline)} aria-labelledby="maxi-timeline-title">
    <div class="maxi-artboard__rail">
      <p class="maxi-artboard__eyebrow">{source.timeline?.eyebrow}</p>
      <h2 id="maxi-timeline-title">{source.timeline?.title}</h2>
      <p class="maxi-artboard__lead">{source.timeline?.text}</p>
      <div class="maxi-artboard__timeline-window" data-maxi-rail="timeline">
        <ol id="maxi-timeline-viewport" data-maxi-rail-viewport tabindex="0" aria-label="Тайминг праздника: листайте этапы">
          {(source.timeline?.items || []).map((item, index) => (
            <li>
              <p><span>{String(index + 1).padStart(2, '0')}</span> / <b>{item.time}</b></p>
              <h3>{item.title}</h3>
              <small>{item.text}</small>
            </li>
          ))}
        </ol>
        <div class="maxi-artboard__rail-controls" data-maxi-rail-controls>
          <button type="button" data-maxi-rail-prev aria-label="Предыдущие этапы тайминга" aria-controls="maxi-timeline-viewport">‹</button>
          <span class="maxi-artboard__rail-status" data-maxi-rail-status aria-live="polite"></span>
          <button type="button" data-maxi-rail-next aria-label="Следующие этапы тайминга" aria-controls="maxi-timeline-viewport">›</button>
        </div>
      </div>
    </div>
  </section>

  <section class="maxi-artboard__program-cta" data-parity-record={records.programCta?.id} style={recordStyle(records.programCta)}>
    <div class="maxi-artboard__rail"><a class="maxi-artboard__button" href={bookingHref}>Получить полную программу праздника</a></div>
  </section>

  <section class="maxi-artboard__catalog-heading" data-parity-record={records.questsHeading?.id} style={recordStyle(records.questsHeading)} aria-labelledby="maxi-quests-title">
    <div class="maxi-artboard__rail">
      <p class="maxi-artboard__eyebrow">ОСНОВНАЯ ЧАСТЬ ПРОГРАММЫ</p>
      <h2 id="maxi-quests-title">Тематический <span>квест в лабиринте</span> на выбор</h2>
      <p class="maxi-artboard__lead">Адаптированный под возраст, интересы ребёнка и состав гостей.</p>
    </div>
  </section>

  <section class="maxi-artboard__quests" data-parity-record={records.quests?.id} style={recordStyle(records.quests)} aria-label="Сценарии квестов">
    <div class="maxi-artboard__rail">
      <ul>
        {(source.quests || []).map((item) => (
          <li>
            <a href={bookingHref} aria-label={`${item.title}: подобрать программу`}>
              <img src={asset(item.src)} alt="" width="480" height="480" loading="lazy" decoding="async" />
              <strong>{item.title}</strong><span aria-hidden="true">›</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="maxi-artboard__catalog-heading maxi-artboard__catalog-heading--shows" data-parity-record={records.showsHeading?.id} style={recordStyle(records.showsHeading)} aria-labelledby="maxi-shows-title">
    <div class="maxi-artboard__rail">
      <p class="maxi-artboard__eyebrow">ДЕЛАЕМ ПРАЗДНИК ВЕСЕЛЕЕ</p>
      <h2 id="maxi-shows-title"><span>2 шоу-программы</span> уже включены</h2>
      <p class="maxi-artboard__lead">В программу входят сразу две шоу-программы, поэтому праздник получается не однообразным, а насыщенным.</p>
    </div>
  </section>

  <section class="maxi-artboard__shows" data-parity-record={records.shows?.id} style={recordStyle(records.shows)} aria-label="Шоу-программы">
    <div class="maxi-artboard__shows-window" data-maxi-rail="shows">
      <ul id="maxi-shows-viewport" data-maxi-rail-viewport tabindex="0" aria-label="Шоу-программы: листайте карточки">
        {(source.shows || []).map((item) => (
          <li class:list={{ 'maxi-artboard__show-card--consult': !item.src }}>
            {item.src && <img src={asset(item.src)} alt="" width="312" height="240" loading="lazy" decoding="async" />}
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              {item.video && <a href={bookingHref}>● Видео</a>}
              {item.cta && <a class="maxi-artboard__button" href={bookingHref}>{item.cta}</a>}
            </div>
          </li>
        ))}
      </ul>
      <div class="maxi-artboard__rail-controls" data-maxi-rail-controls>
        <button type="button" data-maxi-rail-prev aria-label="Предыдущие шоу-программы" aria-controls="maxi-shows-viewport">‹</button>
        <span class="maxi-artboard__rail-status" data-maxi-rail-status aria-live="polite"></span>
        <button type="button" data-maxi-rail-next aria-label="Следующие шоу-программы" aria-controls="maxi-shows-viewport">›</button>
      </div>
    </div>
  </section>

  <section class="maxi-artboard__package" data-parity-record={records.package?.id} style={recordStyle(records.package)} aria-labelledby="maxi-package-title">
    <div class="maxi-artboard__rail">
      <p class="maxi-artboard__eyebrow">{source.package?.eyebrow}</p>
      <h2 id="maxi-package-title">{source.package?.title}</h2>
      <p class="maxi-artboard__lead">{source.package?.text}</p>
      <div class="maxi-artboard__package-window" data-maxi-rail="package">
        <ul id="maxi-package-viewport" data-maxi-rail-viewport tabindex="0" aria-label="Состав пакета: листайте карточки">
          {(source.package?.items || []).map((item, index) => (
            <li class:list={{ 'maxi-artboard__package-card--wide': index === (source.package?.items?.length || 0) - 1 }}>
              <h3>{item.title}{item.accent && <> — <span>{item.accent}</span></>}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
        <div class="maxi-artboard__rail-controls" data-maxi-rail-controls>
          <button type="button" data-maxi-rail-prev aria-label="Предыдущие пункты пакета" aria-controls="maxi-package-viewport">‹</button>
          <span class="maxi-artboard__rail-status" data-maxi-rail-status aria-live="polite"></span>
          <button type="button" data-maxi-rail-next aria-label="Следующие пункты пакета" aria-controls="maxi-package-viewport">›</button>
        </div>
      </div>
    </div>
  </section>

  <section class="maxi-artboard__booking-cta" data-parity-record={records.bookingCta?.id} style={recordStyle(records.bookingCta)}>
    <a class="maxi-artboard__button" href={bookingHref}>Забронировать праздник</a>
  </section>

  <section class="maxi-artboard__hall-heading" data-parity-record={records.hallHeading?.id} style={recordStyle(records.hallHeading)} aria-labelledby="maxi-hall-title">
    <div class="maxi-artboard__rail">
      <p class="maxi-artboard__eyebrow">{hall.eyebrow}</p>
      <h2 id="maxi-hall-title">{hall.title}</h2>
      <p class="maxi-artboard__lead">{hall.text}</p>
    </div>
  </section>

  <div class="maxi-artboard__hall-spacer" data-parity-record={records.hallSpacer?.id} style={recordStyle(records.hallSpacer)} aria-hidden="true"></div>

  <section class="maxi-artboard__hall" data-parity-record={records.hall?.id} style={recordStyle(records.hall)} aria-label="Зал на улице 40-летия Победы">
    <div class="maxi-artboard__hall-inner" data-maxi-hall>
      {hallSlides.map((slide) => <span hidden data-maxi-hall-source data-src={asset(slide)}></span>)}
      {hallSlides[0] && <img class="maxi-artboard__hall-image" data-maxi-hall-image src={asset(hallSlides[0])} alt="Зал для праздника на улице 40-летия Победы" width="600" height="400" loading="lazy" decoding="async" />}
      <span class="maxi-artboard__hall-caption">{hall.caption}</span>
      <div class="maxi-artboard__hall-copy">
        <h3>{hall.address}</h3>
        <div>
          {(hall.details || []).map((line, index) => index > 2 ? <span>• {line}</span> : <p class:list={{ 'is-list-title': index === 2 }}>{line}</p>)}
        </div>
        <a class="maxi-artboard__button" href={bookingHref}>Узнать свободные даты</a>
      </div>
      {hallSlides.length > 1 && <div class="maxi-artboard__hall-controls">
        <button type="button" data-maxi-hall-prev aria-label="Предыдущее фото">‹</button>
        <span data-maxi-hall-count>1 из {hallSlides.length}</span>
        <button type="button" data-maxi-hall-next aria-label="Следующее фото">›</button>
      </div>}
    </div>
  </section>

  <section class="maxi-artboard__media-heading" data-parity-record={records.videoHeading?.id} style={recordStyle(records.videoHeading)} aria-labelledby="maxi-video-title">
    <div class="maxi-artboard__rail">
      <p class="maxi-artboard__eyebrow">{source.video?.eyebrow}</p>
      <h2 id="maxi-video-title">{source.video?.title}</h2>
      <p class="maxi-artboard__lead">{source.video?.text}</p>
    </div>
  </section>

  <section class="maxi-artboard__video" data-parity-record={records.video?.id} style={recordStyle(records.video)} aria-label="Видеорепортажи с праздников">
    <div class="maxi-artboard__video-window" data-maxi-rail="video">
      <div id="maxi-video-viewport" data-maxi-rail-viewport tabindex="0" aria-label="Видеорепортажи с праздников: листайте видео"><div class="maxi-artboard__video-track">
        {(source.video?.items || []).map((item) => <a href={bookingHref}><img src={asset(item)} alt="Видеорепортаж с праздника" width="700" height="500" loading="lazy" decoding="async" /><span aria-hidden="true">▶</span></a>)}
      </div></div>
      <div class="maxi-artboard__rail-controls" data-maxi-rail-controls>
        <button type="button" data-maxi-rail-prev aria-label="Предыдущее видео" aria-controls="maxi-video-viewport">‹</button>
        <span class="maxi-artboard__rail-status" data-maxi-rail-status aria-live="polite"></span>
        <button type="button" data-maxi-rail-next aria-label="Следующее видео" aria-controls="maxi-video-viewport">›</button>
      </div>
    </div>
  </section>

  <section class="maxi-artboard__reviews-heading" data-parity-record={records.reviewsHeading?.id} style={recordStyle(records.reviewsHeading)} aria-labelledby="maxi-reviews-title">
    <div class="maxi-artboard__rail"><p class="maxi-artboard__eyebrow">{source.reviews?.eyebrow}</p><h2 id="maxi-reviews-title">{source.reviews?.title}</h2></div>
  </section>

  <section class="maxi-artboard__gallery-heading" data-parity-record={records.galleryHeading?.id} style={recordStyle(records.galleryHeading)} aria-labelledby="maxi-gallery-title">
    <div class="maxi-artboard__rail"><p class="maxi-artboard__eyebrow">{source.gallery?.eyebrow}</p><h2 id="maxi-gallery-title">{source.gallery?.title}</h2></div>
  </section>

  <section class="maxi-artboard__gallery" data-parity-record={records.gallery?.id} style={recordStyle(records.gallery)} aria-label="Фотогалерея" data-maxi-rail="gallery">
    <div id="maxi-gallery-viewport" data-maxi-rail-viewport tabindex="0" aria-label="Фотогалерея: листайте фотографии"><ul>{(source.gallery?.items || []).map((item) => <li><img src={asset(item)} alt="Фотография с праздника" width="480" height="480" loading="lazy" decoding="async" /></li>)}</ul></div>
    <div class="maxi-artboard__rail-controls" data-maxi-rail-controls>
      <button type="button" data-maxi-rail-prev aria-label="Предыдущие фотографии" aria-controls="maxi-gallery-viewport">‹</button>
      <span class="maxi-artboard__rail-status" data-maxi-rail-status aria-live="polite"></span>
      <button type="button" data-maxi-rail-next aria-label="Следующие фотографии" aria-controls="maxi-gallery-viewport">›</button>
    </div>
  </section>

  <section class="maxi-artboard__callback" id="callback" data-parity-record={records.callback?.id} style={recordStyle(records.callback)} aria-labelledby="maxi-callback-title">
    <div class="maxi-artboard__callback-card">
      <div><h2 id="maxi-callback-title">{callback.title}</h2><p>{callback.text}</p></div>
      <form data-lead-form data-lead-kind="callback" data-lead-target={site.header.wa} data-lead-recipient={site.leads?.recipient || ''} aria-describedby="maxi-callback-status">
        <label for="maxi-callback-name"><span>Ваше Имя</span><input id="maxi-callback-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="80" required /></label>
        <label for="maxi-callback-phone"><span>Телефон</span><input id="maxi-callback-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="24" required /></label>
        <label class="maxi-artboard__consent"><input name="consent" type="checkbox" required /><span>Согласен с <a href={href('/privacy')}>Политикой обработки персональных данных</a></span></label>
        <button class="maxi-artboard__button" type="button" data-lead-submit>{callback.cta}</button>
        <p id="maxi-callback-status" data-lead-status role="status" aria-live="polite" hidden></p>
      </form>
    </div>
  </section>

  <section class="maxi-artboard__venues-heading" data-parity-record={records.venuesHeading?.id} style={recordStyle(records.venuesHeading)} aria-labelledby="maxi-venues-title">
    <div class="maxi-artboard__rail"><p class="maxi-artboard__eyebrow">№1 В РОСТОВЕ-НА-ДОНУ</p><h2 id="maxi-venues-title">Наши площадки</h2><p class="maxi-artboard__lead">9 современно оборудованных площадок с квест-комнатами и зонами отдыха в Ростове-на-Дону.</p></div>
  </section>

  <section class="maxi-artboard__venues" data-parity-record={records.venues?.id} style={recordStyle(records.venues)} aria-label="Адреса площадок"><div>{(source.venues || []).map((item) => <a href={href(item.href)}>{item.title}</a>)}</div></section>
  <div class="maxi-artboard__footer-spacer" data-parity-record={records.footerSpacer?.id} style={recordStyle(records.footerSpacer)} aria-hidden="true"></div>

  <footer class="maxi-artboard__footer" data-parity-record={records.footer?.id} style={recordStyle(records.footer)}>
    <div><section><h2>ОРГАНИЗАЦИЯ МЕРОПРИЯТИЙ</h2><a href={href('/kids')}>Детский День рождения</a><a href={href('/den-rozhdeniya-na-vr-arene')}>День Рождения в VR</a><a href={href('/vypusknoj-kalmar')}>Выпускной 2026</a></section><section><h2>ВИДЫ РАЗВЛЕЧЕНИЙ</h2><a href={href('/kvesty-v-rostove-na-donu')}>Квеструмы</a><a href={href('/den-rozhdeniya-na-vr-arene')}>VR-арена</a><a href={href('/party-games')}>Активные игры</a></section><section><h2>НАШИ ПЛОЩАДКИ</h2>{(source.venues || []).slice(6).map((item) => <a href={href(item.href)}>{item.title}</a>)}</section><section><a href={href('/privacy')}>Политика обработки персональных данных</a><a href={site.header.phoneHref}>{site.header.phone}</a></section></div>
  </footer>
  <div class="maxi-artboard__copyright" data-parity-record={records.copyright?.id} style={recordStyle(records.copyright)}><span>© 2026 ЧЁ ЗА КВЕСТ</span><a href={href('/')}>ЧЁ ЗА!КВЕСТ</a></div>
</div>

<script>
  import '../scripts/lead-form.js';
  import '../scripts/maxi-artboard-rails.js';

  const initMaxiHall = () => {
    document.querySelectorAll('[data-maxi-hall]').forEach((hall) => {
      if (hall.dataset.ready) return;
      const sources = Array.from(hall.querySelectorAll('[data-maxi-hall-source]'), (source) => source.dataset.src).filter(Boolean);
      const image = hall.querySelector('[data-maxi-hall-image]');
      const count = hall.querySelector('[data-maxi-hall-count]');
      if (!image || sources.length < 2) return;
      hall.dataset.ready = 'true';
      let current = 0;
      const render = () => {
        image.src = sources[current];
        if (count) count.textContent = `${current + 1} из ${sources.length}`;
      };
      hall.querySelector('[data-maxi-hall-prev]')?.addEventListener('click', () => {
        current = (current + sources.length - 1) % sources.length;
        render();
      });
      hall.querySelector('[data-maxi-hall-next]')?.addEventListener('click', () => {
        current = (current + 1) % sources.length;
        render();
      });
    });
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initMaxiHall, { once: true });
  else initMaxiHall();
</script>

<style>
  .maxi-artboard{overflow:hidden;background-color:#0c0e10;background-image:var(--maxi-background);background-repeat:repeat;background-position:center top;background-size:1254px auto;color:#fff;font-family:Montserrat,Arial,sans-serif}
  .maxi-artboard a{color:inherit;text-decoration:none}
  .maxi-artboard__header-space{height:var(--maxi-record-desktop,90px)}
  .maxi-artboard__rail{position:relative;width:1160px;height:100%;margin:auto}
  .maxi-artboard__hero-rail{width:1200px;height:100%;margin:auto}
  .maxi-artboard__breadcrumbs{height:var(--maxi-record-desktop,38px);color:#a3a3a3;font:400 13px/1.2 Montserrat,Arial,sans-serif}
  .maxi-artboard__breadcrumbs > div{display:flex;height:100%;align-items:center;gap:11px}
  .maxi-artboard__breadcrumbs a:hover{color:#fff}
  .maxi-artboard__hero{height:var(--maxi-record-desktop,570px)}
  .maxi-artboard__hero-image{position:relative;height:100%;overflow:hidden;border-radius:0 0 14px 14px;background-color:#101320;background-position:center;background-size:cover;background-repeat:no-repeat}
  .maxi-artboard__hero-copy{position:absolute;top:63px;left:60px;width:625px}
  .maxi-artboard__hero h1{margin:0;color:#fff;font:900 52px/1.19 Montserrat,Arial,sans-serif;letter-spacing:-.045em;text-transform:uppercase}
  .maxi-artboard__hero h1 span{display:block}
