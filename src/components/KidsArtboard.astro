---
// `/kids/` is a source-specific Tilda sequence (43 measured records), not a
// reusable holiday-card page. Geometry is owned by the route JSON so this
// composition cannot alter the other holiday landings.
import site from '../data/site.json';

const { source = {}, page = {}, asset = (value) => value, href = (value) => value } = Astro.props;
const records = source.records || {};
const sections = page.sections || [];
const section = (kind, id = '') => sections.find((item) => item.kind === kind && (!id || item.id === id)) || {};
const sectionList = (kind) => sections.filter((item) => item.kind === kind);
const hero = section('hero');
const scenarios = section('cards', 'scenarii');
const stats = section('stats');
const packages = section('packages');
const tileSections = sectionList('tiles');
const shows = tileSections[0] || {};
const additions = tileSections[1] || {};
const masterclasses = tileSections[2] || {};
const quiz = section('party-form', 'quiz');
const halls = section('halls');
const hall = halls.items?.[0] || {};
const booking = section('party-form', 'prazdnik');
const reviews = section('reviews');
const steps = section('steps');
const gallery = section('gallery');
const venues = source.venues || [];
const bookingHref = href(source.bookingHref || '#prazdnik');
const px = (value) => Number.isFinite(value) ? `${value}px` : String(value || '');
const recordStyle = (record = {}) => [
  record.desktop !== undefined && `--kids-record-desktop:${px(record.desktop)}`,
  record.mobile !== undefined && `--kids-record-mobile:${px(record.mobile)}`,
].filter(Boolean).join(';');
const heroStyle = [
  hero.bg && `--kids-hero-image:url(${asset(hero.bg)})`,
  hero.bgset?.['760'] && `--kids-hero-image-mobile:url(${asset(hero.bgset['760'])})`,
].filter(Boolean).join(';');
const organisation = [
  ['Детский День рождения', '/kids'], ['Взрослый День рождения', '/prazdniki-pod-kluch'],
  ['День Рождения в VR', '/den-rozhdeniya-na-vr-arene'], ['Выпускной 2026', '/vypusknoj-kalmar'],
  ['Корпоратив | Тимбилдинг', '/prazdniki-pod-kluch'], ['Новый год 2027', '/new-year'],
];
const entertainment = [
  ['Квеструмы', '/kvesty-v-rostove-na-donu'], ['VR-арена', '/den-rozhdeniya-na-vr-arene'],
  ['Активные игры', '/party-games'], ['Прятки в темноте', '/pryatki_v_temnote'], ['Страшные квесты', '/strashnye-kvesty'],
];
---

<div class="kids-artboard" data-source-artboard="kids">
  <header class="kids-artboard__record kids-artboard__header" data-parity-record="rec1591649741" style={recordStyle(records.header)}>
    <div class="kids-artboard__rail kids-artboard__header-inner">
      <a class="kids-artboard__brand" href={href('/')} aria-label="Чё за Квест">ЧЁ ЗА КВЕСТ</a>
      <nav aria-label="Основная навигация"><a href={href('/kvesty-v-rostove-na-donu')}>Квесты</a><a href={href('/kids')}>Праздники</a><a href={href('/strashnye-kvesty')}>Хоррор</a><a href={href('/contacts')}>Контакты</a></nav>
      <a class="kids-artboard__phone" href={site.header.phoneHref}>{site.header.phone}</a>
    </div>
  </header>

  <section class="kids-artboard__record kids-artboard__hero" data-parity-record="rec844797042" style={`${recordStyle(records.hero)};${heroStyle}`} aria-labelledby="kids-hero-title">
    <div class="kids-artboard__rail kids-artboard__hero-copy"><p>{hero.up}</p><h1 id="kids-hero-title">{hero.h1 || page.seo?.h1}</h1><p class="kids-artboard__hero-sub">{hero.sub}</p><div>{(hero.buttons || []).map((button, index) => <a class:list={['kids-artboard__button', { 'kids-artboard__button--outline': index !== 0 }]} href={href(button.href)}>{button.t}</a>)}</div></div>
    <div class="kids-artboard__hero-art" aria-hidden="true"></div>
  </section>
  <nav class="kids-artboard__record kids-artboard__breadcrumbs" data-parity-record="rec1131561821" style={recordStyle(records.breadcrumbs)} aria-label="Хлебные крошки"><div class="kids-artboard__rail"><a href={href('/')}>Главная</a><span>›</span><b>Проведение праздников</b></div></nav>
  <div class="kids-artboard__record kids-artboard__paper-gap" data-parity-record="rec844797045" style={recordStyle(records.breadcrumbGap)} aria-hidden="true"></div>
  <div class="kids-artboard__record kids-artboard__paper-gap" data-parity-record="rec844797046" style={recordStyle(records.breadcrumbTail)} aria-hidden="true"></div>

  <section class="kids-artboard__record kids-artboard__scenarios" data-parity-record="rec1144951641" style={recordStyle(records.scenarios)} id="scenarii" aria-labelledby="kids-scenarios-title"><div class="kids-artboard__rail"><p class="kids-artboard__eyebrow">{scenarios.uptitle}</p><h2 id="kids-scenarios-title">{scenarios.title}</h2><p>{scenarios.subtitle}</p><div class="kids-artboard__scenario-grid">{(scenarios.items || []).map((item) => <a href={href(item.href)}><img src={asset(item.img)} alt={item.t} width="220" height="250" loading="lazy" decoding="async" /><span>{item.t}</span></a>)}</div></div></section>
  <div class="kids-artboard__record kids-artboard__paper-gap" data-parity-record="rec769928041" style={recordStyle(records.dividerAfterScenarios)} aria-hidden="true"></div>

  <section class="kids-artboard__record kids-artboard__section-head kids-artboard__stats-heading" data-parity-record="rec844797067" style={recordStyle(records.statsHeading)} aria-labelledby="kids-stats-title"><div class="kids-artboard__rail"><p class="kids-artboard__eyebrow">ЧЁ ЗА КВЕСТ</p><h2 id="kids-stats-title">{stats.title} <span>{stats.subtitle}</span></h2></div></section>
  <section class="kids-artboard__record kids-artboard__stats" data-parity-record="rec844797068" style={recordStyle(records.stats)} aria-label="Причины доверить праздник"><div class="kids-artboard__rail kids-artboard__stats-grid">{(stats.items || []).map((item) => <article><p>{item.up}</p><b>{item.n}</b><h3>{item.sub}</h3></article>)}{(stats.notes || []).map((item) => <article class="kids-artboard__stats-note"><h3>{item.t}</h3><p>{item.sub}</p></article>)}</div></section>
  <div class="kids-artboard__record kids-artboard__paper-gap" data-parity-record="rec769928041" style={recordStyle(records.dividerAfterStats)} aria-hidden="true"></div>

  <section class="kids-artboard__record kids-artboard__section-head kids-artboard__packages-heading" data-parity-record="rec844797071" style={recordStyle(records.packagesHeading)} aria-labelledby="kids-packages-title"><div class="kids-artboard__rail"><p class="kids-artboard__eyebrow">ВЫГОДНЫЕ УСЛОВИЯ</p><h2 id="kids-packages-title">{packages.title}</h2><p>{packages.subtitle}</p></div></section>
  <nav class="kids-artboard__record kids-artboard__package-tabs" data-parity-record="rec844797072" style={recordStyle(records.packageTabs)} aria-label="Виды пакетов"><div class="kids-artboard__rail">{(packages.groups || []).map((group, index) => <a class:list={{ 'is-active': index === 0 }} href={bookingHref}>➧ {group.tab}</a>)}</div></nav>
  <section class="kids-artboard__record kids-artboard__packages" data-parity-record="rec844797074" style={recordStyle(records.packages)} aria-label="Пакетные предложения"><div class="kids-artboard__rail kids-artboard__package-grid">{(packages.groups?.[0]?.items || []).map((item) => <article><p>{item.badge || 'ПАКЕТ'}</p><h3>{item.name}</h3><b>{item.duration}</b><ul>{(item.includes || []).slice(0, 5).map((entry) => <li>{entry.t}<span>{entry.time}</span></li>)}</ul><a class="kids-artboard__button" href={bookingHref}>{packages.cta || 'Узнать стоимость'}</a></article>)}</div></section>
  <div class="kids-artboard__record kids-artboard__paper-gap" data-parity-record="rec769928041" style={recordStyle(records.dividerAfterPackages)} aria-hidden="true"></div>

  <section class="kids-artboard__record kids-artboard__section-head kids-artboard__shows-heading" data-parity-record="rec844797090" style={recordStyle(records.showsHeading)} aria-labelledby="kids-shows-title"><div class="kids-artboard__rail"><p class="kids-artboard__eyebrow">ШОУ И ИГРЫ</p><h2 id="kids-shows-title">{shows.title}</h2><p>{shows.subtitle}</p></div></section>
  <section class="kids-artboard__record kids-artboard__shows" data-parity-record="rec844797091" style={recordStyle(records.shows)} aria-label="Шоу-программы"><div class="kids-artboard__rail kids-artboard__show-grid">{(shows.items || []).map((item) => <a href={bookingHref}><img src={asset(item.img)} alt={item.t} width="220" height="260" loading="lazy" decoding="async" /><span>{item.t}</span></a>)}</div></section>
  <div class="kids-artboard__record kids-artboard__paper-gap" data-parity-record="rec769928041" style={recordStyle(records.dividerAfterShows)} aria-hidden="true"></div>

  <section class="kids-artboard__record kids-artboard__section-head kids-artboard__quiz-heading" data-parity-record="rec844797097" style={recordStyle(records.quizHeading)} aria-labelledby="kids-quiz-title"><div class="kids-artboard__rail"><p class="kids-artboard__eyebrow">ПОДБОР ПРОГРАММЫ</p><h2 id="kids-quiz-title">{quiz.title}</h2><p>{quiz.subtitle}</p></div></section>
  <section class="kids-artboard__record kids-artboard__quiz" data-parity-record="rec844797098" style={recordStyle(records.quiz)} id="quiz" aria-label="Подобрать праздничную программу"><form data-lead-form data-lead-kind="party" data-lead-target={site.header.wa} data-lead-recipient={site.leads?.recipient || ''} class="kids-artboard__lead-form" aria-describedby="kids-quiz-status"><div class="kids-artboard__form-fields"><label for="kids-quiz-name">Ваше имя<input id="kids-quiz-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="80" required /></label><label for="kids-quiz-phone">Телефон<input id="kids-quiz-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="24" required /></label><label for="kids-quiz-date">Дата праздника<input id="kids-quiz-date" name="date" type="date" /></label></div><label class="kids-artboard__consent"><input name="consent" type="checkbox" required />Соглашаюсь с <a href={href('/privacy')}>политикой обработки данных</a></label><button class="kids-artboard__button" type="button" data-lead-submit>{quiz.cta || 'Старт'}</button><p class="lead-form__status" id="kids-quiz-status" data-lead-status role="status" aria-live="polite" hidden></p></form></section>
  <div class="kids-artboard__record kids-artboard__paper-gap" data-parity-record="rec769928041" style={recordStyle(records.dividerAfterQuiz)} aria-hidden="true"></div>

  <section class="kids-artboard__record kids-artboard__section-head kids-artboard__halls-heading" data-parity-record="rec844797100" style={recordStyle(records.hallsHeading)} aria-labelledby="kids-halls-title"><div class="kids-artboard__rail"><p class="kids-artboard__eyebrow">КОМНАТА ОТДЫХА</p><h2 id="kids-halls-title">{halls.title}</h2><p>{halls.subtitle}</p></div></section>
  <section class="kids-artboard__record kids-artboard__halls" data-parity-record="rec844797103" style={recordStyle(records.halls)} aria-labelledby="kids-hall-title"><div class="kids-artboard__rail"><img src={asset(hall.img)} alt={hall.t} width="550" height="500" loading="lazy" decoding="async" /><article><h3 id="kids-hall-title">{hall.t}</h3><p>{hall.size}</p><b>{hall.capacity}</b><p>{hall.format}</p><ul>{(hall.equipment || []).map((item) => <li>{item}</li>)}</ul><a class="kids-artboard__button" href={bookingHref}>{halls.cta || 'Забронировать дату'}</a></article></div></section>
  <div class="kids-artboard__record kids-artboard__paper-gap" data-parity-record="rec769928041" style={recordStyle(records.dividerAfterHalls)} aria-hidden="true"></div>

  <section class="kids-artboard__record kids-artboard__section-head kids-artboard__booking-heading" data-parity-record="rec844797111" style={recordStyle(records.bookingHeading)} aria-labelledby="kids-booking-title"><div class="kids-artboard__rail"><p class="kids-artboard__eyebrow">ПРАЗДНИК ПОД КЛЮЧ</p><h2 id="kids-booking-title">{booking.title}</h2><p>{booking.subtitle}</p></div></section>
  <section class="kids-artboard__record kids-artboard__booking" data-parity-record="rec844797112" style={recordStyle(records.booking)} id="prazdnik" aria-label="Заявка на праздник"><div class="kids-artboard__rail"><form data-lead-form data-lead-kind="party" data-lead-target={site.header.wa} data-lead-recipient={site.leads?.recipient || ''} class="kids-artboard__lead-form kids-artboard__lead-form--booking" aria-describedby="kids-booking-status"><div class="kids-artboard__form-fields"><label for="kids-booking-name">Ваше имя<input id="kids-booking-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="80" required /></label><label for="kids-booking-phone">Телефон<input id="kids-booking-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="24" required /></label><label for="kids-booking-date">Дата праздника<input id="kids-booking-date" name="date" type="date" /></label></div><label class="kids-artboard__consent"><input name="consent" type="checkbox" required />Я принимаю <a href={href('/privacy')}>политику обработки данных</a></label><button class="kids-artboard__button" type="button" data-lead-submit>{booking.cta || 'Отправить заявку'}</button><p class="lead-form__status" id="kids-booking-status" data-lead-status role="status" aria-live="polite" hidden></p></form></div></section>
  <div class="kids-artboard__record kids-artboard__paper-gap" data-parity-record="rec769928041" style={recordStyle(records.dividerAfterBooking)} aria-hidden="true"></div>

  <section class="kids-artboard__record kids-artboard__section-head kids-artboard__additions-heading" data-parity-record="rec844797118" style={recordStyle(records.additionsHeading)} aria-labelledby="kids-additions-title"><div class="kids-artboard__rail"><p class="kids-artboard__eyebrow">ДОПОЛНЕНИЯ</p><h2 id="kids-additions-title">{additions.title}</h2><p>{additions.subtitle}</p></div></section>
  <section class="kids-artboard__record kids-artboard__small-tiles" data-parity-record="rec844797119" style={recordStyle(records.additions)} aria-label="Дополнения к празднику"><div class="kids-artboard__rail kids-artboard__small-grid">{(additions.items || []).map((item) => <a href={bookingHref}><img src={asset(item.img)} alt={item.t} width="220" height="190" loading="lazy" decoding="async" /><span>{item.t}</span></a>)}</div></section>
  <section class="kids-artboard__record kids-artboard__masterclasses" data-parity-record="rec844797122" style={recordStyle(records.masterclasses)} aria-labelledby="kids-masterclasses-title"><div class="kids-artboard__rail"><p class="kids-artboard__eyebrow">ТВОРЧЕСКАЯ ЧАСТЬ</p><h2 id="kids-masterclasses-title">{masterclasses.title}</h2><p>{masterclasses.subtitle}</p><div class="kids-artboard__small-grid">{(masterclasses.items || []).map((item) => <a href={bookingHref}><img src={asset(item.img)} alt={item.t} width="220" height="190" loading="lazy" decoding="async" /><span>{item.t}</span></a>)}</div></div></section>
  <div class="kids-artboard__record kids-artboard__paper-gap" data-parity-record="rec769928041" style={recordStyle(records.dividerAfterMasterclasses)} aria-hidden="true"></div>

  <section class="kids-artboard__record kids-artboard__reviews" data-parity-record="rec844797129" style={recordStyle(records.reviewsHeading)} aria-labelledby="kids-reviews-title"><div class="kids-artboard__rail"><p class="kids-artboard__eyebrow">ОТЗЫВЫ</p><h2 id="kids-reviews-title">{reviews.title}</h2><p>Более 10 000 восторженных отзывов от гостей и их родителей</p></div></section>
  <div class="kids-artboard__record kids-artboard__paper-gap" data-parity-record="rec769928041" style={recordStyle(records.dividerAfterReviews)} aria-hidden="true"></div>

  <section class="kids-artboard__record kids-artboard__invitation-heading" data-parity-record="rec844797133" style={recordStyle(records.invitationHeading)} aria-labelledby="kids-invitation-title"><div class="kids-artboard__rail"><p class="kids-artboard__eyebrow">ПРИГЛАСИТЕЛЬНЫЙ В MAX</p><h2 id="kids-invitation-title">{steps.title}</h2></div></section>
  <section class="kids-artboard__record kids-artboard__invitation" data-parity-record="rec844797134" style={recordStyle(records.invitation)} aria-labelledby="kids-invitation-copy"><div class="kids-artboard__rail kids-artboard__invitation-grid"><div><p class="kids-artboard__eyebrow">БЕСПЛАТНО</p><h2 id="kids-invitation-copy">{source.invitation?.title || steps.title}</h2><p>{source.invitation?.subtitle || steps.subtitle}</p><ol>{(steps.items || []).map((item, index) => <li><b>{index + 1}</b><span>{item.t}<small>{item.sub}</small></span></li>)}</ol></div><form data-lead-form data-lead-kind="party" data-lead-target={site.header.wa} data-lead-recipient={site.leads?.recipient || ''} class="kids-artboard__invite-form" aria-describedby="kids-invite-status"><label for="kids-invite-name">Имя именинника<input id="kids-invite-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="80" required /></label><label for="kids-invite-phone">Телефон<input id="kids-invite-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="24" required /></label><label for="kids-invite-date">Дата праздника<input id="kids-invite-date" name="date" type="date" /></label><label class="kids-artboard__consent"><input name="consent" type="checkbox" required />Соглашаюсь с <a href={href('/privacy')}>политикой</a></label><button class="kids-artboard__button" type="button" data-lead-submit>{source.invitation?.cta || 'Получить пригласительный'}</button><p class="lead-form__status" id="kids-invite-status" data-lead-status role="status" aria-live="polite" hidden></p></form></div></section>
  <div class="kids-artboard__record kids-artboard__paper-gap" data-parity-record="rec769928041" style={recordStyle(records.dividerAfterInvitation)} aria-hidden="true"></div>

  <section class="kids-artboard__record kids-artboard__gallery-heading" data-parity-record="rec844797138" style={recordStyle(records.galleryHeading)} aria-labelledby="kids-gallery-title"><div class="kids-artboard__rail"><p class="kids-artboard__eyebrow">ФОТОГАЛЕРЕЯ</p><h2 id="kids-gallery-title">{gallery.title}</h2><p>{gallery.subtitle}</p></div></section>
  <section class="kids-artboard__record kids-artboard__gallery" data-parity-record="rec844797139" style={recordStyle(records.gallery)} aria-label="Фотографии с мероприятий"><div class="kids-artboard__rail kids-artboard__gallery-grid">{(gallery.photos || []).map((image, index) => <img src={asset(image)} alt={`Фотография праздника ${index + 1}`} width="900" height="700" loading="lazy" decoding="async" />)}</div></section>
  <div class="kids-artboard__record kids-artboard__paper-gap" data-parity-record="rec769928041" style={recordStyle(records.dividerAfterGallery)} aria-hidden="true"></div>

  <section class="kids-artboard__record kids-artboard__venues-heading" data-parity-record="rec1100733926" style={recordStyle(records.venuesHeading)} aria-labelledby="kids-venues-title"><div class="kids-artboard__rail"><p class="kids-artboard__eyebrow">НАШИ ПЛОЩАДКИ</p><h2 id="kids-venues-title">9 площадок для праздника в Ростове-на-Дону</h2></div></section>
  <section class="kids-artboard__record kids-artboard__venues" data-parity-record="rec1100733931" style={recordStyle(records.venues)} aria-label="Адреса площадок"><div class="kids-artboard__rail">{venues.map((venue) => <a href={href(venue.href)}>{venue.title}</a>)}</div></section>
  <div class="kids-artboard__record kids-artboard__footer-spacer" data-parity-record="rec1100733986" style={recordStyle(records.footerSpacer)} aria-hidden="true"></div>

  <footer class="kids-artboard__record kids-artboard__footer" data-parity-record="rec1100733991" style={recordStyle(records.footer)}><div class="kids-artboard__rail kids-artboard__footer-grid"><section><h2>ОРГАНИЗАЦИЯ МЕРОПРИЯТИЙ</h2>{organisation.map(([title, link]) => <a href={href(link)}>{title}</a>)}</section><section><h2>ВИДЫ РАЗВЛЕЧЕНИЙ</h2>{entertainment.map(([title, link]) => <a href={href(link)}>{title}</a>)}</section><section><h2>НАШИ ПЛОЩАДКИ</h2>{venues.slice(0, 6).map((venue) => <a href={href(venue.href)}>{venue.title}</a>)}</section><section><a class="kids-artboard__footer-phone" href={site.header.phoneHref}>{site.header.phone}</a><p>Работаем с 10:00 до 23:30</p><p>ИП Мелешкин Юрий Иванович<br />ИНН 164409771610<br />ОГРНИП 322169000094990</p><a href={href('/privacy')}>Политика обработки персональных данных</a></section></div></footer>
  <div class="kids-artboard__record kids-artboard__copyright" data-parity-record="rec1100733996" style={recordStyle(records.copyright)}><div class="kids-artboard__rail"><a href={href('/')}>ЧЁ ЗА КВЕСТ</a><span>© 2026 ЧЁ ЗА КВЕСТ. Все права защищены.</span></div></div>
</div>

<script>
  import '../scripts/lead-form.js';
</script>

<style>
  .kids-artboard{--kids-orange:#ff6a00;--kids-ink:#292929;--kids-paper:#f7f6f1;overflow:hidden;background:var(--kids-paper);color:var(--kids-ink);font-family:Montserrat,Arial,sans-serif}.kids-artboard *,.kids-artboard *::before,.kids-artboard *::after{box-sizing:border-box}.kids-artboard a{color:inherit;text-decoration:none}.kids-artboard__record{position:relative;height:var(--kids-record-desktop);overflow:hidden}.kids-artboard__rail{position:relative;width:1160px;height:100%;margin:auto}.kids-artboard h1,.kids-artboard h2,.kids-artboard h3,.kids-artboard p{margin:0}.kids-artboard h2{font:900 37px/.98 Montserrat,Arial,sans-serif;letter-spacing:-.04em;text-transform:uppercase}.kids-artboard__eyebrow{color:var(--kids-orange);font:800 11px/1 Montserrat,Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase}.kids-artboard__button{display:inline-flex;min-height:47px;padding:0 24px;align-items:center;justify-content:center;border:2px solid var(--kids-orange);border-radius:24px;background:var(--kids-orange);color:#fff!important;font:800 11px/1 Montserrat,Arial,sans-serif;text-transform:uppercase;transition:filter .2s ease,transform .2s ease}.kids-artboard__button:hover,.kids-artboard__button:focus-visible{filter:brightness(1.08);transform:translateY(-1px)}.kids-artboard__button--outline{background:transparent;color:var(--kids-orange)!important}.kids-artboard__header{background:#fff;border-bottom:1px solid #ece8de}.kids-artboard__header-inner{display:flex;align-items:center;justify-content:space-between}.kids-artboard__brand{color:var(--kids-orange)!important;font:900 17px/.88 Montserrat,Arial,sans-serif;letter-spacing:-.07em}.kids-artboard__header nav{display:flex;gap:28px}.kids-artboard__header nav a{font:700 11px/1 Montserrat,Arial,sans-serif;text-transform:uppercase}.kids-artboard__header nav a:hover{color:var(--kids-orange)}.kids-artboard__phone{color:var(--kids-orange)!important;font:800 15px/1 Montserrat,Arial,sans-serif}.kids-artboard__hero{background:#fff}.