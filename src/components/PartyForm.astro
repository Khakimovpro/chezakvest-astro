---
// Сквозной блок «У нас вы можете отметить День рождения!» — белая карточка с формой заявки
// и оранжевой волной снизу. Одинаковый на всех страницах квестов.
import site from '../data/site.json';
import { siteHref } from '../lib/urls.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (h) => siteHref(base, h);
const { id = 'party' } = Astro.props;
const s = site;
---
<section class="pform" id="prazdnik">
  <div class="container">
    <div class="pform__card">
      <h2 class="pform__title">У нас вы можете отметить День рождения!</h2>
      <p class="pform__sub">Отправьте заявку, узнайте свободна ли ваша дата.<br />Поможем подобрать программу праздника.</p>
      <form class="pform__form" data-lead-form data-lead-kind="party" data-lead-target={s.header.wa} data-lead-recipient={s.leads?.recipient || ''} aria-describedby={`${id}-status`}>
        <div class="pform__grid">
          <div class="pform__field pform__field--date">
            <label class="pform__label" for={`${id}-date`}>Выберите дату</label>
            <input id={`${id}-date`} name="date" type="date" autocomplete="off" required />
          </div>
          <div class="pform__field pform__field--name">
            <label class="pform__label" for={`${id}-name`}>Ваше имя</label>
            <input id={`${id}-name`} name="name" type="text" placeholder="Ваше имя" autocomplete="name" minlength="2" maxlength="80" required />
          </div>
          <div class="pform__field pform__field--phone">
            <label class="pform__label" for={`${id}-phone`}>Телефон</label>
            <span class="pform__flag" aria-hidden="true">🇷🇺</span>
            <input id={`${id}-phone`} name="phone" type="tel" placeholder="+7 (000) 000-00-00" inputmode="tel" autocomplete="tel" maxlength="24" required />
          </div>
        </div>
        <label class="pform__consent">
          <input name="consent" type="checkbox" required />
          <span>Даю согласие на обработку моих персональных данных в соответствии с <a href={link('/privacy')}>Политикой обработки персональных данных</a></span>
        </label>
        <button class="btn-orange pform__submit" type="button" data-lead-submit>Отправить</button>
        <p class="lead-form__status" id={`${id}-status`} data-lead-status role="status" aria-live="polite" hidden></p>
        <noscript><p class="lead-form__status">Чтобы оставить заявку, включите JavaScript или позвоните нам по телефону на сайте.</p></noscript>
      </form>
      <div class="pform__wave" aria-hidden="true">
        <svg viewBox="0 0 1120 210" preserveAspectRatio="none"><path fill="#ff8a00" d="M0 78c186-52 373-52 560 0s374 52 560 0v132H0z"/></svg>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/lead-form.js';
</script>
