---
// The owner-confirmed counter id lives in site.json so every layout shares one
// source of truth. Keep initialization free of unconfirmed conversion and
// commerce settings; those need separate, explicit analytics requirements.
import site from '../data/site.json';

const rawId = String(site.analytics?.metrikaId || '').trim();
const metrikaId = /^\d{4,20}$/.test(rawId) ? rawId : '';
---
{metrikaId && (
  <script is:inline define:vars={{ metrikaId }}>
    (function initMetrika() {
      window.ym = window.ym || function queueMetrika() {
        (window.ym.a = window.ym.a || []).push(arguments);
      };
      window.ym.l = Date.now();
      window.ym(metrikaId, 'init', {
        clickmap: true,
        accurateTrackBounce: true,
      });

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://mc.yandex.ru/metrika/tag.js`;
      document.head.append(script);
    }());
  </script>
)}
