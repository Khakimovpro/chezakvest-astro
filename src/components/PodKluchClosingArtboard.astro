---
// Native Tilda tail for /prazdniki-pod-kluch/.  The generic holiday tiles and
// card grid altered four source records; this isolated renderer keeps the
// capture's record boundaries and first carousel frame without affecting other
// holiday routes.
const { closing = {}, asset = (value) => value, href = (value) => value } = Astro.props;
const collections = closing.collections || [];
const hall = closing.hall || {};
const gallery = closing.gallery || {};
const reviews = closing.reviews || {};
const asPx = (value, fallback = 0) => `${Number(value ?? fallback)}px`;
const recordStyle = (desktop, mobile) => [
  `--podkluch-closing-height:${asPx(desktop)}`,
  `--podkluch-closing-height-mobile:${asPx(mobile)}`,
].join(';');
const gallerySpan = (index) => gallery.desktopLayout?.[index] || 1;
const reviewItemStyle = (item) => [
  `--podkluch-review-left:${asPx(item.desktop?.left)}`,
  `--podkluch-review-top:${asPx(item.desktop?.top)}`,
  `--podkluch-review-height:${asPx(item.desktop?.height)}`,
  `--podkluch-review-left-mobile:${asPx(item.mobile?.left)}`,
  `--podkluch-review-top-mobile:${asPx(item.mobile?.top)}`,
  `--podkluch-review-height-mobile:${asPx(item.mobile?.height)}`,
].join(';');
---

<section class="podkluch-closing" data-podkluch-closing>
  {collections.map((collection) => (
    <section
      class="podkluch-closing__collection"
      data-parity-record={collection.record}
      style={recordStyle(collection.desktopHeight, collection.mobileHeight)}
      aria-labelledby={`${collection.record}-title`}
    >
      <div class="podkluch-closing__collection-rail">
        <h2 id={`${collection.record}-title`}>
          <span>{collection.title?.prefix}</span><span class="podkluch-closing__accent">{collection.title?.accent}</span>
        </h2>
        <div class="podkluch-closing__collection-viewport" tabindex="0" aria-label={collection.title?.prefix + collection.title?.accent}>
          <ul class="podkluch-closing__collection-grid">
            {collection.items.map((item) => (
              <li class="podkluch-closing__collection-card">
                <a class="podkluch-closing__collection-media" href={href(item.href)} aria-label={item.t}>
                  <img src={asset(item.src)} alt="" width="224" height="224" loading="lazy" decoding="async" />
                </a>
                <a class="podkluch-closing__collection-title" href={href(item.href)}>{item.t}</a>
                <div class="podkluch-closing__collection-actions">
                  <a class="podkluch-closing__collection-cta" href={href(item.href)}>{item.cta}</a>
                  {item.video && <a class="podkluch-closing__collection-video" href={href(item.href)}>{item.video}</a>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  ))}

  {hall.items?.length > 0 && (
    <>
      <section
        class="podkluch-closing__hall-heading"
        data-parity-record={hall.headingRecord}
        style={recordStyle(hall.headingDesktopHeight, hall.headingMobileHeight)}
      >
        <h2><span>{hall.heading?.prefix}</span>{' '}<span class="podkluch-closing__accent">{hall.heading?.accent}</span></h2>
      </section>
      <section
        class="podkluch-closing__hall"
        data-podkluch-hall
        data-initial-index={hall.initialIndex || 0}
        data-parity-record={hall.recordDesktop}
        data-parity-record-mobile={hall.recordMobile}
        style={recordStyle(hall.desktopHeight, hall.mobileHeight)}
        aria-label={hall.heading?.prefix + hall.heading?.accent}
      >
        <div class="podkluch-closing__hall-artboard">
          {hall.items.map((item, index) => (
            <article class="podkluch-closing__hall-slide" data-podkluch-hall-slide hidden={index !== (hall.initialIndex || 0)}>
              <a class="podkluch-closing__hall-media" href={href(item.href)} aria-label={item.t}>
                <img src={asset(item.img)} alt="" width="800" height="500" loading="lazy" decoding="async" />
              </a>
              <div class="podkluch-closing__hall-panel">
                <h3>{item.t}</h3>
                <p>{item.capacity}</p>
                <strong>Вас ждут:</strong>
                <ul>{item.lines.map((line) => <li>{line}</li>)}</ul>
              </div>
              <a class="podkluch-closing__hall-cta" href={href('#prazdnik')}>{hall.cta}</a>
            </article>
          ))}
          <div class="podkluch-closing__hall-controls">
            <button type="button" data-podkluch-hall-prev aria-label="Предыдущий зал">‹</button>
            <button type="button" data-podkluch-hall-next aria-label="Следующий зал">›</button>
            <p data-podkluch-hall-status aria-live="polite"></p>
          </div>
        </div>
      </section>
    </>
  )}

  {gallery.items?.length > 0 && (
    <>
      <section
        class="podkluch-closing__gallery-heading"
        data-parity-record={gallery.headingRecord}
        style={recordStyle(gallery.headingDesktopHeight, gallery.headingMobileHeight)}
      >
        <h2><span>{gallery.heading?.prefix}</span>{' '}<span class="podkluch-closing__accent">{gallery.heading?.accent}</span></h2>
      </section>
      <section
        class="podkluch-closing__gallery"
        data-parity-record={gallery.record}
        style={recordStyle(gallery.desktopHeight, gallery.mobileHeight)}
        aria-label={gallery.heading?.prefix + gallery.heading?.accent}
      >
        <div class="podkluch-closing__gallery-viewport" tabindex="0">
          <div class="podkluch-closing__gallery-grid">
            {gallery.items.map((item, index) => (
              <img
                src={asset(item.src)}
                alt={`Фото с мероприятия ${index + 1}`}
                width="926"
                height="611"
                style={`--podkluch-gallery-span:${gallerySpan(index)}`}
                loading="lazy"
                decoding="async"
              />
            ))}
          </div>
        </div>
      </section>
    </>
  )}

  {reviews.headingRecord && (
    <section class="podkluch-closing__reviews" aria-label="Что говорят о нас">
      <div
        class="podkluch-closing__reviews-heading"
        data-parity-record={reviews.headingRecord}
        style={recordStyle(reviews.headingDesktopHeight, reviews.headingMobileHeight)}
      ><h2>Что говорят <span class="podkluch-closing__accent">о нас</span></h2></div>
      <div
        class="podkluch-closing__reviews-body"
        data-parity-record={reviews.bodyRecord}
        style={recordStyle(reviews.bodyDesktopHeight, reviews.bodyMobileHeight)}
        aria-label="Локальная область отзывов"
      >
        <div class="podkluch-closing__reviews-grid">
          {reviews.items.map((item, index) => (
            <img
              src={asset(item.src)}
              alt={`Отзыв ${index + 1}`}
              width="440"
              height={item.desktop.height}
              style={reviewItemStyle(item)}
              decoding="async"
            />
          ))}
        </div>
      </div>
      <div
        class="podkluch-closing__reviews-action"
        data-parity-record={reviews.actionRecord}
        style={recordStyle(reviews.actionDesktopHeight, reviews.actionMobileHeight)}
      ><a href={href(reviews.href)}><img src={asset(reviews.icon)} alt="" width="20" height="20" /><span>{reviews.action}</span></a></div>
    </section>
  )}
</section>

<script>
  document.querySelectorAll('[data-podkluch-hall]').forEach((root) => {
    const slides = [...root.querySelectorAll('[data-podkluch-hall-slide]')];
    const previous = root.querySelector('[data-podkluch-hall-prev]');
    const next = root.querySelector('[data-podkluch-hall-next]');
    const status = root.querySelector('[data-podkluch-hall-status]');
    let current = Number(root.dataset.initialIndex || 0);

    const render = () => {
      slides.forEach((slide, index) => { slide.hidden = index !== current; });
      if (status) status.textContent = `${current + 1} из ${slides.length}`;
    };
    const move = (delta) => {
      current = (current + delta + slides.length) % slides.length;
      render();
    };

    previous?.addEventListener('click', () => move(-1));
    next?.addEventListener('click', () => move(1));
    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') move(-1);
      if (event.key === 'ArrowRight') move(1);
      if (event.key === 'Home') { current = 0; render(); }
      if (event.key === 'End') { current = slides.length - 1; render(); }
    });
    render();
  });
</script>

<style>
  .podkluch-closing{overflow:hidden;background:transparent;color:#474747}
  .podkluch-closing *,.podkluch-closing *::before,.podkluch-closing *::after{box-sizing:border-box}
  .podkluch-closing h2,.podkluch-closing h3,.podkluch-closing p,.podkluch-closing ul{margin:0}
  .podkluch-closing__accent{color:#ff6900}
  .podkluch-closing__collection,.podkluch-closing__hall,.podkluch-closing__gallery,.podkluch-closing__reviews-heading,.podkluch-closing__reviews-body,.podkluch-closing__reviews-action,.podkluch-closing__hall-heading{height:var(--podkluch-closing-height);overflow:hidden}
  .podkluch-closing__collection-rail{width:1200px;height:100%;margin:0 auto;padding-top:63px}
  .podkluch-closing__collection h2,.podkluch-closing__hall-heading h2,.podkluch-closing__gallery-heading h2,.podkluch-closing__reviews-heading h2{color:#474747;font:700 34px/41.8125px Montserrat,Arial,sans-serif;text-align:center}
  .podkluch-closing__collection-viewport{width:1120px;margin:40px auto 0;overflow:hidden;outline-offset:3px}
  .podkluch-closing__collection-grid{display:grid;grid-template-columns:repeat(5,224px);gap:0;width:1120px;padding:0;list-style:none}
  .podkluch-closing__collection-card{min-width:0;text-align:center}
  .podkluch-closing__collection-media{display:block;width:224px;height:224px;overflow:hidden;border-radius:30px}
  .podkluch-closing__collection-media img{width:100%;height:100%;object-fit:cover}
  .podkluch-closing__collection-title{display:block;min-height:38px;margin-top:12px;padding:0 5px;color:#474747;font:600 18px/21.6px Nunito,Arial,sans-serif;text-decoration:none;text-transform:uppercase}
  .podkluch-closing__collection-actions{display:flex;min-height:35px;align-items:center;justify-content:center;gap:7px;margin-top:4px}
  .podkluch-closing__collection-cta,.podkluch-closing__collection-video{display:inline-flex;height:35px;align-items:center;justify-content:center;border-radius:30px;font:400 13px/18px Nunito,Arial,sans-serif;text-decoration:none}
  .podkluch-closing__collection-cta{width:85px;color:#fff;background:linear-gradient(0deg,#ff9415 0%,#ffc709 100%)}
  .podkluch-closing__collection-video{width:70px;border:1px solid #979797;color:#474747;background:#fff}
  .podkluch-closing__hall-heading{display:flex;align-items:center;justify-content:center;padding-top:1px}
  .podkluch-closing__hall-artboard{position:relative;width:1200px;height:100%;margin:0 auto}
  .podkluch-closing__hall-slide{position:absolute;inset:0}
  .podkluch-closing__hall-slide[hidden]{display:none}
  .podkluch-closing__hall-media{position:absolute;top:8px;left:81px;display:block;width:800px;height:500px;overflow:hidden;border-radius:30px}
  .podkluch-closing__hall-media img{width:100%;height:100%;object-fit:cover}
  .podkluch-closing__hall-panel{position:absolute;top:141px;left:731px;width:390px;height:420px;overflow:auto;padding:25px 26px;border-radius:30px;background:rgba(255,255,255,.8);box-shadow:0 0 12px rgba(71,71,71,.3);font:400 16px/1.4 Arial,sans-serif}
  .podkluch-closing__hall-panel h3{margin-bottom:13px;color:#ff6900;font:700 16px/1.2 Arial,sans-serif}
  .podkluch-closing__hall-panel p{margin-bottom:18px}
  .podkluch-closing__hall-panel strong{display:block;margin-bottom:2px}
  .podkluch-closing__hall-panel ul{padding:0;list-style:none}
  .podkluch-closing__hall-panel li{margin:0 0 1px}
  .podkluch-closing__hall-cta{position:absolute;top:486px;left:826px;display:flex;width:200px;height:55px;align-items:center;justify-content:center;border-radius:30px;color:#fff;background:linear-gradient(0deg,#ff9415 0%,#ffc709 100%);box-shadow:0 2px 3px rgba(71,71,71,.2);font:500 18px/1 Arial,sans-serif;text-decoration:none}
  .podkluch-closing__hall-controls{position:absolute;top:8px;left:1007px;z-index:2;display:grid;grid-template-columns:40px 40px;gap:30px;align-items:start}
  .podkluch-closing__hall-controls button{width:40px;height:40px;padding:0;border:1px solid #bdbdbd;border-radius:50%;color:#474747;background:#fff;font:400 29px/34px Arial,sans-serif}
  .podkluch-closing__hall-controls p{grid-column:1 / -1;width:110px;margin-left:-14px;color:#000;font:400 12px/18px Arial,sans-serif;text-align:center}
  .podkluch-closing__gallery-heading{display:flex;align-items:center;justify-content:center}
  .podkluch-closing__gallery-viewport{height:100%;overflow:hidden;outline-offset:3px}
  .podkluch-closing__gallery-grid{display:grid;grid-template-columns:repeat(3,454px);grid-auto-rows:611px;gap:20px;width:1400px;margin:0 auto;padding-top:20px}
  .podkluch-closing__gallery-grid img{grid-column:span var(--podkluch-gallery-span);width:100%;height:611px;object-fit:cover;border-radius:18px}
  .podkluch-closing__reviews-heading{position:relative;background:#ff9100}
  .podkluch-closing__reviews-heading h2{position:absolute;top:68px;left:50%;width:756px;transform:translateX(-50%);color:#ff6b00;font:800 38px/1.15 Montserrat,Arial,sans-serif;text-align:center}
  .podkluch-closing__reviews-heading .podkluch-closing__accent{color:#fff}
  .podkluch-closing__reviews-body{position:relative;background:linear-gradient(0deg,#ff6b00 0%,#ff9100 100%)}
  .podkluch-closing__reviews-grid{position:relative;width:1360px;height:100%;margin:0 auto}
  .podkluch-closing__reviews-grid img{position:absolute;top:var(--podkluch-review-top);left:var(--podkluch-review-left);display:block;width:440px;height:var(--podkluch-review-height)}
  .podkluch-closing__reviews-action{display:block;padding-right:max(20px,calc((100% - 1200px) / 2 + 20px));background:#ff6b00}
  .podkluch-closing__reviews-action a{display:flex;width:160px;height:25px;align-items:center;margin-left:auto;color:#fff;font:400 16px/24.8px Montserrat,Arial,sans-serif;text-decoration:none}
  .podkluch-closing__reviews-action img{display:block;width:31px;height:20px;padding-right:11px}
  .podkluch-closing__reviews-action span{display:block;white-space:nowrap}

  @media (max-width:639px){
    .podkluch-closing__collection,.podkluch-closing__hall,.podkluch-closing__gallery,.podkluch-closing__reviews-heading,.podkluch-closing__reviews-body,.podkluch-closing__reviews-action,.podkluch-closing__hall-heading{height:var(--podkluch-closing-height-mobile)}
    .podkluch-closing__collection-rail{width:390px;padding-top:47px}
    .podkluch-closing__collection h2,.podkluch-closing__hall-heading h2,.podkluch-closing__gallery-heading h2,.podkluch-closing__reviews-heading h2{font-size:25px;line-height:30px}
    .podkluch-closing__collection-viewport{width:390px;margin-top:31px;overflow-x:auto;overscroll-behavior-inline:contain;scroll-snap-type:x mandatory;scrollbar-width:none}
    .podkluch-closing__collection-viewport::-webkit-scrollbar{display:none}
    .podkluch-closing__collection-grid{display:flex;gap:14px;width:max-content;padding:0 20px 6px}
    .podkluch-closing__collection-card{width:224px;flex:0 0 224px;scroll-snap-align:start}
    .podkluch-closing__collection-title{margin-top:9px;font-size:15px;line-height:18px}
    .podkluch-closing__collection-actions{margin-top:1px}
    .podkluch-closing__hall-heading{padding:0 20px}
    .podkluch-closing__hall-artboard{width:320px}
    .podkluch-closing__hall-media{top:10px;left:-20px;width:360px;height:255px;border-radius:0}
    .podkluch-closing__hall-panel{top:190px;left:20px;width:280px;height:325px;padding:20px;border-radius:30px;font-size:10px;line-height:1.25}
    .podkluch-closing__hall-panel h3{margin-bottom:8px;font-size:12px}.podkluch-closing__hall-panel p{margin-bottom:9px}
    .podkluch-closing__hall-cta{top:460px;left:86px;width:148px;height:41px;font-size:14px}
    .podkluch-closing__hall-controls{top:530px;left:110px;gap:20px}.podkluch-closing__hall-controls button{width:40px;height:40px}.podkluch-closing__hall-controls p{margin:0;transform:translateX(-20px)}
    .podkluch-closing__gallery-grid{display:flex;gap:12px;width:max-content;margin:0;padding:10px 20px 0}
    .podkluch-closing__gallery-viewport{overflow-x:auto;overscroll-behavior-inline:contain;scroll-snap-type:x mandatory;scrollbar-width:none}
    .podkluch-closing__gallery-viewport::-webkit-scrollbar{display:none}
    .podkluch-closing__gallery-grid img{width:350px;height:680px;flex:0 0 350px;grid-column:auto;scroll-snap-align:start;border-radius:14px}
    .podkluch-closing__reviews-heading h2{top:51px;width:300px;font-size:29px;line-height:1.15}
    .podkluch-closing__reviews-grid{width:350px}
    .podkluch-closing__reviews-grid img{top:var(--podkluch-review-top-mobile);left:var(--podkluch-review-left-mobile);width:170px;height:var(--podkluch-review-height-mobile)}
    .podkluch-closing__reviews-action{padding-right:20px}.podkluch-closing__reviews-action a{width:128px;height:20px;font-size:12px;line-height:17.4px}.podkluch-closing__reviews-action img{width:31px;height:20px}
  }
</style>
