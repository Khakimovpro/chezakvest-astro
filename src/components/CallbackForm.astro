---
// Сквозная форма «Есть вопрос?» — есть на главной и на всех внутренних страницах.
import site from '../data/site.json';
import { siteHref } from '../lib/urls.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (h) => siteHref(base, h);
const { id = 'cb', sectionId = 'callback', recordId = undefined } = Astro.props;
const s = site;
---
<section class="callback" id={sectionId} data-parity-record={recordId}>
  <div class="container">
    <form class="cbform" data-lead-form data-lead-kind="callback" data-lead-target={s.header.wa} data-lead-recipient={s.leads?.recipient || ''} aria-describedby={`${id}-status`}>
      <h2 class="cbform__title">{s.callback.title}</h2>
      <p class="cbform__sub">{s.callback.sub}</p>
      <div class="cbform__fields">
        <div class="cbform__field">
          <label class="cbform__label" for={`${id}-name`}>Ваше имя</label>
          <input id={`${id}-name`} name="name" type="text" placeholder={s.callback.namePh} autocomplete="name" minlength="2" maxlength="80" required />
        </div>
        <div class="cbform__field">
          <label class="cbform__label" for={`${id}-phone`}>Телефон</label>
          <div class="cbform__phone">
            <span class="cbform__flag" aria-hidden="true">🇷🇺</span>
            <input id={`${id}-phone`} name="phone" type="tel" placeholder={`+7 ${s.callback.phonePh}`} inputmode="tel" autocomplete="tel" maxlength="24" required />
          </div>
        </div>
      </div>
      <label class="cbform__consent">
        <input name="consent" type="checkbox" required />
        <span>{s.callback.consent} <a href={link('/privacy')}>{s.callback.consentLink}</a></span>
      </label>
      <button class="btn-orange cbform__submit" type="button" data-lead-submit>{s.callback.btn}</button>
      <p class="lead-form__status" id={`${id}-status`} data-lead-status role="status" aria-live="polite" hidden></p>
      <noscript><p class="lead-form__status">Чтобы оставить заявку, включите JavaScript или позвоните нам по телефону на сайте.</p></noscript>
    </form>
  </div>
</section>

<script>
  import '../scripts/lead-form.js';
</script>
