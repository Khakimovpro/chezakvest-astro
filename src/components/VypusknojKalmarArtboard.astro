---
// This campaign is a captured Tilda composition, not a variant of the shared
// holiday template.  Its artboard geometry stays opt-in and is driven by the
// matching page data so no other holiday route inherits its dark presentation.
const { source = {}, asset = (value) => value, href = (value) => value, phoneHref = '#', phone = '' } = Astro.props;
const records = source.records || {};
const hero = source.hero || {};
const program = source.program || {};
const scenarios = source.scenarios || {};
const additions = source.additions || {};
const hall = source.hall || {};
const trust = source.trust || {};
const gift = source.gift || {};
const venues = source.venues || {};
const footer = source.footer || {};
const bookingHref = href(source.bookingHref || '#prazdnik');
const desktopFooterRecordTrim = -Math.abs(Number(source.desktopFooterRecordTrim) || 0);

const px = (value) => Number.isFinite(value) ? `${value}px` : String(value || '');
const recordStyle = (record = {}) => [
  record.desktop && `--vypusknoj-record-desktop:${px(record.desktop)}`,
  record.mobile && `--vypusknoj-record-mobile:${px(record.mobile)}`,
].filter(Boolean).join(';');
const layerStyle = (layer) => {
  const desktop = layer.desktop || {};
  const mobile = layer.mobile || {};
  return [
    ['--vyp-layer-top', desktop.top],
    ['--vyp-layer-left', desktop.left],
    ['--vyp-layer-width', desktop.width],
    ['--vyp-layer-height', desktop.height],
    ['--vyp-layer-top-mobile', mobile.top],
    ['--vyp-layer-left-mobile', mobile.left],
    ['--vyp-layer-width-mobile', mobile.width],
    ['--vyp-layer-height-mobile', mobile.height],
  ].filter(([, value]) => value !== undefined && value !== null)
    .map(([name, value]) => `${name}:${px(value)}`).join(';');
};
const bgStyle = (image) => image ? `background-image:url('${asset(image)}')` : '';
---

<div class="vypusknoj-artboard" id="about" style={`--vypusknoj-desktop-footer-trim:${desktopFooterRecordTrim}px`}>
  <div class="vypusknoj-artboard__spacer" data-parity-record={records.spacer?.id} style={recordStyle(records.spacer)} aria-hidden="true"></div>

  <section class="vypusknoj-artboard__hero" data-parity-record={records.hero?.id} aria-labelledby="vypusknoj-hero-title" style={`${recordStyle(records.hero)};${bgStyle(hero.background)}`}>
    <div class="vypusknoj-artboard__hero-canvas">
      {(hero.layers || []).map((layer) => (
        <img class="vypusknoj-artboard__hero-layer" src={asset(layer.src)} alt="" aria-hidden="true"
             style={layerStyle(layer)} width={layer.desktop?.width || 1} height={layer.desktop?.height || 1}
             fetchpriority="high" decoding="async" />
      ))}
      {hero.logo && <img class="vypusknoj-artboard__hero-logo" src={asset(hero.logo)} alt="Чё за Квест" width="48" height="42" decoding="async" />}
      <nav class="vypusknoj-artboard__hero-nav" aria-label="Навигация выпускного">
        {(hero.nav || []).map((item) => (<a href={href(item.href)}>{item.title}</a>))}
        {phone && <a class="vypusknoj-artboard__hero-phone" href={phoneHref}>{phone}</a>}
      </nav>
      <div class="vypusknoj-artboard__hero-copy">
        {hero.city && <p class="vypusknoj-artboard__hero-city">{hero.city}</p>}
        {hero.sub && <p class="vypusknoj-artboard__hero-sub">{hero.sub}</p>}
        <h1 id="vypusknoj-hero-title">{hero.title}</h1>
        {hero.benefit && <p class="vypusknoj-artboard__hero-benefit">{hero.benefit}</p>}
        {hero.cta && <a class="vypusknoj-artboard__pink-button" href={bookingHref}>{hero.cta}</a>}
      </div>
    </div>
  </section>

  <section class="vypusknoj-artboard__intro" data-parity-record={records.intro?.id} style={recordStyle(records.intro)} aria-labelledby="vypusknoj-intro-title">
    <div class="vypusknoj-artboard__rail">
      <h2 id="vypusknoj-intro-title">{source.intro?.title}</h2>
      <p>{source.intro?.text}</p>
    </div>
  </section>

  <section class="vypusknoj-artboard__features" data-parity-record={records.features?.id} style={`${recordStyle(records.features)};${bgStyle(source.features?.background)}`} aria-labelledby="vypusknoj-features-title">
    <div class="vypusknoj-artboard__rail vypusknoj-artboard__features-canvas">
      <h2 id="vypusknoj-features-title">{source.features?.title}</h2>
      {source.features?.figure && <img class="vypusknoj-artboard__features-figure" src={asset(source.features.figure)} alt="" aria-hidden="true" width="181" height="389" loading="lazy" decoding="async" />}
      <ul>
        {(source.features?.items || []).map((item) => (<li>{item}</li>))}
      </ul>
    </div>
  </section>

  <section class="vypusknoj-artboard__section-heading" data-parity-record={records.scenarioHeading?.id} style={recordStyle(records.scenarioHeading)} aria-labelledby="vypusknoj-scenario-heading">
    <h2 id="vypusknoj-scenario-heading">ВЫБЕРИТЕ СВОЙ <span>СЦЕНАРИЙ</span> ВЫПУСКНОГО</h2>
  </section>

  <section class="vypusknoj-artboard__program" data-parity-record={records.program?.id} style={`${recordStyle(records.program)};${bgStyle(program.background)}`} aria-labelledby="vypusknoj-program-title">
    <div class="vypusknoj-artboard__rail vypusknoj-artboard__program-canvas">
      <p class="vypusknoj-artboard__program-label">{program.label}</p>
      {program.poster && <img class="vypusknoj-artboard__program-poster" src={asset(program.poster)} alt="" aria-hidden="true" width="776" height="1042" loading="lazy" decoding="async" />}
      <h2 id="vypusknoj-program-title">{program.title}</h2>
      <div class="vypusknoj-artboard__program-grid">
        {(program.cards || []).map((card) => (
          <a class="vypusknoj-artboard__program-card" href={bookingHref}>
            <img src={asset(card.src)} alt="" width="972" height="824" loading="lazy" decoding="async" />
            <span>{card.title}</span>
          </a>
        ))}
      </div>
      {program.cta && <a class="vypusknoj-artboard__pink-button vypusknoj-artboard__program-cta" href={bookingHref}>{program.cta}</a>}
    </div>
  </section>

  <div class="vypusknoj-artboard__divider vypusknoj-artboard__divider--art" data-parity-record={records.dividerAfterProgram?.id} style={recordStyle(records.dividerAfterProgram)} aria-hidden="true">
    {hero.dividerArt && <img src={asset(hero.dividerArt)} alt="" width="140" height="140" loading="lazy" decoding="async" />}
  </div>

  <section class="vypusknoj-artboard__carousel vypusknoj-artboard__carousel--scenarios" data-parity-record={records.scenarios?.id} style={recordStyle(records.scenarios)} aria-labelledby="vypusknoj-scenarios-title"
           data-vypusk-slider data-vypusk-slider-mode="cards" data-vypusk-offset-desktop="-280" data-vypusk-offset-mobile="0" data-vypusk-step-desktop="300" data-vypusk-step-mobile="344">
    <h2 id="vypusknoj-scenarios-title">{scenarios.title}</h2>
    <div class="vypusknoj-artboard__carousel-window" data-vypusk-slider-window>
      <div class="vypusknoj-artboard__carousel-track" data-vypusk-slider-track>
        {(scenarios.items || []).map((item, index) => (
          <article class="vypusknoj-artboard__carousel-card" data-vypusk-slider-slide id={`vypusknoj-scenario-${index + 1}`} aria-label={`Сценарий ${index + 1} из ${(scenarios.items || []).length}`}>
            <a href={href(item.href)}><img src={asset(item.src)} alt={item.title} width="520" height="400" loading="lazy" decoding="async" /></a>
            <div>
              <a href={href(item.href)}>{item.title}</a>
              <a class="vypusknoj-artboard__carousel-cta" href={bookingHref}>{scenarios.cta} <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
    <div class="vypusknoj-artboard__carousel-controls" aria-label="Управление сценариями">
      <button class="vypusknoj-artboard__carousel-arrow" type="button" data-vypusk-slider-prev aria-label="Предыдущий сценарий"><span aria-hidden="true">←</span></button>
      <div class="vypusknoj-artboard__carousel-dots" role="tablist" aria-label="Сценарии выпускного">
        {(scenarios.items || []).map((item, index) => (
          <button class="vypusknoj-artboard__carousel-dot" type="button" role="tab" data-vypusk-slider-dot aria-controls={`vypusknoj-scenario-${index + 1}`}
                  aria-label={`Показать сценарий ${index + 1}: ${item.title}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}></button>
        ))}
      </div>
      <button class="vypusknoj-artboard__carousel-arrow" type="button" data-vypusk-slider-next aria-label="Следующий сценарий"><span aria-hidden="true">→</span></button>
    </div>
  </section>

  <div class="vypusknoj-artboard__divider" data-parity-record={records.dividerAfterScenarios?.id} style={recordStyle(records.dividerAfterScenarios)} aria-hidden="true"></div>

  <section class="vypusknoj-artboard__carousel vypusknoj-artboard__carousel--additions" data-parity-record={records.additions?.id} style={recordStyle(records.additions)} aria-labelledby="vypusknoj-additions-title"
           data-vypusk-slider data-vypusk-slider-mode="cards" data-vypusk-offset-desktop="-280" data-vypusk-offset-mobile="0" data-vypusk-step-desktop="300" data-vypusk-step-mobile="344">
    <h2 id="vypusknoj-additions-title">{additions.title}</h2>
    <div class="vypusknoj-artboard__carousel-window" data-vypusk-slider-window>
      <div class="vypusknoj-artboard__carousel-track" data-vypusk-slider-track>
        {(additions.items || []).map((item, index) => (
          <article class="vypusknoj-artboard__carousel-card" data-vypusk-slider-slide id={`vypusknoj-addition-${index + 1}`} aria-label={`Дополнение ${index + 1} из ${(additions.items || []).length}`}>
            <a href={bookingHref}><img src={asset(item.src)} alt={item.title} width="700" height="553" loading="lazy" decoding="async" /></a>
            <div>
              <a href={bookingHref}>{item.title}</a>
              <a class="vypusknoj-artboard__carousel-cta" href={bookingHref}>{additions.cta} <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
    <div class="vypusknoj-artboard__carousel-controls" aria-label="Управление дополнительными услугами">
      <button class="vypusknoj-artboard__carousel-arrow" type="button" data-vypusk-slider-prev aria-label="Предыдущая дополнительная услуга"><span aria-hidden="true">←</span></button>
      <div class="vypusknoj-artboard__carousel-dots" role="tablist" aria-label="Дополнительные услуги">
        {(additions.items || []).map((item, index) => (
          <button class="vypusknoj-artboard__carousel-dot" type="button" role="tab" data-vypusk-slider-dot aria-controls={`vypusknoj-addition-${index + 1}`}
                  aria-label={`Показать дополнительную услугу ${index + 1}: ${item.title}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}></button>
        ))}
      </div>
      <button class="vypusknoj-artboard__carousel-arrow" type="button" data-vypusk-slider-next aria-label="Следующая дополнительная услуга"><span aria-hidden="true">→</span></button>
    </div>
  </section>

  <section class="vypusknoj-artboard__hall-heading" data-parity-record={records.hallHeading?.id} style={recordStyle(records.hallHeading)} aria-labelledby="vypusknoj-hall-heading">
    <h2 id="vypusknoj-hall-heading">{hall.heading}</h2>
    <p>{hall.subtitle}</p>
  </section>

  <section class="vypusknoj-artboard__hall" data-parity-record={records.hall?.id} style={recordStyle(records.hall)} aria-labelledby="vypusknoj-hall-title"
           data-vypusk-slider data-vypusk-slider-mode="gallery" data-vypusk-autoplay="3000">
    <div class="vypusknoj-artboard__rail vypusknoj-artboard__hall-canvas">
      <div class="vypusknoj-artboard__hall-images" data-vypusk-slider-window>
        <div class="vypusknoj-artboard__hall-track" data-vypusk-slider-track>
          {(hall.images || []).map((image, index) => (
            <div class:list={['vypusknoj-artboard__hall-slide', { 'is-active': index === 0 }]} data-vypusk-slider-slide id={`vypusknoj-hall-photo-${index + 1}`}
                 aria-hidden={index === 0 ? 'false' : 'true'} inert={index > 0 ? true : undefined}>
              <img src={asset(image)} alt="Зал для выпускного" width="1280" height="960" loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
        <div class="vypusknoj-artboard__hall-dots" role="tablist" aria-label="Фотографии зала">
          {(hall.images || []).map((image, index) => (
            <button class="vypusknoj-artboard__hall-dot" type="button" role="tab" data-vypusk-slider-dot aria-controls={`vypusknoj-hall-photo-${index + 1}`}
                    aria-label={`Показать фотографию зала ${index + 1}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}></button>
          ))}
        </div>
      </div>
      <div class="vypusknoj-artboard__hall-copy">
        <h2 id="vypusknoj-hall-title">{hall.title}</h2>
        <div class="vypusknoj-artboard__hall-details">
          <p class="vypusknoj-artboard__hall-capacity"><strong>Вместимость:</strong> {hall.capacity}<br />{hall.guests}</p>
          <p class="vypusknoj-artboard__hall-format"><strong>Формат:</strong> {hall.format}</p>
          {hall.equipmentTitle && <h3>{hall.equipmentTitle}</h3>}
          {(hall.equipment || []).length > 0 && <ul>{(hall.equipment || []).map((item) => <li>{item}</li>)}</ul>}
        </div>
        {hall.cta && <a class="vypusknoj-artboard__pink-button" href={bookingHref}>{hall.cta}</a>}
        <div class="vypusknoj-artboard__hall-pager" aria-label="Переключение фотографий зала">
          <button type="button" data-vypusk-slider-prev aria-label="Предыдущая фотография зала">{hall.previousIcon ? <img src={asset(hall.previousIcon)} alt="" aria-hidden="true" width="20" height="21" loading="lazy" decoding="async" /> : <span aria-hidden="true">←</span>}</button>
          <span class="vypusknoj-artboard__hall-count" data-vypusk-slider-count aria-live="polite">1 из {(hall.images || []).length}</span>
          <button type="button" data-vypusk-slider-next aria-label="Следующая фотография зала">{hall.nextIcon ? <img src={asset(hall.nextIcon)} alt="" aria-hidden="true" width="20" height="21" loading="lazy" decoding="async" /> : <span aria-hidden="true">→</span>}</button>
        </div>
      </div>
    </div>
  </section>

  <section class="vypusknoj-artboard__section-heading vypusknoj-artboard__section-heading--trust" data-parity-record={records.trustHeading?.id} style={recordStyle(records.trustHeading)} aria-labelledby="vypusknoj-trust-heading">
    <h2 id="vypusknoj-trust-heading">{trust.heading}</h2>
  </section>

  <section class="vypusknoj-artboard__trust" data-parity-record={records.trust?.id} style={`${recordStyle(records.trust)};${bgStyle(trust.background)}`} aria-label="Причины доверить выпускной">
    <div class="vypusknoj-artboard__trust-grid">
      {(trust.cards || []).map((card, index) => (
        <article class:list={['vypusknoj-artboard__trust-card', { 'vypusknoj-artboard__trust-card--note': card.title, 'vypusknoj-artboard__trust-card--mark': index === 1 }]}>
          {card.src && <img src={asset(card.src)} alt="" aria-hidden="true" width="312" height="312" loading="lazy" decoding="async" />}
          {index === 1 && trust.mark && <img class="vypusknoj-artboard__trust-mark" src={asset(trust.mark)} alt="" aria-hidden="true" width="224" height="223" loading="lazy" decoding="async" />}
          {card.prefix && <span class="vypusknoj-artboard__trust-prefix">{card.prefix}</span>}
          {card.value && <strong>{card.value}</strong>}
          {card.title && <h3>{card.title}</h3>}
          <p>{card.text}</p>
        </article>
      ))}
    </div>
  </section>

  <div class="vypusknoj-artboard__masked-review-rail" data-parity-record={records.maskedReviewTop?.id} style={recordStyle(records.maskedReviewTop)} aria-hidden="true"></div>
  <div class="vypusknoj-artboard__masked-review-rail" data-parity-record={records.maskedReviewMiddle?.id} style={recordStyle(records.maskedReviewMiddle)} aria-hidden="true"></div>
  <div class="vypusknoj-artboard__masked-review-rail" data-parity-record={records.maskedReviewBottom?.id} style={recordStyle(records.maskedReviewBottom)} aria-hidden="true"></div>

  <section class="vypusknoj-artboard__gift" data-parity-record={records.gift?.id} style={`${recordStyle(records.gift)};${bgStyle(gift.background)}`} aria-labelledby="vypusknoj-gift-title">
    <div class="vypusknoj-artboard__rail vypusknoj-artboard__gift-canvas">
      <h2 id="vypusknoj-gift-title">{gift.title}</h2>
      <p>{gift.text}</p>
      {gift.cta && <a class="vypusknoj-artboard__pink-button" href={bookingHref}>{gift.cta}</a>}
      {gift.art && <img src={asset(gift.art)} alt="" aria-hidden="true" width="230" height="178" loading="lazy" decoding="async" />}
    </div>
  </section>

  <section class="vypusknoj-artboard__venues-heading" data-parity-record={records.venuesHeading?.id} style={recordStyle(records.venuesHeading)} aria-labelledby="vypusknoj-venues-title">
    <h2 id="vypusknoj-venues-title">{venues.heading}</h2>
    <p>{venues.subtitle}</p>
  </section>

  <section class="vypusknoj-artboard__venues" data-parity-record={records.venues?.id} style={recordStyle(records.venues)} aria-label="Адреса площадок">
    <div class="vypusknoj-artboard__venues-list">
      {(venues.items || []).map((item) => (<a href={href(item.href)}>{item.title}</a>))}
    </div>
  </section>

  <div class="vypusknoj-artboard__footer-spacer" data-parity-record={records.footerSpacer?.id} style={recordStyle(records.footerSpacer)} aria-hidden="true"></div>

  <footer class="vypusknoj-artboard__footer">
    <div class="vypusknoj-artboard__footer-main" data-parity-record={records.footer?.id} style={recordStyle(records.footer)}>
      <div class="vypusknoj-artboard__footer-grid">
        <section><h2>ОРГАНИЗАЦИЯ <span>МЕРОПРИЯТИЙ</span></h2>{(footer.organisation || []).map((item) => (<a href={href(item.href)}>{item.title}</a>))}</section>
        <section><h2>ВИДЫ РАЗВЛЕЧЕНИЙ</h2>{(footer.entertainment || []).map((item) => (<a href={href(item.href)}>{item.title}</a>))}</section>
        <section><h2>НАШИ ПЛОЩАДКИ</h2>{(footer.venues || []).map((item) => (<a href={href(item.href)}>{item.title}</a>))}</section>
        <section class="vypusknoj-artboard__footer-legal">{footer.privacy && <a href={href(footer.privacyHref || '/privacy')}>{footer.privacy}</a>}<p>{(footer.legal || []).map((line) => <span>{line}</span>)}</p></section>
      </div>
    </div>
    <div class="vypusknoj-artboard__footer-bottom" data-parity-record={records.footerBottom?.id} style={recordStyle(records.footerBottom)}>
      <div class="vypusknoj-artboard__footer-brand">
        {footer.logo && <a href={href('/')}><img src={asset(footer.logo)} alt="Чё за Квест" width="125" height="53" loading="lazy" decoding="async" /></a>}
        {footer.copyright && <p>{footer.copyright}</p>}
      </div>
      <div class="vypusknoj-artboard__footer-contact">
        {phone && <a href={phoneHref}>{phone}</a>}
        {footer.hours && <p>{footer.hours}</p>}
        {footer.email && <a href={footer.emailHref || `mailto:${footer.email}`}>{footer.email}</a>}
      </div>
    </div>
  </footer>
</div>

<script>
  import '../scripts/vypusknoj-artboard-controls.js';
</script>

<style is:global>
  .vypusknoj-artboard__booking .pform{display:none}
  .vypusknoj-artboard__booking .pform:target{display:block}
</style>

<style>
  .vypusknoj-artboard{overflow:hidden;background:#031818;color:#fff;font-family:Montserrat,Arial,sans-serif}
  .vypusknoj-artboard a{color:inherit;text-decoration:none}
  .vypusknoj-artboard__rail{position:relative;width:1200px;height:100%;margin-inline:auto}
  .vypusknoj-artboard__spacer{height:var(--vypusknoj-record-desktop,58px);background:#fff}
  .vypusknoj-artboard__hero{height:var(--vypusknoj-record-desktop,856px);overflow:hidden;background-color:#031818;background-repeat:no-repeat;background-position:center -71px;background-size:1920px 941px}
  .vypusknoj-artboard__hero-canvas{position:relative;width:1200px;height:100%;margin:auto}
  .vypusknoj-artboard__hero-layer{position:absolute;z-index:1;top:var(--vyp-layer-top);left:var(--vyp-layer-left);width:var(--vyp-layer-width);height:var(--vyp-layer-height);object-fit:cover;pointer-events:none}
  .vypusknoj-artboard__hero-layer:nth-of-type(3){z-index:2}
  .vypusknoj-artboard__hero-layer:nth-of-type(4){z-index:4}
  .vypusknoj-artboard__hero-logo{position:absolute;z-index:6;top:24px;right:0;width:48px;height:42px;object-fit:contain}
  .vypusknoj-artboard__hero-nav{position:absolute;z-index:7;top:39px;left:310px;display:flex;align-items:center;gap:82px;color:#fff;font:400 16px/1.15 Montserrat,Arial,sans-serif;white-space:nowrap}
  .vypusknoj-artboard__hero-nav a{transition:opacity .2s ease}
  .vypusknoj-artboard__hero-nav a:hover{opacity:.75}
  .vypusknoj-artboard__hero-nav .vypusknoj-artboard__hero-phone{margin-left:30px;font-weight:700;font-size:18px}
  .vypusknoj-artboard__hero-copy{position:absolute;z-index:5;inset:0;pointer-events:none}
  .vypusknoj-artboard__hero-copy > *{position:absolute;margin:0}
  .vypusknoj-artboard__hero-city{top:510px;left:154px;font:400 20px/1.1 Montserrat,Arial,sans-serif;letter-spacing:.02em}
  .vypusknoj-artboard__hero-sub{top:290px;left:186px;font:400 20px/1.1 Montserrat,Arial,sans-serif;letter-spacing:.02em}
  .vypusknoj-artboard__hero-copy h1{top:157px;left:0;width:510px;color:#fff;font:800 70px/.98 Montserrat,Arial,sans-serif;letter-spacing:-.035em}
