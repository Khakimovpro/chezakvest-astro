---
// The source page is a measured black/yellow Tilda composition, not a shared
// holiday-card layout.  Its per-record dimensions stay in the route JSON so
// this renderer remains route-specific and cannot alter other holiday pages.
import site from '../data/site.json';

const { source = {}, page = {}, asset = (value) => value, href = (value) => value } = Astro.props;
const records = source.records || {};
const sections = page.sections || [];
const section = (kind, id = '') => sections.find((item) => item.kind === kind && (!id || item.id === id)) || {};
const hero = section('hero');
const packages = section('packages');
const shows = section('tiles');
const halls = section('halls');
const hall = halls.items?.[0] || {};
const quiz = section('party-form', 'quiz');
const reviews = section('reviews');
const story = section('text');
const features = section('features');
const gallery = section('gallery');
const stats = section('stats');
const alternatives = section('cards');
const booking = section('party-form', 'prazdnik');
const bookingHref = href(source.bookingHref || '#prazdnik');
const sourceVisual = source.visual || {};
const sourceHero = sourceVisual.hero || {};
const sourceHall = sourceVisual.hall || {};
const sourceReviews = sourceVisual.reviews || {};
const sourceStory = sourceVisual.story || {};
const sourceFeatures = sourceVisual.features || {};
const sourceGallery = sourceVisual.gallery || {};
const sourceTrust = sourceVisual.trust || {};
const sourceFooter = sourceVisual.footer || {};
const px = (value) => Number.isFinite(value) ? `${value}px` : String(value || '');
const recordStyle = (record = {}) => [
  record.desktop !== undefined && `--azkaban-record-desktop:${px(record.desktop)}`,
  record.mobile !== undefined && `--azkaban-record-mobile:${px(record.mobile)}`,
].filter(Boolean).join(';');
const backgroundStyle = (desktop, mobile = desktop) => [
  desktop && `--azkaban-background-desktop:url(${asset(desktop)})`,
  mobile && `--azkaban-background-mobile:url(${asset(mobile)})`,
].filter(Boolean).join(';');
const visibleShows = (sourceVisual.shows?.length ? sourceVisual.shows : shows.items || []).map((item, index) => ({
  ...item,
  img: item.img || (index === 6 ? '/assets/static.tildacdn.com/tild3865-3132-4864-a630-326531636333/eee8132230613e0ca1d5.jpg' : ''),
}));
const venueLinks = sourceVisual.venues?.length ? sourceVisual.venues : source.venues || [];
const organisation = sourceFooter.organisation || [
  ['Детский день рождения', '/kids'], ['День рождения в VR', '/den-rozhdeniya-na-vr-arene'],
  ['Выпускной', '/vypusknoj-kalmar'], ['Корпоратив | Тимбилдинг', '/prazdniki-pod-kluch'],
];
const entertainment = sourceFooter.entertainment || [
  ['Квеструмы', '/kvesty-v-rostove-na-donu'], ['VR-арены', '/den-rozhdeniya-na-vr-arene'],
  ['Активные игры', '/party-games'], ['Прятки в темноте', '/pryatki_v_temnote'],
];
---

<div class="azkaban-artboard" data-source-artboard="azkaban">
  <header class="azkaban-artboard__record azkaban-artboard__header" data-parity-record="rec2093762261" style={recordStyle(records.header)}>
    <div class="azkaban-artboard__rail azkaban-artboard__header-inner">
      <a class="azkaban-artboard__brand" href={href('/')} aria-label="Чё за Квест">ЧЁ<br />ЗА КВЕСТ</a>
      <nav aria-label="Основная навигация">
        <a href={href('/kvesty-v-rostove-na-donu')}>Квесты</a>
        <a href={href('/kids')}>Праздники</a>
        <a href={href('/strashnye-kvesty')}>Хоррор</a>
        <a href={href('/contacts')}>Контакты</a>
      </nav>
      <a class="azkaban-artboard__header-phone" href={site.header.phoneHref}>{site.header.phone}</a>
    </div>
  </header>

  <section class="azkaban-artboard__record azkaban-artboard__hero" data-parity-record="rec2144896401" style={`${recordStyle(records.hero)};${backgroundStyle(hero.bg, hero.bgset?.['760'])}`} aria-labelledby="azkaban-hero-title">
    <div class="azkaban-artboard__hero-shade"></div>
    <div class="azkaban-artboard__rail azkaban-artboard__hero-copy">
      <p class="azkaban-artboard__hero-title" data-source-layer="hero-title"><mark>{sourceHero.title?.[0] || 'ДЕТСКИЙ ПРАЗДНИК'}</mark> <span>{sourceHero.title?.[1] || 'в стиле Узник Азкабана'}</span></p>
      <h1 id="azkaban-hero-title">{sourceHero.summary || hero.h1 || page.seo?.h1}</h1>
      <p class="azkaban-artboard__hero-sub">{hero.sub}</p>
      <div class="azkaban-artboard__hero-actions">
        {(hero.buttons || []).map((button, index) => <a class:list={['azkaban-artboard__button', { 'azkaban-artboard__button--outline': index !== 0 }]} href={href(button.href)}>{button.t}</a>)}
      </div>
      <div class="azkaban-artboard__pills">{(sourceHero.facts || hero.pills || []).map((pill) => <span>{pill}</span>)}</div>
    </div>
  </section>

  <nav class="azkaban-artboard__record azkaban-artboard__breadcrumbs" data-parity-record="rec2093762281" style={recordStyle(records.breadcrumbs)} aria-label="Хлебные крошки">
    <div class="azkaban-artboard__rail"><a href={href('/')}>Главная</a><span>/</span><a href={href('/kids')}>Все праздники</a><span>/</span><b>День рождения в стиле Узник Азкабана</b></div>
  </nav>
  <div class="azkaban-artboard__record azkaban-artboard__bread-gap" data-parity-record="rec2093762291" style={recordStyle(records.breadcrumbSpacer)} aria-hidden="true"></div>

  <section class="azkaban-artboard__record azkaban-artboard__heading azkaban-artboard__packages-heading" data-parity-record="rec2094236451" style={recordStyle(records.packagesHeading)} aria-labelledby="azkaban-packages-title">
    <div class="azkaban-artboard__rail"><h2 id="azkaban-packages-title"><mark>Выберите пакет</mark> праздника</h2><p>Отправьте заявку и наш менеджер уточнит свободную дату и время</p></div>
  </section>
  <section class="azkaban-artboard__record azkaban-artboard__packages" data-parity-record="rec2094236461" style={recordStyle(records.packages)} id="pakety" aria-label="Пакеты праздника">
    <div class="azkaban-artboard__rail azkaban-artboard__package-grid">
      {(source.packages || []).map((item) => <a href={bookingHref} class="azkaban-artboard__package" data-source-layer="source-package-card"><img src={asset(item.src)} alt={`${item.title}, пакет праздника`} width="368" height="381" loading="lazy" decoding="async" /><span>{item.title}</span></a>)}
    </div>
    <a class="azkaban-artboard__button azkaban-artboard__packages-cta" href={bookingHref}>{packages.cta || 'Узнать стоимость'}</a>
  </section>

  <section class="azkaban-artboard__record azkaban-artboard__heading azkaban-artboard__shows-heading" data-parity-record="rec2094236471" style={recordStyle(records.showsHeading)} aria-labelledby="azkaban-shows-title">
    <div class="azkaban-artboard__rail"><h2 id="azkaban-shows-title">Увлекательная <mark>шоу-программа</mark> -<br />неотъемлемая часть яркого праздника</h2><p>Подберите ту, что порадует именно вашего ребенка</p></div>
  </section>
  <section class="azkaban-artboard__record azkaban-artboard__shows" data-parity-record="rec2094236481" style={recordStyle(records.shows)} aria-label="Шоу-программы">
    <div class="azkaban-artboard__rail azkaban-artboard__show-grid">
      {visibleShows.map((item) => <a href={bookingHref} class="azkaban-artboard__show-card"><img src={asset(item.img)} alt={item.t} width="280" height="240" loading="lazy" decoding="async" /><span>{item.t}</span><b>Добавить в праздник</b></a>)}
    </div>
  </section>

  <section class="azkaban-artboard__record azkaban-artboard__heading azkaban-artboard__hall-heading" data-parity-record="rec2093762411" style={recordStyle(records.hallHeading)} aria-labelledby="azkaban-hall-title">
    <div class="azkaban-artboard__rail"><h2 id="azkaban-hall-title">Нужен <mark>банкетный зал?</mark><br />У нас есть комната на 12 человек</h2><p>После игры дети сразу переходят в комнату отдыха - удобно, без переездов и лишней суеты.</p></div>
  </section>
  <section class="azkaban-artboard__record azkaban-artboard__hall" data-parity-record="rec2097266521" style={`${recordStyle(records.hall)};${backgroundStyle(sourceHall.image || hall.img)}`} aria-labelledby="azkaban-hall-copy-title">
    <div class="azkaban-artboard__rail">
      <div class="azkaban-artboard__hall-image" aria-hidden="true"></div>
      <div class="azkaban-artboard__hall-copy"><h3 id="azkaban-hall-copy-title">{sourceHall.title || hall.t}</h3><ul>{(sourceHall.equipment || hall.equipment || []).map((item) => <li>{item}</li>)}</ul><a class="azkaban-artboard__button" href={bookingHref}>{halls.cta || 'Узнать свободную дату'}</a></div>
    </div>
  </section>

  <section class="azkaban-artboard__record azkaban-artboard__quiz-heading" data-parity-record="rec2094236511" style={recordStyle(records.quizHeading)} aria-labelledby="azkaban-quiz-title">
    <div class="azkaban-artboard__rail"><h2 id="azkaban-quiz-title">Поможем подобрать<br /><mark>праздничную программу</mark></h2><p>{quiz.subtitle}</p></div>
  </section>
  <section class="azkaban-artboard__record azkaban-artboard__quiz" data-parity-record="rec2094236521" style={recordStyle(records.quiz)} id="quiz" aria-label="Заявка на подбор программы">
    <form data-lead-form data-lead-kind="party" data-lead-target={site.header.wa} data-lead-recipient={site.leads?.recipient || ''} class="azkaban-artboard__lead-form" aria-describedby="azkaban-quiz-status">
      <p>Расскажите о празднике — пришлём подходящие варианты и стоимость.</p>
      <div class="azkaban-artboard__form-grid"><label for="azkaban-quiz-name">Ваше имя<input id="azkaban-quiz-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="80" required /></label><label for="azkaban-quiz-phone">Телефон<input id="azkaban-quiz-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="24" required /></label><label for="azkaban-quiz-date">Желаемая дата<input id="azkaban-quiz-date" name="date" type="date" /></label></div>
      <label class="azkaban-artboard__consent"><input name="consent" type="checkbox" required />Соглашаюсь с <a href={href('/privacy')}>политикой обработки данных</a></label>
      <button class="azkaban-artboard__button" type="button" data-lead-submit>{quiz.cta || 'Узнать стоимость'}</button><p class="lead-form__status" id="azkaban-quiz-status" data-lead-status role="status" aria-live="polite" hidden></p>
    </form>
  </section>

  <div class="azkaban-artboard__record azkaban-artboard__divider" style={recordStyle(records.dividerBeforeReviews)} aria-hidden="true"></div>
  <section class="azkaban-artboard__record azkaban-artboard__reviews-heading" data-parity-record="rec2097359081" style={recordStyle(records.reviewsHeading)} aria-labelledby="azkaban-reviews-title"><div class="azkaban-artboard__rail"><h2 id="azkaban-reviews-title">Честные <mark>отзывы наших гостей</mark><br />и их родителей</h2><div class="azkaban-artboard__review-badges">{(sourceReviews.badges || []).map((image) => <img src={asset(image)} alt="" width="75" height="127" loading="lazy" decoding="async" />)}</div></div></section>
  <div class="azkaban-artboard__record azkaban-artboard__divider" style={recordStyle(records.dividerAfterReviews)} aria-hidden="true"></div>

  <section class="azkaban-artboard__record azkaban-artboard__story" data-parity-record="rec2093762301" style={recordStyle(records.story)} aria-labelledby="azkaban-story-title"><div class="azkaban-artboard__rail azkaban-artboard__story-grid"><div class="azkaban-artboard__story-lead"><h2 id="azkaban-story-title">О квесте <mark>"Узник Азкабана"</mark></h2>{(story.lines || []).slice(0, 2).map((line) => <p>{line}</p>)}</div><div class="azkaban-artboard__story-copy">{(story.lines || []).slice(2).map((line) => <p>{line}</p>)}<p class="azkaban-artboard__story-features-title">Особенности:</p><ul>{(sourceStory.features || []).map((item) => <li>{item}</li>)}</ul></div></div></section>
  <section class="azkaban-artboard__record azkaban-artboard__features" data-parity-record="rec2145126211" style={recordStyle(records.features)} aria-labelledby="azkaban-features-title"><div class="azkaban-artboard__rail"><h2 id="azkaban-features-title">Спокойно родителям, <mark>интересно детям</mark></h2><p class="azkaban-artboard__features-sub">Безопасно, актуально у детей, и организация праздника “без суеты”. За детьми следит инструктор, а программа адаптируется под возраст гостей.</p><div class="azkaban-artboard__feature-grid">{(features.items || []).map((item, index) => <article><img src={asset(sourceFeatures.icons?.[index])} alt="" width="80" height="80" data-source-layer="feature-icon" loading="lazy" decoding="async" /><h3>{item.t}</h3><p>{item.sub}</p></article>)}</div></div></section>

  <div class="azkaban-artboard__record azkaban-artboard__divider" style={recordStyle(records.dividerBeforeGallery)} aria-hidden="true"></div>
  <section class="azkaban-artboard__record azkaban-artboard__gallery-heading" data-parity-record="rec2093762441" style={recordStyle(records.galleryHeading)} aria-labelledby="azkaban-gallery-title"><div class="azkaban-artboard__rail"><h2 id="azkaban-gallery-title">{gallery.title}</h2></div></section>
  <section class="azkaban-artboard__record azkaban-artboard__gallery" data-parity-record="rec2093762451" style={recordStyle(records.gallery)} aria-label="Фотографии с квеста"><div class="azkaban-artboard__rail azkaban-artboard__gallery-grid"><img src={asset(sourceGallery.image || gallery.photos?.[1])} alt="Фотография с квеста" width="613" height="463" loading="lazy" decoding="async" /></div></section>
  <div class="azkaban-artboard__record azkaban-artboard__divider" style={recordStyle(records.dividerAfterGallery)} aria-hidden="true"></div>

  <section class="azkaban-artboard__record azkaban-artboard__trust-heading" data-parity-record="rec2094236411" style={recordStyle(records.trustHeading)} aria-labelledby="azkaban-trust-title"><div class="azkaban-artboard__rail"><h2 id="azkaban-trust-title">Причины <mark>доверить нам</mark> организацию вашего праздника</h2></div></section>
  <section class="azkaban-artboard__record azkaban-artboard__trust" data-parity-record="rec2094236421" style={recordStyle(records.trust)} aria-label="Причины доверить праздник"><div class="azkaban-artboard__rail azkaban-artboard__trust-grid" data-source-layer="trust-mosaic"><article class="azkaban-artboard__trust-stat"><p>{stats.items?.[0]?.up}</p><b>{stats.items?.[0]?.n}</b><h3>{stats.items?.[0]?.sub}</h3></article><article class="azkaban-artboard__trust-icon"><img src={asset(sourceTrust.icon)} alt="" width="201" height="200" loading="lazy" decoding="async" /></article><article class="azkaban-artboard__trust-stat"><p>{stats.items?.[1]?.up}</p><b>{stats.items?.[1]?.n}</b><h3>{stats.items?.[1]?.sub}</h3></article><article class="azkaban-artboard__trust-stat"><p>{stats.items?.[2]?.up}</p><b>{stats.items?.[2]?.n}</b><h3>{stats.items?.[2]?.sub}</h3></article><img class="azkaban-artboard__trust-photo" src={asset(sourceTrust.leftImage)} alt="" width="260" height="260" loading="lazy" decoding="async" />{(stats.notes || []).map((item) => <article class="azkaban-artboard__trust-note"><h3>{item.t}</h3><p>{item.sub}</p></article>)}<img class="azkaban-artboard__trust-photo" src={asset(sourceTrust.rightImage)} alt="" width="260" height="260" loading="lazy" decoding="async" /></div></section>

  <div class="azkaban-artboard__record azkaban-artboard__divider" style={recordStyle(records.dividerBeforeAlternatives)} aria-hidden="true"></div>
  <section class="azkaban-artboard__record azkaban-artboard__alternatives" data-parity-record="rec2146068921" style={recordStyle(records.alternatives)} aria-labelledby="azkaban-alternatives-title"><div class="azkaban-artboard__rail"><h2 id="azkaban-alternatives-title"><mark>Альтернативные сценарии</mark> для вашего праздника</h2><p class="azkaban-artboard__alternatives-sub">Вашему ребенку точно понравится такой День рождения!</p><div class="azkaban-artboard__alternative-grid">{(alternatives.items || []).map((item) => <a href={href(item.href)}><img src={asset(item.img)} alt={item.t} width="360" height="360" loading="lazy" decoding="async" /><span><small>День рождения в стиле</small>{item.t}</span></a>)}</div></div></section>

  <div class="azkaban-artboard__record azkaban-artboard__divider" style={recordStyle(records.dividerBeforeBooking)} aria-hidden="true"></div>
  <section class="azkaban-artboard__record azkaban-artboard__booking" data-parity-record="rec2097407391" style={`${recordStyle(records.booking)};${backgroundStyle(sourceVisual.booking?.background)}`} id="prazdnik" aria-labelledby="azkaban-booking-title">{(sourceVisual.booking?.decorations || []).map((image, index) => <img class:list={['azkaban-artboard__booking-decoration', `azkaban-artboard__booking-decoration--${index + 1}`]} data-source-layer="booking-decoration" src={asset(image)} alt="" width="121" height="121" loading="lazy" decoding="async" />)}<div class="azkaban-artboard__rail"><form data-lead-form data-lead-kind="party" data-lead-target={site.header.wa} data-lead-recipient={site.leads?.recipient || ''} class="azkaban-artboard__lead-form azkaban-artboard__lead-form--booking" aria-describedby="azkaban-booking-status"><div><h2 id="azkaban-booking-title">Забронируйте праздник - мы предложим варианты по дате и времени</h2><p>{booking.subtitle}</p></div><div class="azkaban-artboard__form-grid"><label for="azkaban-booking-name">Ваше имя<input id="azkaban-booking-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="80" required /></label><label for="azkaban-booking-phone">Телефон<input id="azkaban-booking-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="24" required /></label><label for="azkaban-booking-date">Дата праздника<input id="azkaban-booking-date" name="date" type="date" /></label><label class="azkaban-artboard__consent"><input name="consent" type="checkbox" required />Даю согласие на обработку моих персональных данных в соответствии с <a href={href('/privacy')}>Политикой обработки персональных данных</a></label><button class="azkaban-artboard__button" type="button" data-lead-submit>{booking.cta || 'Отправить заявку'}</button><p class="lead-form__status" id="azkaban-booking-status" data-lead-status role="status" aria-live="polite" hidden></p></div></form></div></section>
  <div class="azkaban-artboard__record azkaban-artboard__divider" style={recordStyle(records.dividerAfterBooking)} aria-hidden="true"></div>

  <section class="azkaban-artboard__record azkaban-artboard__venues-heading" data-parity-record="rec2145881791" style={recordStyle(records.venuesHeading)} aria-labelledby="azkaban-venues-title"><div class="azkaban-artboard__rail"><h2 id="azkaban-venues-title">Наши площадки</h2><p>9 современно оборудованных площадок с квест-комнатами и зонами отдыха в Ростове-на-Дону</p></div></section>
  <section class="azkaban-artboard__record azkaban-artboard__venues" data-parity-record="rec2145881801" style={recordStyle(records.venues)} aria-label="Адреса площадок"><div class="azkaban-artboard__rail">{venueLinks.map((item) => <a href={href(item.href)}>{item.title}</a>)}</div></section>
  <div class="azkaban-artboard__record azkaban-artboard__footer-spacer" data-parity-record="rec2145881911" style={recordStyle(records.footerSpacer)} aria-hidden="true"></div>

  <footer class="azkaban-artboard__record azkaban-artboard__footer" data-parity-record="rec2145881921" style={recordStyle(records.footer)}><div class="azkaban-artboard__rail azkaban-artboard__footer-grid"><section><h2>ОРГАНИЗАЦИЯ МЕРОПРИЯТИЙ</h2>{organisation.map(([title, itemHref]) => <a href={href(itemHref)}>{title}</a>)}</section><section><h2>ВИДЫ РАЗВЛЕЧЕНИЙ</h2>{entertainment.map(([title, itemHref]) => <a href={href(itemHref)}>{title}</a>)}</section><section><h2>НАШИ ПЛОЩАДКИ</h2>{venueLinks.map((item) => <a href={href(item.href)}>{item.title}</a>)}</section><section><a class="azkaban-artboard__footer-phone" href={site.header.phoneHref}>{site.header.phone}</a><p>Работаем с 10:00 до 23:30</p><p>ИП Мелешкин Юрий Иванович<br />ИНН 164409771610<br />ОГРНИП 322169000094990</p><a href={href('/privacy')}>Политика обработки персональных данных</a></section></div></footer>
  <div class="azkaban-artboard__record azkaban-artboard__copyright" data-parity-record="rec2145881931" style={recordStyle(records.copyright)}><div class="azkaban-artboard__rail"><a href={href('/')}>ЧЁ ЗА КВЕСТ</a><span>© 2026 ЧЁ ЗА КВЕСТ. Все права защищены.</span></div></div>
</div>

<script>
  import '../scripts/lead-form.js';
