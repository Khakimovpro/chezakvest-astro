---
import Header from './Header.astro';
import MessengerFab from './MessengerFab.astro';
import '../styles/page.css';
// Локальные надстройки поверх снимка: раскладка телефонной маски и виджеты,
// которых нет в санированном HTML Tilda.
import '../styles/source-phonemask.css';

const { snapshot } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');
const asset = (path) => `${base}${path}`;
const localSourceForm = /(<form\b(?=[^>]*\bdata-local-source-form(?:\s|=|>))[^>]*>)([\s\S]*?<\/form>)/giu;
const disableLocalFormControls = (form) => form.replace(/<(input|textarea|select|button)\b[^>]*>/giu, (tag) => (
  /\bdisabled(?:\s|=|>|$)/iu.test(tag) ? tag : tag.replace(/\s*\/?>$/u, (end) => ` disabled${end}`)
));
// Часть ссылок в снятых снапшотах осталась без плейсхолдера __SITE_BASE__: 249 в css-url,
// 130 в data-original и 35 в src. На боевом домене base пустой и они рабочие, а на превью
// с базой /chezakvest-preview такие пути уходят мимо сайта и картинка не грузится.
// Дописываем базу тем, что начинается ровно с /assets/ — уже переписанные ссылки идут
// с базой впереди и под шаблон не попадают.
const withBase = (input) => (base ? input.replace(/(["'(])\/assets\//gu, `$1${base}/assets/`) : input);
// Пустые <img> без источника — наследство Tilda: там элемент есть, а картинку в конструкторе
// не задали. Без Tilda-рантайма браузер рисует на их месте значок битой картинки,
// поэтому подставляем прозрачный пиксель, сохраняя размеры элемента.
const PIXEL = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
const fillEmptyImages = (input) => input.replace(/<img\b[^>]*>/giu, (tag) => (
  /\s(?:src|data-original|data-src)\s*=/iu.test(tag) ? tag : tag.replace(/\s*(\/?)>$/u, ` src="${PIXEL}" aria-hidden="true"$1>`)
));
// Archived Tilda forms are intentionally handled by the local runtime below.
// A no-JS browser must not submit their PII to the current page: controls are
// inert in static HTML and enabled only after the local submit handler is ready.
const html = fillEmptyImages(withBase(snapshot.html
  .replaceAll('__SITE_BASE__', base)))
  .replace(localSourceForm, (_form, openTag, contents) => {
    const safeOpenTag = openTag
      .replace(/\saction\s*=\s*(["'])[^"']*\1/giu, '')
      .replace(/>$/u, ' data-local-form-pending>');
    return `${safeOpenTag}${disableLocalFormControls(contents)}`;
  });
---

<Header />
<main
  class="source-snapshot-shell"
  data-source-site-base={base}
  data-source-route={snapshot.route}
  style={`--source-flags-url:url(${asset('/assets/static.tildacdn.com/lib/flags/flags7.png')});--source-dark-background-url:url(${asset('/assets/optim.tildacdn.com/tild6333-3137-4862-b434-326332663966/-/format/webp/_GPT_dark.jpg.webp')})`}
  aria-label="Содержимое страницы"
  aria-busy="true"
>
  <div class="source-snapshot-content" set:html={html} />
</main>

<noscript><style>.source-snapshot-shell { display: block !important; visibility: visible !important; }</style></noscript>

<MessengerFab />

<script>
  // Поведение, которое на оригинале давали inline-скрипты страницы Tilda:
  // наведение на карточку квеста и локальные виджеты на месте сторонних.
  import { initCardHover } from '../scripts/source-card-hover.js';
  import { initSourceLiveLayer } from '../scripts/source-live-layer.js';
  import { initSourceWidgets } from '../scripts/source-widgets.js';

  initCardHover();
  initSourceWidgets();
  const shell = document.querySelector('.source-snapshot-shell');
  const initialiseLiveLayer = () => initSourceLiveLayer(shell?.querySelector('[data-source-snapshot]'));
  if (shell?.hasAttribute('aria-busy')) {
    new MutationObserver(() => {
      if (!shell.hasAttribute('aria-busy')) initialiseLiveLayer();
    }).observe(shell, { attributes: true, attributeFilter: ['aria-busy'] });
  } else {
    initialiseLiveLayer();
  }
</script>

<section class="source-booking" id="source-booking" aria-labelledby="source-booking-title">
  <a class="source-booking__backdrop" href="#" aria-label="Закрыть форму"></a>
  <form class="source-booking__dialog" data-local-source-form data-local-form-pending>
    <a class="source-booking__close" href="#" aria-label="Закрыть форму">×</a>
    <h2 id="source-booking-title">Забронировать игру</h2>
    <label>Имя<input name="name" autocomplete="name" required disabled /></label>
    <label>Телефон<input name="phone" type="tel" autocomplete="tel" required disabled /></label>
    <label class="source-booking__consent"><input name="consent" type="checkbox" required disabled /> Я согласен на обработку персональных данных</label>
    <button type="submit" disabled>Отправить заявку</button>
    <p class="source-booking__success" data-local-form-success hidden role="status">Спасибо! Заявка принята.</p>
  </form>
</section>

<script is:inline>
  (() => {
    const snapshotRoot = document.querySelector('[data-source-snapshot]');
    if (!(snapshotRoot instanceof HTMLElement)) return;
    const snapshotShell = snapshotRoot.closest('.source-snapshot-shell');

    // Ленивая загрузка <img> живёт в самом HTML снимка: пока рантайм доберётся до
    // атрибута, парсер уже встретил тег и браузер начал качать файл, а снятый и
    // возвращённый src запрос не отменяет. Поэтому здесь loading не трогаем вовсе.

    // Фоновые картинки Tilda назначает своим рантаймом, значит назначаем сами —
    // по подходу к экрану, с запасом в пол-экрана.
    const loadedBackgrounds = new WeakSet();
    const applyBackgroundImage = (element) => {
      if (loadedBackgrounds.has(element)) return;
      loadedBackgrounds.add(element);
      const source = element.dataset.original;
      if (source && !element.style.backgroundImage) element.style.backgroundImage = `url("${source}")`;
      element.classList.add('loaded');
    };
    const backgroundObserver = typeof IntersectionObserver === 'function'
      ? new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting || !(entry.target instanceof HTMLElement)) return;
          observer.unobserve(entry.target);
          applyBackgroundImage(entry.target);
        });
      }, { rootMargin: '300px 0px' })
      : null;
    const observedBackgrounds = new WeakSet();
    // Пока снимок скрыт, прямоугольника у элемента нет и близость к экрану измерить
    // нечем — тогда фон уходит наблюдателю. После display:block раскладка считается
    // заново, и первый экран получает фон сразу, без ожидания кадра наблюдателя.
    const nearViewport = (element) => {
      const box = element.getBoundingClientRect();
      if (box.width <= 0 && box.height <= 0) return false;
      return box.top < window.innerHeight + 600 && box.bottom > -600;
    };
    const deferBackgroundImage = (element) => {
      if (loadedBackgrounds.has(element)) return;
      if (!backgroundObserver || nearViewport(element)) {
        applyBackgroundImage(element);
        return;
      }
      if (observedBackgrounds.has(element)) return;
      observedBackgrounds.add(element);
      backgroundObserver.observe(element);
    };

    const numeric = (value, fallback = 0) => {
      const parsed = Number.parseFloat(String(value ?? ''));
      return Number.isFinite(parsed) ? parsed : fallback;
    };
    const responsiveAttribute = (element, prefix) => {
      let value = element.getAttribute(`data-${prefix}-value`);
      for (const [maximum, suffix] of [[1199, 960], [959, 640], [639, 480], [479, 320]]) {
        if (window.innerWidth <= maximum) {
          value = element.getAttribute(`data-${prefix}-res-${suffix}-value`) ?? value;
        }
      }
      return value;
    };
    const artboardAttribute = (artboard, name) => {
      let value = artboard.getAttribute(`data-artboard-${name}`);
      for (const [maximum, suffix] of [[1199, 960], [959, 640], [639, 480], [479, 320]]) {
        if (window.innerWidth <= maximum) {
          value = artboard.getAttribute(`data-artboard-${name}-res-${suffix}`) ?? value;
        }
      }
      return value;
    };
    const artboardWidth = () => {
      if (window.innerWidth >= 1200) return 1200;
      if (window.innerWidth >= 960) return 960;
      if (window.innerWidth >= 640) return 640;
      if (window.innerWidth >= 480) return 480;
      return 320;
    };
    const elementGeometry = (element) => ({
      width: numeric(responsiveAttribute(element, 'field-width')),
      height: numeric(responsiveAttribute(element, 'field-height')),
      left: numeric(responsiveAttribute(element, 'field-left')),
      top: numeric(responsiveAttribute(element, 'field-top')),
      axisX: responsiveAttribute(element, 'field-axisx') || 'left',
      axisY: responsiveAttribute(element, 'field-axisy') || 'top',
      widthUnits: responsiveAttribute(element, 'field-widthunits') || 'px',
      heightUnits: responsiveAttribute(element, 'field-heightunits') || 'px',
    });
    // Размер элемента Zero Block бывает записан в процентах: тёмная плашка над
    // подвалом на / и /kids/ — это ширина «100 %» от сетки брейкпоинта. Пока
    // единицы игнорировались, из 100 % получалось 100 px, и от полосы во всю
    // ширину оставался обрубок со скруглением у левого края.
    const applyPercentUnits = (geometry, boundary, artboardHeight) => {
      if (geometry.widthUnits === '%' && boundary > 0) geometry.width = boundary * geometry.width / 100;
      if (geometry.heightUnits === '%' && artboardHeight > 0) geometry.height = artboardHeight * geometry.height / 100;
      return geometry;
    };
    const axisPosition = (axis, offset, size, boundary) => {
      if (axis === 'center') return boundary / 2 + offset - size / 2;
      if (axis === 'right') return boundary - offset - size;
      return offset;
    };
    const roundRobloxT396LineHeight = (element) => {
      if (snapshotRoot.dataset.sourceRoute !== '/roblox-land/' || element.dataset.elemType !== 'text') return;
      const atom = element.querySelector(':scope > .tn-atom');
      if (!(atom instanceof HTMLElement)) return;
      const lineHeight = Number.parseFloat(window.getComputedStyle(atom).lineHeight);
      if (Number.isFinite(lineHeight) && lineHeight > 0) atom.style.lineHeight = `${Math.round(lineHeight)}px`;
    };

    // Появление блоков Tilda включает своим скриптом при прокрутке: до этого
    // элементы висят с opacity:0 (класс t396__elem--anim-hidden) или в стартовом
    // сдвиге (.t-animate без t-animate_started). Скрипта нет, поэтому сразу
    // переводим их в то же конечное состояние, к которому приходит оригинал.
    // Именно классы, а не глобальный запрет анимаций: собственные переходы,
    // :hover и декоративные анимации снимка после этого остаются живыми.
    const settleSourceAnimations = () => {
      snapshotRoot.querySelectorAll('.t396__elem--anim-hidden').forEach((element) => {
        element.classList.remove('t396__elem--anim-hidden');
      });
      snapshotRoot.querySelectorAll('.t-animate:not(.t-animate_started)').forEach((element) => {
        element.classList.add('t-animate_started');
      });
    };

    const restoreRobloxRecordStacking = () => {
      if (snapshotRoot.dataset.sourceRoute !== '/roblox-land/') return;
      snapshotRoot.querySelectorAll('#allrecords > [id^="rec"]').forEach((record) => {
        if (!(record instanceof HTMLElement)) return;
        record.style.position = 'relative';
        record.style.setProperty('--zoom', '1');
      });
      snapshotRoot.querySelectorAll('#allrecords > [data-record-type="796"]').forEach((divider) => {
        if (!(divider instanceof HTMLElement)) return;
        const border = divider.querySelector(':scope .t796__shape-border');
        if (!(border instanceof HTMLElement)) return;
        const target = border.classList.contains('t796__shape-border_top')
          ? divider.nextElementSibling
          : divider.previousElementSibling;
        if (!(target instanceof HTMLElement)) return;
        target.append(border);
        border.style.display = 'block';
        border.style.zIndex = '99';
      });
    };

    const layoutWindowArtboards = () => {
      const baseWidth = artboardWidth();
      const scale = window.innerWidth / baseWidth;
      snapshotRoot.querySelectorAll('.t396__artboard').forEach((artboard) => {
        if (!(artboard instanceof HTMLElement)) return;
        const upscale = artboardAttribute(artboard, 'upscale');
        // Zero Block всегда центрирует сетку своего брейкпоинта: в исходном CSS
        // позиции записаны как calc(50% - 600px + left), то есть сетка 1200.
        // Снимок главной снят на ширине 1280, и запечённые в нём inline-left
        // (60/460/860) когда-то приняли за эталон — отсюда была сетка 1360 для
        // записей T121 и сдвиг карточек каталога на 80 px влево на 1440.
        const gridOffset = upscale === 'window' ? 0 : (window.innerWidth - baseWidth) / 2;
        const artboardHeight = numeric(artboardAttribute(artboard, 'height'));
        artboard.querySelectorAll(':scope > .t396__group').forEach((group) => {
          if (!(group instanceof HTMLElement)) return;
          const groupLeft = numeric(responsiveAttribute(group, 'group-left'));
          const groupTop = numeric(responsiveAttribute(group, 'group-top'));
          group.style.left = `${gridOffset + groupLeft}px`;
          group.style.top = `${groupTop}px`;
          group.style.zoom = upscale === 'window' ? String(scale) : '';
          group.querySelectorAll('.t396__elem').forEach((element) => {
            if (!(element instanceof HTMLElement)) return;
            const geometry = elementGeometry(element);
            applyPercentUnits(geometry, baseWidth, artboardHeight);
            element.style.left = `${geometry.left - groupLeft}px`;
            element.style.top = `${geometry.top - groupTop}px`;
            element.style.width = `${geometry.width}px`;
            element.style.height = geometry.height > 0
              && responsiveAttribute(element, 'field-textfit') !== 'autoheight'
              ? `${geometry.height}px`
              : 'auto';
            roundRobloxT396LineHeight(element);
          });
        });
        if (upscale !== 'window') {
          artboard.classList.remove('t396__artboard_scale');
          artboard.style.removeProperty('height');
          for (const layer of artboard.querySelectorAll(':scope > .t396__carrier, :scope > .t396__filter')) {
            if (layer instanceof HTMLElement) layer.style.removeProperty('height');
          }
          artboard.querySelectorAll(':scope > .t396__elem').forEach((element) => {
            if (!(element instanceof HTMLElement)) return;
            const geometry = elementGeometry(element);
            const container = responsiveAttribute(element, 'field-container') || 'grid';
            const boundary = container === 'window' ? window.innerWidth : baseWidth;
            applyPercentUnits(geometry, boundary, artboardHeight);
            const offset = container === 'window' ? 0 : gridOffset;
            const heightMode = responsiveAttribute(element, 'field-heightmode');
            element.style.width = `${geometry.width}px`;
            element.style.height = geometry.height > 0
              && responsiveAttribute(element, 'field-textfit') !== 'autoheight'
              && heightMode !== 'hug'
              ? `${geometry.height}px`
              : 'auto';
            element.style.left = `${offset + axisPosition(geometry.axisX, geometry.left, geometry.width, boundary)}px`;
            element.style.top = `${axisPosition(geometry.axisY, geometry.top, geometry.height, artboardHeight)}px`;
            element.style.zoom = '';
            element.style.removeProperty('--zoom');
            roundRobloxT396LineHeight(element);
          });
          return;
        }
        const height = artboardHeight;
        artboard.classList.add('rendered', 't396__artboard_scale');
        artboard.style.setProperty('height', `${height * scale}px`, 'important');
        for (const layer of artboard.querySelectorAll(':scope > .t396__carrier, :scope > .t396__filter')) {
          if (layer instanceof HTMLElement) layer.style.setProperty('height', `${height * scale}px`, 'important');
        }
        artboard.querySelectorAll(':scope > .t396__elem').forEach((element) => {
          if (!(element instanceof HTMLElement)) return;
          const geometry = elementGeometry(element);
          applyPercentUnits(geometry, baseWidth, height);
          const heightMode = responsiveAttribute(element, 'field-heightmode');
          element.style.width = `${geometry.width}px`;
          if (geometry.height > 0
              && responsiveAttribute(element, 'field-textfit') !== 'autoheight'
              && heightMode !== 'hug') {
            element.style.height = `${geometry.height}px`;
          } else {
            element.style.height = 'auto';
          }
          element.style.left = `${axisPosition(geometry.axisX, geometry.left, geometry.width, baseWidth)}px`;
          element.style.top = `${axisPosition(geometry.axisY, geometry.top, geometry.height, height)}px`;
          element.style.zoom = String(scale);
          element.style.setProperty('--zoom', String(scale));
          roundRobloxT396LineHeight(element);
        });
      });
    };

    // Local reviews replace a third-party iframe, whose captured T396 slot can
    // retain the desktop width even after the artboard runtime selects a smaller
    // breakpoint. Keep the replacement inside the visible canvas; the original
    // slot geometry is still used unchanged at desktop widths.
    const layoutSourceReviews = () => {
      snapshotRoot.querySelectorAll('.source-reviews-slot').forEach((slot) => {
        if (!(slot instanceof HTMLElement)) return;
        const frame = slot.querySelector('.source-reviews-frame');
        const host = slot.querySelector('.source-reviews-host');
        if (window.innerWidth >= 1200) {
          slot.style.removeProperty('display');
          if (frame instanceof HTMLElement) frame.style.removeProperty('width');
          if (frame instanceof HTMLElement) frame.style.removeProperty('display');
          if (host instanceof HTMLElement) host.style.removeProperty('width');
          return;
        }
        slot.style.setProperty('display', 'block', 'important');
        slot.style.setProperty('left', '16px', 'important');
        slot.style.setProperty('width', 'calc(100vw - 32px)', 'important');
        if (frame instanceof HTMLElement) {
          frame.style.setProperty('display', 'block', 'important');
          frame.style.setProperty('width', '100%', 'important');
        }
        if (host instanceof HTMLElement) host.style.setProperty('width', '100%', 'important');
      });
    };

    const mediaReady = async (scope) => {
      const images = [...scope.querySelectorAll('img')];
      await Promise.all(images.map(async (image) => {
        // decode() у ленивой картинки запускает загрузку и подвешивает ожидание,
        // поэтому раскладка ждёт только те, что грузятся сразу; до остальных
        // посетитель ещё не долистал. Их размеры берутся из атрибутов width/height
        // снимка, так что высоты рядов и колонок считаются без ожидания файлов.
        if (image.complete || image.loading === 'lazy') return;
        try { await image.decode(); } catch { /* intrinsic dimensions remain usable */ }
      }));
    };
    const sourceRatio = async (scope) => {
      const image = scope.querySelector('img');
      if (image instanceof HTMLImageElement) {
        const width = image.naturalWidth || numeric(image.getAttribute('width'));
        const height = image.naturalHeight || numeric(image.getAttribute('height'));
        if (width > 0 && height > 0) return width / height;
      }
      const background = scope.querySelector('[data-original]');
      const source = background?.getAttribute('data-original');
      if (!source) return 1;
      return new Promise((resolve) => {
        const probe = new Image();
        probe.onload = () => resolve(probe.naturalWidth && probe.naturalHeight ? probe.naturalWidth / probe.naturalHeight : 1);
        probe.onerror = () => resolve(1);
        probe.src = source;
      });
    };

    const sliderStates = new WeakMap();
    const updateSlider = (state, requestedIndex) => {
      const index = (requestedIndex + state.items.length) % state.items.length;
      state.index = index;
      state.wrapper.style.transform = `translate3d(${(state.offset || 0) - index * state.width}px, 0, 0)`;
      state.items.forEach((item, itemIndex) => {
        const active = itemIndex === index;
        item.classList.toggle('t-slds__item_active', active);
        item.setAttribute('aria-hidden', String(!active));
        item.setAttribute('aria-label', `${itemIndex + 1} из ${state.items.length}`);
      });
      state.slider.querySelectorAll('.t-slds__bullet').forEach((bullet, bulletIndex) => {
        bullet.classList.toggle('t-slds__bullet_active', bulletIndex === index);
        bullet.setAttribute('aria-current', bulletIndex === index ? 'true' : 'false');
      });
    };
    const layoutSlider = async (slider) => {
      if (!(slider instanceof HTMLElement)) return;
      const main = slider.querySelector('.t-slds__main');
      const container = slider.querySelector('.t-slds__container');
      const wrapper = slider.querySelector('.t-slds__items-wrapper');
      const items = wrapper ? [...wrapper.querySelectorAll(':scope > .t-slds__item')] : [];
      if (!(main instanceof HTMLElement) || !(wrapper instanceof HTMLElement) || !items.length) return;

      const galleryElement = slider.closest('.t396__elem[data-elem-type="gallery"]');
      const isGallery = galleryElement instanceof HTMLElement;
      const isT923 = slider.closest('[data-record-type="923"]') instanceof HTMLElement;
      if (isT923) {
        const frameWidth = container instanceof HTMLElement
          ? container.clientWidth
          : main.clientWidth;
        const itemsPerFrame = window.innerWidth >= 960
          ? Math.max(1, numeric(wrapper.dataset.sliderItemsInRow, 1))
          : 1;
        const itemWidth = frameWidth / itemsPerFrame;
        if (!(itemWidth > 0)) return;
        main.style.removeProperty('height');
        if (container instanceof HTMLElement) container.style.removeProperty('height');
        wrapper.style.display = 'flex';
        wrapper.style.width = `${itemWidth * items.length}px`;
        wrapper.style.height = 'auto';
        items.forEach((item, index) => {
          if (!(item instanceof HTMLElement)) return;
          item.style.display = 'flex';
          item.style.flex = `0 0 ${itemWidth}px`;
          item.style.width = `${itemWidth}px`;
          item.style.height = 'auto';
          item.style.opacity = '1';
          item.dataset.slideIndex = String(index + 1);
        });
        await new Promise((resolve) => requestAnimationFrame(resolve));
        const height = Math.max(...items.map((item) => {
          const card = item.querySelector('.t923__wrapper');
          return card instanceof HTMLElement ? card.getBoundingClientRect().height : 0;
        }));
        if (!(height > 0)) return;
        wrapper.style.height = `${height}px`;
        if (container instanceof HTMLElement) container.style.height = `${height}px`;
        items.forEach((item) => { item.style.height = `${height}px`; });
        slider.style.visibility = 'visible';
        const previous = sliderStates.get(slider);
        const state = { slider, wrapper, items, width: itemWidth, offset: 0, index: previous?.index || 0 };
        sliderStates.set(slider, state);
        updateSlider(state, state.index);
        return;
      }
      let width;
      let height;
      if (isGallery) {
        const geometry = elementGeometry(galleryElement);
        // Галерея стоит в сетке своего брейкпоинта, поэтому проценты ширины
        // считаются от неё же. Высота у галерей всегда в пикселях — ноль в
        // третьем аргументе означает «пересчитывать нечего».
        applyPercentUnits(geometry, artboardWidth(), 0);
        // The local gallery shell reserves room for visible navigation on a
        // phone.  The media frame must use that same available width; using
        // only the authored T396 element width makes the image overpaint the
        // controls even though the shell itself has been narrowed.
        width = Math.min(geometry.width, slider.clientWidth || geometry.width);
        height = geometry.height;
      } else {
        main.style.width = '';
        const separator = slider.querySelector('.t604__separator[data-slider-image-height][data-slider-image-width]');
        if (separator instanceof HTMLElement && container instanceof HTMLElement) {
          width = container.clientWidth || main.clientWidth || slider.clientWidth;
          const sourceWidth = numeric(separator.dataset.sliderImageWidth);
          const sourceHeight = numeric(separator.dataset.sliderImageHeight);
          height = Math.min(sourceWidth, width) * sourceHeight / sourceWidth;
          slider.querySelectorAll('.t604__separator').forEach((item) => {
            if (item instanceof HTMLElement) item.style.paddingBottom = `${sourceHeight / sourceWidth * 100}%`;
          });
        } else {
          width = main.clientWidth || slider.clientWidth;
          const ratio = await sourceRatio(items[0]);
          height = width / Math.max(ratio, 0.01);
        }
      }
      if (!(width > 0 && height > 0)) return;

      main.style.width = isGallery ? `${width}px` : '';
      main.style.height = isGallery ? `${height}px` : '';
      if (container instanceof HTMLElement) {
        container.style.width = isGallery ? `${width}px` : '';
        container.style.height = `${height}px`;
      }
      wrapper.style.display = 'flex';
      wrapper.style.width = `${width * items.length}px`;
      wrapper.style.height = `${height}px`;
      wrapper.style.transitionDuration = `${numeric(wrapper.dataset.sliderTransition, 300)}ms`;
      items.forEach((item, index) => {
        if (!(item instanceof HTMLElement)) return;
        item.style.display = 'block';
        item.style.flex = `0 0 ${width}px`;
        item.style.width = `${width}px`;
        item.style.height = `${height}px`;
        item.style.opacity = '1';
        item.dataset.slideIndex = String(index + 1);
        item.querySelectorAll('.tn-atom__slds-img, .t-slds__bgimg').forEach((media) => {
          if (!(media instanceof HTMLElement)) return;
          media.style.width = isGallery ? `${width}px` : '';
          media.style.height = isGallery ? `${height}px` : '';
        });
      });
      slider.style.visibility = 'visible';
      const previous = sliderStates.get(slider);
      const state = { slider, wrapper, items, width, offset: 0, index: previous?.index || 0 };
      sliderStates.set(slider, state);
      updateSlider(state, state.index);
    };

    const layoutT827 = async (record) => {
      const container = record.querySelector('.t827__container');
      const grid = record.querySelector('.t827__grid');
      const sizer = record.querySelector('.t827__grid-sizer');
      const gutter = record.querySelector('.t827__gutter-sizer');
      const items = grid ? [...grid.querySelectorAll(':scope > .t827__grid-item')] : [];
      if (!(container instanceof HTMLElement) || !(grid instanceof HTMLElement) || !items.length) return;
      await mediaReady(grid);
      const containerStyle = getComputedStyle(container);
      const width = container.clientWidth
        - numeric(containerStyle.paddingLeft)
        - numeric(containerStyle.paddingRight);
      const gap = gutter instanceof HTMLElement ? gutter.offsetWidth : 0;
      const columns = window.innerWidth >= 1200 ? 3 : 2;
      const itemWidth = (width - gap * (columns - 1)) / columns;
      if (!(itemWidth > 0)) return;
      if (sizer instanceof HTMLElement) sizer.style.width = `${itemWidth}px`;
      items.forEach((item) => {
        item.style.position = 'static';
        item.style.width = `${itemWidth}px`;
      });
      await new Promise((resolve) => requestAnimationFrame(resolve));
      const heights = items.map((item) => item.getBoundingClientRect().height);
      const columnHeights = Array(columns).fill(0);
      grid.style.position = 'relative';
      items.forEach((item, index) => {
        const column = columnHeights.indexOf(Math.min(...columnHeights));
        item.style.position = 'absolute';
        item.style.left = `${column * (itemWidth + gap)}px`;
        item.style.top = `${columnHeights[column]}px`;
        columnHeights[column] += heights[index] + gap;
      });
      grid.style.height = `${Math.max(...columnHeights) - gap}px`;
    };

    const layoutT979 = async (record) => {
      const grid = record.querySelector('.t979__grid');
      const items = grid ? [...grid.querySelectorAll(':scope > .t979__grid-item')] : [];
      if (!(grid instanceof HTMLElement) || !items.length) return;
      await mediaReady(grid);
      const ratios = await Promise.all(items.map(sourceRatio));
      const width = grid.clientWidth;
      const gap = numeric(record.dataset.sourceT979Gutter, 10);
      const targetHeight = numeric(record.dataset.sourceT979RowHeight, 400);
      if (!(width > 0)) return;
      let top = 0;
      let start = 0;
      while (start < items.length) {
        let end = start;
        let ratioSum = 0;
        while (end < items.length) {
          ratioSum += ratios[end];
          end += 1;
          if (ratioSum * targetHeight + gap * (end - start - 1) >= width) break;
        }
        const isLast = end === items.length;
        const available = width - gap * (end - start - 1);
        const rowHeight = isLast && ratioSum * targetHeight < available
          ? targetHeight
          : available / Math.max(ratioSum, 0.01);
        let left = 0;
        for (let index = start; index < end; index += 1) {
          const item = items[index];
          const itemWidth = ratios[index] * rowHeight;
          item.style.position = 'absolute';
          item.style.left = `${left}px`;
          item.style.top = `${top}px`;
          item.style.width = `${itemWidth}px`;
          item.style.height = `${rowHeight}px`;
          const image = item.querySelector('img');
          if (image instanceof HTMLImageElement) {
            image.style.width = '100%';
            image.style.height = '100%';
            image.style.objectFit = 'cover';
          }
          left += itemWidth + gap;
        }
        top += rowHeight + gap;
        start = end;
      }
      grid.style.position = 'relative';
      grid.style.height = `${top - gap}px`;
    };

    const equaliseT1196 = (record) => {
      const items = [...record.querySelectorAll('.t1196__item')];
      if (!items.length) return;
      items.forEach((item) => { item.style.height = ''; });
      const height = Math.max(1, ...items.map((item) => Math.max(
        item.getBoundingClientRect().height,
        item.scrollHeight,
      )));
      items.forEach((item) => { item.style.height = `${height}px`; });
    };

    const layoutT829 = (record) => {
      const container = record.querySelector('.t829__container');
      const grid = record.querySelector('.t829__grid');
      const sizer = record.querySelector('.t829__grid-sizer');
      const gutter = record.querySelector('.t829__gutter-sizer');
      const items = grid ? [...grid.querySelectorAll(':scope > .t829__grid-item')] : [];
      if (!(container instanceof HTMLElement) || !(grid instanceof HTMLElement) || !items.length) return;
      if (window.innerWidth > 960) {
        const gap = gutter instanceof HTMLElement ? gutter.offsetWidth : 10;
        const columns = window.innerWidth >= 1200 ? Math.min(5, items.length) : Math.min(4, items.length);
        const containerStyle = getComputedStyle(container);
        const width = container.clientWidth
          - numeric(containerStyle.paddingLeft)
          - numeric(containerStyle.paddingRight);
        const itemWidth = (width - gap * (columns - 1)) / columns;
        if (!(itemWidth > 0)) return;
        grid.style.position = 'relative';
        grid.style.width = `${width}px`;
        if (sizer instanceof HTMLElement) sizer.style.width = `${itemWidth}px`;
        items.forEach((item, index) => {
          if (!(item instanceof HTMLElement)) return;
          item.style.position = 'absolute';
          item.style.left = `${(index % columns) * (itemWidth + gap)}px`;
          item.style.top = '0px';
          item.style.width = `${itemWidth}px`;
        });
        const height = Math.max(...items.map((item) => item.getBoundingClientRect().height));
        grid.style.height = `${height + gap}px`;
        return;
      }
      if (grid instanceof HTMLElement) grid.removeAttribute('style');
      if (sizer instanceof HTMLElement) sizer.style.width = '0px';
      items.forEach((item) => {
        if (!(item instanceof HTMLElement)) return;
        item.removeAttribute('style');
        item.classList.remove('t-animate', 't-animate_started', 't-animate__chain_showed');
      });
    };

    const layoutT347 = (record) => {
      const column = record.querySelector('.t-col');
      const table = record.querySelector('.t347__table');
      if (!(column instanceof HTMLElement) || !(table instanceof HTMLElement)) return;
      column.style.boxSizing = 'border-box';
      if (!table.dataset.sourceAuthoredHeight) {
        table.dataset.sourceAuthoredHeight = table.style.height;
      }
      const authoredHeight = numeric(table.dataset.sourceAuthoredHeight);
      if (authoredHeight > 0) {
        table.style.height = `${authoredHeight}px`;
        return;
      }
      const width = table.getBoundingClientRect().width;
      const columnWidth = column.getBoundingClientRect().width;
      const height = window.innerWidth >= 960
        ? 540 * columnWidth / 960
        : width * 9 / 16;
      if (height > 0) table.style.height = `${height}px`;
    };

    const layoutT799 = (record) => {
      const slider = record.querySelector('.t799 .t-slds');
      const container = slider?.querySelector('.t-slds__container');
      const wrapper = slider?.querySelector('.t-slds__items-wrapper');
      const items = wrapper ? [...wrapper.querySelectorAll(':scope > .t-slds__item')] : [];
      if (!(slider instanceof HTMLElement)
          || !(container instanceof HTMLElement)
          || !(wrapper instanceof HTMLElement)
          || !items.length) return;
      const width = slider.clientWidth;
      const height = width * 0.72;
      if (!(width > 0 && height > 0)) return;
      container.style.height = `${height}px`;
      wrapper.style.display = 'flex';
      wrapper.style.width = `${width * items.length}px`;
      wrapper.style.height = `${height}px`;
      items.forEach((item, index) => {
        if (!(item instanceof HTMLElement)) return;
        item.style.display = 'block';
        item.style.flex = `0 0 ${width}px`;
        item.style.width = `${width}px`;
        item.style.height = `${height}px`;
        item.style.opacity = '1';
        item.dataset.slideIndex = String(index + 1);
        for (const inner of item.querySelectorAll('.t-margin_auto, .t-slds__wrapper, .t799__imgwrapper')) {
          if (!(inner instanceof HTMLElement)) continue;
          inner.style.width = `${width}px`;
          inner.style.height = `${height}px`;
        }
        const separator = item.querySelector('.t799__separator');
        if (separator instanceof HTMLElement) separator.style.paddingBottom = '0';
      });
      slider.style.height = `${height}px`;
      slider.style.visibility = 'visible';
      const previous = sliderStates.get(slider);
      const state = { slider, wrapper, items, width, offset: 0, index: previous?.index || 0 };
      sliderStates.set(slider, state);
      updateSlider(state, state.index);
    };

    const initialise = async () => {
      settleSourceAnimations();
      restoreRobloxRecordStacking();
      layoutWindowArtboards();
      layoutSourceReviews();
      snapshotRoot.querySelectorAll('img').forEach((image) => {
        // loading приходит из снимка и остаётся как есть. Здесь только достраиваем
        // источник тем картинкам Tilda, у которых он лежит в data-original.
        if (!image.src && image.dataset.original) image.src = image.dataset.original;
      });
      snapshotRoot.querySelectorAll('[data-original]').forEach((element) => {
        if (!(element instanceof HTMLElement) || element instanceof HTMLImageElement) return;
        deferBackgroundImage(element);
      });
      await Promise.all([...snapshotRoot.querySelectorAll('.t-slds')].map(layoutSlider));
      await Promise.all([...snapshotRoot.querySelectorAll('[data-record-type="827"]')].map(layoutT827));
      await Promise.all([...snapshotRoot.querySelectorAll('[data-record-type="979"]')].map(layoutT979));
      snapshotRoot.querySelectorAll('[data-record-type="1196"]').forEach(equaliseT1196);
      snapshotRoot.querySelectorAll('[data-record-type="829"]').forEach(layoutT829);
      snapshotRoot.querySelectorAll('[data-record-type="347"]').forEach(layoutT347);
      snapshotRoot.querySelectorAll('[data-record-type="799"]').forEach(layoutT799);
    };

    const enableLocalFormControls = () => {
      document.querySelectorAll('[data-local-source-form][data-local-form-pending]').forEach((form) => {
        form.querySelectorAll('input[disabled], textarea[disabled], select[disabled], button[disabled]').forEach((control) => {
          control.removeAttribute('disabled');
        });
        form.removeAttribute('data-local-form-pending');
      });
    };

    const submitLocally = (form) => {
      const success = form.querySelector('[data-local-form-success], .js-successbox');
      if (success instanceof HTMLElement) {
        success.hidden = false;
        success.style.display = 'grid';
        success.textContent = 'Спасибо! Заявка принята.';
      }
      const inputs = form.querySelector('.t-form__inputsbox');
      if (inputs instanceof HTMLElement) inputs.hidden = true;
      form.dataset.submitted = 'true';
    };

    document.addEventListener('submit', (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;
      event.preventDefault();
      submitLocally(form);
    });
    document.addEventListener('click', (event) => {
      const sliderControl = event.target instanceof Element
        ? event.target.closest('.t-slds__arrow_wrapper-left, .t-slds__arrow_wrapper-right, .t-slds__bullet')
        : null;
      if (sliderControl) {
        const slider = sliderControl.closest('.t-slds');
        const state = slider ? sliderStates.get(slider) : null;
        if (state) {
          event.preventDefault();
          const bullets = [...slider.querySelectorAll('.t-slds__bullet')];
          const bulletIndex = bullets.indexOf(sliderControl);
          const nextIndex = bulletIndex >= 0
            ? bulletIndex
            : state.index + (sliderControl.classList.contains('t-slds__arrow_wrapper-left') ? -1 : 1);
          updateSlider(state, nextIndex);
        }
        return;
      }
      const nolimControl = event.target instanceof Element
        ? event.target.closest('[data-source-nolim-slider] a[href="#prev"], [data-source-nolim-slider] a[href="#next"]')
        : null;
      if (nolimControl) {
        event.preventDefault();
        const current = nolimControl.closest('[data-source-nolim-slider]');
        const sliderId = current?.getAttribute('data-source-nolim-slider');
        const slides = sliderId
          ? [...document.querySelectorAll(`[data-source-nolim-slider="${CSS.escape(sliderId)}"]`)]
          : [];
        const activeIndex = slides.findIndex((slide) => !slide.classList.contains('nolimAutoScaleFix'));
        if (slides.length > 1 && activeIndex >= 0) {
          const direction = nolimControl.getAttribute('href') === '#prev' ? -1 : 1;
          const nextIndex = (activeIndex + direction + slides.length) % slides.length;
          slides.forEach((slide, index) => slide.classList.toggle('nolimAutoScaleFix', index !== nextIndex));
        }
        return;
      }
      const anchor = event.target instanceof Element ? event.target.closest('a[href^="#popup:"], a[href^="#form:"]') : null;
      if (anchor) {
        event.preventDefault();
        location.hash = 'source-booking';
        return;
      }
      const menuControl = event.target instanceof Element
        ? event.target.closest('a[href="#mobile-menu"]')
        : null;
      if (menuControl) {
        event.preventDefault();
        document.querySelector('.hdr__burger')?.click();
      }
    });

    const wait = (milliseconds) => new Promise((resolve) => window.setTimeout(resolve, milliseconds));
    const settleFirstFrame = async () => {
      await initialise();
      // Tilda runs delayed reconciliation after its initial layout. Keep that
      // reconciliation before the first visible frame, rather than moving a
      // rendered hero after paint.
      await wait(760);
      await initialise();
      if (!(snapshotShell instanceof HTMLElement)) return;
      snapshotShell.style.display = 'block';
      await initialise();
      enableLocalFormControls();
      snapshotShell.style.visibility = 'visible';
      snapshotShell.removeAttribute('aria-busy');
    };
    void settleFirstFrame();
    // The local live layer may reserve a phone gutter for Zero Block controls
    // after the source runtime settles. Reuse this layout path so media widths
    // and slide offsets remain coherent with the final shell geometry.
    window.addEventListener('source:relayout-sliders', () => { void initialise(); });
    let resizeTimer;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(initialise, 120);
    });
  })();
</script>

