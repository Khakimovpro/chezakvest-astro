---
// Шаблон страницы квеста. Данные — src/data/pages/<slug>.json (собирает _capture/build_quest.py).
// Порядок секций повторяет оригинал на Tilda, кроме блока расписания: он не переносится.
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CardsRow from '../components/CardsRow.astro';
import PartyForm from '../components/PartyForm.astro';
import CallbackForm from '../components/CallbackForm.astro';
import PrebookingForm from '../components/PrebookingForm.astro';
import VenuesSection from '../components/VenuesSection.astro';
import ZoomImg from '../components/ZoomImg.astro';
import site from '../data/site.json';
import { absoluteAssetUrl, absoluteUrl, breadcrumbJsonLd, withCollectionBreadcrumbs } from '../lib/seo.js';
import { siteHref } from '../lib/urls.js';
import '../styles/page.css';
import '../styles/quest.css';

const { page, index = [], venues = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p) => (p ? base + p : '');
const link = (h) => siteHref(base, h);

const path = '/' + page.slug;
const seo = page.seo;
const hero = page.hero || {};
const breadcrumbs = withCollectionBreadcrumbs(page.breadcrumbs || []);
const venue = venues.find((candidate) => candidate.slug === page.venueSlug);
const venueContent = page.venue || {};
// A few audited quests have two genuine celebration halls. Older records have
// one object; empty legacy stubs must not create a blank venue section.
const celebrationVenues = (page.celebrationVenues?.length
  ? page.celebrationVenues
  : ((venueContent.photos?.length || venueContent.lines?.length)
    ? [{ ...venueContent, venueSlug: page.venueSlug }]
    : []));
const visiblePrice = Number(page.priceFrom) || null;
// The generic quest source has its own body marker in addition to the dark
// variant. It lets the measured callback artboard remain local to QuestPage
// instead of changing the callback used by unrelated page families.
const questBodyClass = ['quest-page', page.theme === 'dark' ? 'theme-dark' : ''].filter(Boolean).join(' ');

// возраст («12+») в оригинале стоит отдельным кружком справа, остальное — пилюли слева
const age = (hero.pills || []).find((p) => /\+$/.test(p));
const pills = (hero.pills || []).filter((p) => p !== age)
  .sort((a, b) => (/мин|час/i.test(b) ? 1 : 0) - (/мин|час/i.test(a) ? 1 : 0));   // длительность первой, как в оригинале
const difficultyKeys = Number.isInteger(page.difficulty)
  ? Array.from({ length: 5 }, (_, index) => index < page.difficulty)
  : [];

// ---- Schema.org: услуга + хлебные крошки ----
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': absoluteUrl(`${path}#service`),
    name: seo.h1,
    serviceType: 'Квест в реальности',
    description: seo.description,
    url: absoluteUrl(path),
    image: hero.bg ? absoluteAssetUrl(hero.bg) : undefined,
    areaServed: { '@type': 'City', name: 'Ростов-на-Дону' },
    audience: age ? { '@type': 'PeopleAudience', suggestedMinAge: parseInt(age, 10) } : undefined,
    provider: {
      '@type': 'EntertainmentBusiness',
      '@id': absoluteUrl('/#organization'),
      name: 'Чё за Квест',
      telephone: site.header.phone,
      url: absoluteUrl('/'),
      address: { '@type': 'PostalAddress', addressLocality: 'Ростов-на-Дону', addressCountry: 'RU' },
    },
    ...(venue ? {
      availableAtOrFrom: {
        '@type': 'Place',
        '@id': absoluteUrl(`/${venue.slug}#location`),
        name: `Чё за Квест — ${venue.address}`,
        url: absoluteUrl(`/${venue.slug}`),
      },
    } : {}),
    ...(visiblePrice ? {
      offers: {
        '@type': 'Offer',
        availability: 'https://schema.org/InStock',
        price: visiblePrice,
        priceCurrency: 'RUB',
        url: absoluteUrl(path),
        category: 'Квест',
      },
    } : {}),
  },
  breadcrumbs.length > 0 && breadcrumbJsonLd(breadcrumbs, path),
].filter(Boolean);

const heroSrcset = hero.bgset
  // The 1,600px source is the largest permitted local original. Keeping only the
  // mobile and maximum candidates makes the browser select a retina-safe source
  // instead of the former 1,200px intermediary for a 1,200px desktop hero.
  ? Object.entries(hero.bgset).filter(([w]) => w === '760' || w === '1600' || !hero.bgset?.['1600'])
    .map(([w, p]) => `${asset(p)} ${w}w`).join(', ')
  : (hero.bg ? `${asset(hero.bg)} 1600w` : '');
const heroSource = hero.bgset?.['1600'] || hero.bgset?.['1200'] || hero.bg;
// запасная перелинковка: без неё страница остаётся сиротой и теряет вес в поиске
const relatedItems = page.related?.items?.length
  ? page.related.items
  : index.filter((p) => p.slug !== page.slug && p.img)
      .sort((a, b) => a.slug.localeCompare(b.slug))
      .slice(0, 8)
      .map((p) => ({ t: p.t.replace(/^Квест\s+/i, ''), href: '/' + p.slug, img: p.img }));
const pagesBySlug = new Map(index.map((item) => [item.slug, item]));
const canonicalizeCardItems = (items = []) => items.map((item) => {
  const slug = String(item.href || '').split(/[?#]/, 1)[0].replace(/^\/+|\/+$/g, '');
  // Explicit Tilda thumbnails were frequently low-resolution derivatives. Prefer
  // the linked page's highest-quality local hero whenever it is available.
  return {
    ...item,
    img: pagesBySlug.get(slug)?.img || item.img,
    imgSet: pagesBySlug.get(slug)?.imgSet || null,
  };
});
const canonicalCardItems = canonicalizeCardItems(relatedItems);
const relatedTitle = page.related?.title || 'Другие квесты от «Чё за Квест?»';
const relatedSub = page.related?.subtitle || 'У нас есть из чего выбрать';

const preload = hero.bg
  ? { href: asset(heroSource), srcset: heroSrcset, sizes: '(max-width:700px) 100vw, 1200px' }
  : null;
---
<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  path={path}
  ogImage={hero.bg}
  ogType="article"
  jsonld={jsonld}
  preloadImage={preload}
  bodyClass={questBodyClass}
>
  <Header />

  <main>
    <!-- ============ ГЕРОЙ КВЕСТА ============ -->
    <section class="qhero">
      <div class="container-wide">
        <div class="qhero__panel">
          {hero.bg && (
            <img class="qhero__bg" src={asset(heroSource)}
                 srcset={heroSrcset} sizes="(max-width:700px) 100vw, 1200px"
                 alt={`Квест «${seo.h1}» в Ростове-на-Дону`}
                 width="1200" height="550" fetchpriority="high" decoding="async" />
          )}
          {pills.length > 0 && (
            <div class="qhero__pills">
              {pills.map((p) => (
                <span class="qpill">
                  {/мин|час/i.test(p)
                    ? <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="#ff8a00" stroke-width="2"/><path d="M12 7v5l3 2" fill="none" stroke="#ff8a00" stroke-width="2" stroke-linecap="round"/></svg>
                    : <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="#ff8a00" d="M12 12a4 4 0 100-8 4 4 0 000 8zm0 2c-4 0-7 2-7 4.5V21h14v-2.5c0-2.5-3-4.5-7-4.5z"/></svg>}
                  {p}
                </span>
              ))}
            </div>
          )}
          {age && <span class="qhero__age">{age}</span>}
          {difficultyKeys.length > 0 && (
            <div class="qhero__keys" aria-label={`Сложность квеста: ${page.difficulty} из 5`}>
              {difficultyKeys.map((active, index) => (
                <span class:list={['qhero__key', { 'qhero__key--active': active }]} title={`Уровень сложности ${index + 1} из 5`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.2 3.8a5.1 5.1 0 1 0 3.4 8.9l2.7 2.7v2h2v2h-3.4L16.2 17a5.1 5.1 0 0 0-2-13.2Zm0 3a2.1 2.1 0 1 1 0 4.2 2.1 2.1 0 0 1 0-4.2Z"/></svg>
                  <span class="visually-hidden">Уровень сложности {index + 1}</span>
                </span>
              ))}
            </div>
          )}
          {page.video && page.video.poster && (
            <a class="qhero__play" href="#video" data-video-trigger aria-label="Смотреть видео о квесте">
              <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="#fff" d="M8 5.5v13l11-6.5z"/></svg>
            </a>
          )}
          <div class="qhero__body">
            <h1 class="qhero__title">{hero.h1}</h1>
            <div class="qhero__cta">
              {(hero.buttons || []).map((b, i) => (
                <a class={i === 0 ? 'btn-orange' : 'qhero__btn-ghost'} href={link(b.href)}>{b.t}</a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <Breadcrumbs items={breadcrumbs} />

    <!-- ============ ПРЕДЫСТОРИЯ ============ -->
    {page.story && (
      <section class="qstory" id="story">
        <div class="container">
          <h2 class="section-title">{page.story.title}</h2>
          <div class="qstory__cols">
            {page.story.paragraphs.map((p, i) => (
              <p class={i === 0 ? 'qstory__lead' : 'qstory__p'}>{p}</p>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ============ ОСОБЕННОСТИ ============ -->
    {page.features && ((page.features.items || []).length > 0 || (page.features.lead || []).length > 0) && (
      <section class="qfeat">
        <div class="container">
          <h2 class="section-title qfeat__title">{page.features.title || 'Особенности'}</h2>
          {(page.features.lead || []).map((l, i) => (
            <p class={i === 0 ? 'qfeat__lead qfeat__lead--strong' : 'qfeat__lead'}>{l}</p>
          ))}
        </div>
        <div class="qfeat__wrap container">
          {(page.features.items || []).length > 0 && (
            <ul class="qfeat__row">
              {page.features.items.map((it) => (
                <li class="qfeat__card">
                  <h3 class="qfeat__cardtitle">{it.t}</h3>
                  {it.sub && <p class="qfeat__cardsub">{it.sub}</p>}
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )}

    <!-- ============ БРОНИРОВАНИЕ (расписание — внешний модуль, здесь заявка) ============ -->
    {page.booking && (
      <section class="qbook" id="booking">
        <div class="container">
          <h2 class="section-title qbook__title">
            {page.booking.title.split(' ')[0]} <span class="accent">{page.booking.title.split(' ').slice(1).join(' ')}</span>
          </h2>
          {page.booking.lines.map((l) => (<p class="qbook__line">{l}</p>))}
          <div class="qbook__cta">
            <a class="btn-orange" href={site.header.phoneHref}>Забронировать по телефону</a>
            <a class="qbook__wa" href={site.header.wa} target="_blank" rel="noopener">Написать в WhatsApp</a>
          </div>
        </div>
      </section>
    )}

    {page.booking?.calendarId && <PrebookingForm id={`booking-${page.slug}`} quest={hero.h1 || seo.h1} calendarId={page.booking.calendarId} />}

    {relatedItems.length > 0 && (
      <CardsRow title={relatedTitle} subtitle={relatedSub}
                items={canonicalCardItems} variant="poster" id="drugie" />
    )}

    {page.showPartyForm !== false && <PartyForm />}

    <!-- ============ ПЛОЩАДКА ============ -->
    {celebrationVenues.length > 0 && (
      <section class="qvenue">
        <div class="container">
          <h2 class="section-title">{celebrationVenues[0].title || 'Площадка проведения'}</h2>
          {celebrationVenues[0].subtitle && <p class="section-sub">{celebrationVenues[0].subtitle}</p>}
          <div class="qvenue__stack">
            {celebrationVenues.map((hall, hallIndex) => {
              const hallVenue = venues.find((candidate) => candidate.slug === hall.venueSlug) || venue;
              const hallAddress = hall.address || hallVenue?.address || '';
              return (
                <div class="qvenue__card">
                  <div class="qvenue__photos qvenue__photos--rail" aria-label={`Фотографии зала: ${hallAddress}`}>
                    {(hall.photos || []).map((ph) => (
                      <ZoomImg src={asset(ph)} group={`quest-venue-${page.slug}-${hallIndex}`} imageClass="qvenue__photo"
                               alt={`Зал «Чё за Квест» — ${hallAddress}`}
                               loading="lazy" decoding="async" width="600" height="400" />
                    ))}
                  </div>
                  <div class="qvenue__info">
                    <h3 class="qvenue__addr">
                      {hallVenue ? <a href={link('/' + hallVenue.slug)}>{hallAddress}</a> : hallAddress}
                    </h3>
                    {(hall.lines || []).length > 0 && (
                      <ul class="qvenue__list">
                        {hall.lines.map((line) => (<li>{line}</li>))}
                      </ul>
                    )}
                    <a class="btn-orange" href={site.header.phoneHref}>{hall.cta || 'Забронировать дату'}</a>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- ============ ПРОЧИЕ БЛОКИ ОРИГИНАЛА (у части квестов свой набор секций) ============ -->
    {(page.extra || []).map((e, sectionIndex) => (
      <section class="qextra">
        <div class="container">
          {e.title && <h2 class="section-title">{e.title}</h2>}
          {e.lines.map((l) => (<p class="qextra__line">{l}</p>))}
          {e.photos.length > 0 && (
            <div class:list={[
              'qextra__photos',
              e.photos.length > 1 ? 'qextra__photos--rail' : 'qextra__photos--row',
            ]} aria-label={e.title ? `Фотографии: ${e.title}` : 'Фотографии квеста'}>
              {e.photos.map((ph) => (
                <ZoomImg src={asset(ph)} group={`quest-extra-${page.slug}-${sectionIndex}`}
                         alt={e.title || `Фото квеста «${seo.h1}»`}
                         width="600" height="400" loading="lazy" decoding="async" reveal />
              ))}
            </div>
          )}
        </div>
      </section>
    ))}

    <!-- ============ ВИДЕО ============ -->
    {page.video && page.video.poster && (
      <section class="qvideo" id="video">
        <div class="container">
          <h2 class="section-title qvideo__title">{page.video.title}</h2>
          <figure class="qvideo__frame" data-video={page.video.src ? asset(page.video.src) : undefined}>
            <img class="qvideo__poster" src={asset(page.video.poster)} alt={page.video.caption}
                 loading="lazy" decoding="async" width="1120" height="630" />
            {page.video.src && (
              <button class="qvideo__play" type="button" aria-label="Воспроизвести видео">
                <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path fill="#fff" d="M8 5.5v13l11-6.5z"/></svg>
              </button>
            )}
            <figcaption class="qvideo__cap">{page.video.caption}</figcaption>
          </figure>
        </div>
      </section>
    )}

    {page.scenarios && (
      <CardsRow title={page.scenarios.title} subtitle={page.scenarios.subtitle}
                items={canonicalizeCardItems(page.scenarios.items)} variant="square" uptitle="День рождения в стиле" />
    )}

    <CallbackForm id={page.showPartyForm === false ? 'prazdnik' : 'q'} sectionId={page.showPartyForm === false ? 'prazdnik' : 'callback'} />

    <VenuesSection id={`venues-${page.slug}`} base={base} />
  </main>

  <Footer />
</Layout>

<script>
  import '../scripts/main.js';
  import '../scripts/rows.js';
</script>
