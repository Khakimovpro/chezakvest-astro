---
// Шаблон страницы площадки (адреса). Данные — src/data/pages/<slug>.json (_capture/build_venue.py).
// Порядок секций как в оригинале: как нас найти → карта → квесты на локации → форма праздника →
// зал для праздника → форма «Есть вопрос?». Reviews use the shared local component where required.
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CardsRow from '../components/CardsRow.astro';
import PartyForm from '../components/PartyForm.astro';
import ZoomImg from '../components/ZoomImg.astro';
import MagnitVenueHall from '../components/MagnitVenueHall.astro';
import LazyMap from '../components/LazyMap.astro';
import Reviews from '../components/Reviews.astro';
import VenuesSection from '../components/VenuesSection.astro';
import site from '../data/site.json';
import { breadcrumbJsonLd, venueBusinessJsonLd, withCollectionBreadcrumbs } from '../lib/seo.js';
import { canonicalizeCardItems } from '../lib/card-items.js';
import { groupVenueGameItems } from '../lib/venue-games.js';
import '../styles/page.css';
import '../styles/quest.css';

const { page, index = [], venues = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p) => (p ? base + p : '');

const path = '/' + page.slug;
const seo = page.seo;
const howto = page.howto || {};
const venue = venues.find((candidate) => candidate.slug === page.slug);
const address = venue?.address || (page.breadcrumbs || []).slice(-1)[0]?.t || page.hall?.address || '';
const breadcrumbs = withCollectionBreadcrumbs(page.breadcrumbs || []);
const mapsUrl = howto.routeUrl
  || `https://yandex.ru/maps/?text=${encodeURIComponent('Ростов-на-Дону, ' + address)}`;
const pagesBySlug = new Map(index.map((item) => [item.slug, item]));
const canonicalGameItems = (items = []) => canonicalizeCardItems(items, pagesBySlug);
const gameGroups = groupVenueGameItems(page.games?.items, page.games?.groups);

// ---- Schema.org: площадка как заведение + хлебные крошки ----
const jsonld = [
  venueBusinessJsonLd({ page, venue, site }),
  breadcrumbs.length > 0 && breadcrumbJsonLd(breadcrumbs, path),
].filter(Boolean);

const lcp = howto.photos?.[0];
const preload = lcp ? { href: asset(lcp), srcset: `${asset(lcp)} 1000w`, sizes: '(max-width:900px) 100vw, 560px' } : null;
---
<Layout
  title={seo.title}
  description={seo.description}
  schemaName={seo.h1}
  keywords={seo.keywords}
  path={path}
  ogImage={lcp}
  jsonld={jsonld}
  preloadImage={preload}
>
  <Header />

  <main class="venue-page">
    <Breadcrumbs items={breadcrumbs} />

    <!-- ============ КАК НАС НАЙТИ ============ -->
    <section class="vhow">
      <div class="container">
        <div class="vhow__heading">
          <p class="vhow__up">{howto.uptitle}</p>
          <h1 class="vhow__title">{howto.title || seo.h1}</h1>
        </div>
        <div class="vhow__card">
          <div class="vhow__text">
            {(howto.variants || []).map((v) => (<p class="vhow__var">{v}</p>))}
            <a class="vhow__cta" href={mapsUrl} target="_blank" rel="noopener">{howto.cta || 'Построить маршрут'}</a>
          </div>
          {howto.photos?.length > 0 && (
            <div class="vhow__photos vhow__photos--rail" aria-label={`Фотографии маршрута: ${address}`}>
              {howto.photos.map((p, i) => (
                <ZoomImg src={asset(p)} group={`venue-how-${page.slug}`} buttonClass="zoomable--vhow"
                         alt={`Как найти «Чё за Квест» — ${address}`}
                         width="560" height="400" loading={i === 0 ? 'eager' : 'lazy'}
                         fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- ============ КАРТА: local poster first, external iframe only after a click ============ -->
    {page.map?.img && (
      <section class="vmap">
        <div class="container">
          <LazyMap embedUrl={page.map.embedUrl} poster={asset(page.map.img)}
                   alt={`«Чё за Квест» на карте: ${address}`} title={`Карта площадки «Чё за Квест» — ${address}`}
                   width={1400} height={400} className="venues__map vmap__embed" />
        </div>
      </section>
    )}

    {gameGroups.map((group, groupIndex) => (
      <CardsRow title={groupIndex === 0 ? page.games.title : ''}
                uptitle={group.uptitle || ''}
                items={canonicalGameItems(group.items)} variant="poster"
                id={groupIndex === 0 ? 'kvesty' : ''} />
    ))}

    {page.showPartyForm !== false && <PartyForm />}

    <!-- ============ ЗАЛ ДЛЯ ПРАЗДНИКА ============ -->
    {page.hall?.layout === 'magnit-t396' ? (
      <MagnitVenueHall hall={page.hall} address={address} asset={asset} ctaHref="#prazdnik" />
    ) : page.hall && (
      <section class="qvenue">
        <div class="container">
          {page.hall.title && <h2 class="section-title">{page.hall.title}</h2>}
          {page.hall.subtitle && <p class="section-sub">{page.hall.subtitle}</p>}
          <div class="qvenue__card">
            <div class="qvenue__photos qvenue__photos--rail" aria-label={`Фотографии зала: ${address}`}>
              {(page.hall.photos || []).map((ph) => (
                <ZoomImg src={asset(ph)} group={`venue-hall-${page.slug}`} imageClass="qvenue__photo"
                         alt={`Зал для праздника — ${address}`}
                         loading="lazy" decoding="async" width="600" height="400" />
              ))}
            </div>
            <div class="qvenue__info">
              <h3 class="qvenue__addr">{page.hall.address}</h3>
              <ul class="qvenue__list">
                {page.hall.lines.map((l) => (<li>{l}</li>))}
              </ul>
              <a class="btn-orange" href={site.header.phoneHref}>{page.hall.cta}</a>
            </div>
          </div>
        </div>
      </section>
    )}

    {page.showReviews !== false && <Reviews title={`Отзывы о «Чё за Квест» — ${address}`} limit={8} />}

    <VenuesSection id={`venues-${page.slug}`} base={base} />

  </main>

  <Footer />
</Layout>

<script>
  import '../scripts/main.js';
  import '../scripts/rows.js';
</script>
