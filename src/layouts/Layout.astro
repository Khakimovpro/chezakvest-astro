---
import '../styles/fonts.css';
import '../styles/global.css';
import site from '../data/site.json';
import { canonicalUrl, ORIGIN } from '../lib/urls.js';
import { globalJsonLd, videoObjectJsonLd, visibleVideoFor } from '../lib/seo.js';
import Lightbox from '../components/Lightbox.astro';
import Analytics from '../components/Analytics.astro';
import SourceSnapshotBody from '../components/SourceSnapshotBody.astro';
import { sourceSnapshotFor } from '../lib/source-snapshots.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p) => base + p;              // /assets/x -> /<base>/assets/x

const m = site.meta;
const {
  title = m.title,
  description = m.description,
  schemaName = title,
  keywords = m.keywords,
  path = '/',                 // путь страницы на боевом домене, из него собирается canonical
  ogImage = m.ogimage,
  ogType = 'website',
  noindex = false,
  // Live legacy pages occasionally use `noindex` without the generic
  // follow-directive. A route can opt into that exact source value while the
  // default remains the safer `noindex, follow` used by local fallbacks.
  robots = noindex ? 'noindex, follow' : '',
  jsonld = [],                // массив объектов Schema.org — по одному <script> на каждый
  video = null,               // нативный ролик и, при наличии, метаданные snapshot-плеера
  bodyClass = '',
  // LCP-картинка страницы: {href, srcset, sizes}. По умолчанию — фон героя главной.
  preloadImage = {
    href: asset('/assets/_static/hero_dungeon_1200.webp'),
    srcset: `${asset('/assets/_static/hero_dungeon_760.webp')} 760w, ${asset('/assets/_static/hero_dungeon_1200.webp')} 1200w`,
    sizes: '(max-width:700px) 100vw, 1200px',
  },
} = Astro.props;

const canonical = canonicalUrl(path);
const pageImage = typeof Astro.props.ogImage === 'string' ? Astro.props.ogImage.trim() : '';
const sourceSnapshot = sourceSnapshotFor(path);
const verifiedPageImage = pageImage && (!sourceSnapshot || sourceSnapshot.html.includes(pageImage))
  ? pageImage
  : '';
const visibleVideo = visibleVideoFor({ video, visibleSource: sourceSnapshot?.html || '' });
const pageJsonLd = [
  ...jsonld,
  videoObjectJsonLd({ video: visibleVideo, path, pageName: schemaName }),
].filter(Boolean);
const renderedJsonLd = noindex
  ? pageJsonLd
  : globalJsonLd({ site, path, title: schemaName, image: verifiedPageImage, visibleSource: sourceSnapshot?.html || '', jsonld: pageJsonLd });
// Keep archived source snapshots independent from route-specific legacy theme
// classes, which otherwise leak backgrounds and sizing into the source DOM.
const renderedBodyClass = sourceSnapshot ? 'source-snapshot-page' : bodyClass;
const absoluteAsset = (p) => {
  if (!p) return '';
  if (/^https?:\/\//i.test(p)) return p;
  return ORIGIN + (p.startsWith('/') ? p : `/${p}`);
};
// кириллический woff2 Montserrat — критичен для первого экрана
const montserratCyr = asset('/assets/fonts.gstatic.com/s/montserrat/v31/JTUSjIg1_i6t8kCHKm459W1hyzbi.woff2');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content={robots} />}
    <meta name="format-detection" content="telephone=no" />
    <meta name="yandex-verification" content={m.yandex} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Чё за Квест" />
    {ogImage && <meta property="og:image" content={absoluteAsset(ogImage)} />}
    {ogImage && <meta property="og:image:alt" content={title} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    {ogImage && <meta name="twitter:image" content={absoluteAsset(ogImage)} />}
    {ogImage && <meta name="twitter:image:alt" content={title} />}

    <link rel="icon" href={asset(m.favicon)} sizes="16x16 24x24 32x32 64x64" type="image/x-icon" />
    <link rel="shortcut icon" href={asset(m.favicon)} type="image/x-icon" />
    <link rel="apple-touch-icon" href={asset(m.appleIcon)} />
    <link rel="apple-touch-icon" sizes="76x76" href={asset(m.appleIcon)} />
    <link rel="apple-touch-icon" sizes="152x152" href={asset(m.appleIcon)} />
    <link rel="apple-touch-startup-image" href={asset(m.appleIcon)} />
    <meta name="msapplication-TileColor" content={m.tileColor} />
    <meta name="msapplication-TileImage" content={asset(m.tileIcon)} />

    <!-- LCP: главная картинка первого экрана + критичный шрифт -->
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage.href}
            imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />
    )}
    <link rel="preload" as="font" type="font/woff2" href={montserratCyr} crossorigin />
    {sourceSnapshot?.styles.map((name) => (
      <link rel="stylesheet" href={asset(`/${['assets', 'source-css', name].join('/')}`)} />
    ))}

    {renderedJsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
    <Analytics />
  </head>
  <body class={renderedBodyClass}>
    {sourceSnapshot ? <SourceSnapshotBody snapshot={sourceSnapshot} /> : <slot />}
    {!sourceSnapshot && <Lightbox />}
    <dialog class="exit-intent" data-exit-intent-dialog data-exit-whatsapp={site.header.wa} aria-labelledby="exit-intent-title">
      <form class="exit-intent__form" data-exit-intent-form>
        <button class="exit-intent__close" data-exit-intent-close type="button" aria-label="Закрыть">×</button>
        <p class="exit-intent__eyebrow">ЕСТЬ ВОПРОС?</p>
        <h2 id="exit-intent-title">Стой, не уходи!</h2>
        <p>Оставьте номер — откроем WhatsApp с готовой заявкой на обратный звонок.</p>
        <label class="exit-intent__label" for="exit-intent-phone">Телефон
          <input id="exit-intent-phone" data-exit-intent-phone name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 (999) 999-99-99" required />
        </label>
        <label class="exit-intent__consent"><input data-exit-intent-consent type="checkbox" required /> <span>Согласен на обработку персональных данных</span></label>
        <label class="exit-intent__honeypot" aria-hidden="true">Сайт<input data-exit-intent-honeypot name="website" tabindex="-1" autocomplete="off" /></label>
        <button class="exit-intent__submit" type="submit">Написать в WhatsApp</button>
        <p class="exit-intent__status" data-exit-intent-status aria-live="polite"></p>
      </form>
    </dialog>
    <script>
      import { initExitIntent } from '../scripts/exit-intent.js';
      import '../scripts/lead-form.js';
      import { initSupportChat } from '../scripts/support-chat.js';
      initExitIntent(document.querySelector('[data-exit-intent-dialog]'));
      initSupportChat();
    </script>
  </body>
</html>
