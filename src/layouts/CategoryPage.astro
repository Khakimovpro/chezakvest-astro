---
// Шаблон страницы-категории («Страшные квесты в Ростове-на-Дону»).
// Данные — src/data/pages/<slug>.json (_capture/build_misc.py). Reviews are rendered locally where needed.
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CardsRow from '../components/CardsRow.astro';
import CallbackForm from '../components/CallbackForm.astro';
import ZoomImg from '../components/ZoomImg.astro';
import Reviews from '../components/Reviews.astro';
import VenuesSection from '../components/VenuesSection.astro';
import HorrorCategoryArtboard from '../components/HorrorCategoryArtboard.astro';
import site from '../data/site.json';
import { breadcrumbJsonLd, collectionPageJsonLd, withCollectionBreadcrumbs } from '../lib/seo.js';
import { siteHref } from '../lib/urls.js';
import '../styles/page.css';
import '../styles/quest.css';
import '../styles/holiday.css';
import '../styles/category.css';
import '../styles/horror-category-artboard.css';

const { page, index = [], venues = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p) => (p ? base + p : '');
const link = (h) => siteHref(base, h);
const heroLink = (h) => String(h || '').startsWith('#') ? h : link(h);

const path = '/' + page.slug;
const seo = page.seo;
const hero = page.hero || {};
const breadcrumbs = withCollectionBreadcrumbs(page.breadcrumbs || []);
// Quest records carry venueSlug, while venue pages own the public address.
const byslug = Object.fromEntries(index.map((p) => [p.slug, p]));
const venuesBySlug = Object.fromEntries(venues.map((venue) => [venue.slug, venue]));
const games = (page.games?.items || []).map((g) => {
  const info = byslug[g.href.replace(/^\//, '')] || {};
  const venue = venuesBySlug[info.venueSlug];
  const pills = info.pills || [];
  // Category captures can carry a cropped Tilda card cover.  Prefer that
  // explicit source asset, only falling back to the canonical quest cover
  // when the source record did not provide one.
  const sourceImage = g.img || info.img;
  return {
    ...g,
    img: sourceImage,
    imgSet: g.img ? null : (info.imgSet || null),
    age: pills.find((p) => /\+$/.test(p)) || '',
    people: pills.find((p) => /^\d+\s*[-–]\s*\d+$/.test(p)) || '',
    time: pills.find((p) => /мин|час/i.test(p)) || '',
    difficulty: Number.isInteger(info.difficulty) ? info.difficulty : null,
    venue,
    addr: venue?.address || '',
  };
});

// ---- Schema.org: список игр категории + крошки ----
const jsonld = [
  collectionPageJsonLd({
    path,
    name: seo.h1,
    description: seo.description,
    items: games.map((game) => ({ name: game.t, url: game.href })),
  }),
  breadcrumbs.length > 0 && breadcrumbJsonLd(breadcrumbs, path),
].filter(Boolean);

const heroSrcset = hero.bgset
  ? Object.entries(hero.bgset).filter(([w, p]) => p && (w === '760' || w === '1600' || !hero.bgset?.['1600']))
    .map(([w, p]) => `${asset(p)} ${w}w`).join(', ')
  : '';
const heroSource = hero.bgset?.['1600'] || hero.bgset?.['1200'] || hero.bg;
const preload = hero.bg
  ? { href: asset(heroSource), srcset: heroSrcset, sizes: '(max-width:700px) 100vw, 1200px' }
  : null;
const hasExplicitHeroPrimary = (hero.buttons || []).some((button) => button.primary);
const sourceHorror = page.sourceParity?.kind === 'horror-category-artboard';
const categoryBodyClass = [
  page.theme === 'dark' && 'theme-dark category-theme--dark',
  sourceHorror && 'category-page--horror-source',
].filter(Boolean).join(' ');
---
<Layout
  title={seo.title}
  description={seo.description}
  schemaName={seo.h1}
  keywords={seo.keywords}
  path={path}
  ogImage={hero.bg}
  jsonld={jsonld}
  preloadImage={preload}
  bodyClass={categoryBodyClass}
>
  {!sourceHorror && !hero.hideSharedHeader && <Header />}

  {sourceHorror ? (
    <HorrorCategoryArtboard page={page} source={page.sourceParity} games={games} asset={asset} href={link} />
  ) : (
  <main>
    <!-- ============ ГЕРОЙ КАТЕГОРИИ ============ -->
    <section class:list={['qhero', { 'qhero--source-top-copy': hero.copyPosition === 'top' }]}>
      <div class="container-wide">
        <div class="qhero__panel">
          {hero.bg && (
            <img class="qhero__bg" src={asset(heroSource)} srcset={heroSrcset}
                 sizes="(max-width:700px) 100vw, 1200px" alt={seo.h1}
                 width="1200" height="550" fetchpriority="high" decoding="async" />
          )}
          {hero.foreground?.src && (
            <img class="qhero__foreground" src={asset(hero.foreground.src)} alt="" aria-hidden="true"
                 width={hero.foreground.width} height={hero.foreground.height}
                 fetchpriority="high" decoding="async" />
          )}
          <div class="qhero__body">
            <h1 class="qhero__title">{hero.h1 || seo.h1}</h1>
            {hero.sub && <p class="qhero__sub">{hero.sub}</p>}
            <div class="qhero__cta">
              {(hero.buttons || []).map((b, i) => (
                <a class={(hasExplicitHeroPrimary ? b.primary : i === 0) ? 'btn-orange' : 'qhero__btn-ghost'}
                   href={heroLink(b.href)} data-quiz={(hasExplicitHeroPrimary ? b.primary : i === 0) ? site.quiz.main : undefined}>{b.t}</a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <Breadcrumbs items={breadcrumbs} />

    <!-- ============ СЕТКА КВЕСТОВ КАТЕГОРИИ ============ -->
    {games.length > 0 && (
      <section class:list={['cgrid', { 'cgrid--source-portrait': page.games?.sourcePortraitCards }]} id="kvesty">
        <div class="container">
          <h2 class="section-title cgrid__title">{page.games.title}</h2>
          <ul class="cgrid__list">
            {games.map((g) => (
              <li class="ccard">
                <a class="ccard__link" href={link(g.href)}>
                  {g.img && <img class="ccard__img" src={asset(g.imgSet?.['760'] || g.img)}
                    srcset={g.imgSet ? Object.entries(g.imgSet)
                      .filter(([width, image]) => image && (width === '760' || width === '1600' || !g.imgSet['1600']))
                      .map(([width, image]) => `${asset(image)} ${width}w`).join(', ') : undefined}
                    sizes="(max-width:640px) calc(100vw - 40px), 359px"
                    alt={g.t} loading="lazy" decoding="async" width="380" height="290" />}
                  {g.age && <span class="ccard__age">{g.age}</span>}
                  <span class="ccard__body">
                    <span class="ccard__name">{g.t}</span>
                  </span>
                  {g.difficulty && <span class="ccard__keys" aria-label={`Сложность ${g.difficulty} из 5`}>
                    {Array.from({ length: 5 }, (_, i) => <span class:list={['ccard__key', { 'ccard__key--active': i < g.difficulty }]} aria-hidden="true">◆</span>)}
                  </span>}
                  {(g.people || g.time) && (
                    <span class="ccard__meta">
                      {g.people && <span class="ccard__chip">{g.people} чел.</span>}
                      {g.time && <span class="ccard__chip">{g.time}</span>}
                    </span>
                  )}
                </a>
                {g.venue && (
                  <a class="ccard__venue" href={link('/' + g.venue.slug)}>{g.addr}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- ============ ФОТО С КВЕСТОВ ============ -->
    {page.gallery?.photos?.length > 0 && (
      <section class="qextra">
        <div class="container">
          {page.gallery.title && <h2 class="section-title">{page.gallery.title}</h2>}
          <div class:list={[
            'qextra__photos',
            page.gallery.carousel ? 'qextra__photos--rail qextra__photos--category-carousel' : 'qextra__photos--grid',
          ]}>
            {page.gallery.photos.map((p, i) => (
              <ZoomImg src={asset(p)} group={`category-gallery-${page.slug}`} alt={`${seo.h1} — фото ${i + 1}`}
                       width="600" height="400" loading="lazy" decoding="async" reveal />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ============ СЕРТИФИКАТ ============ -->
    {page.cert && (
      <section class="ccert">
        <div class="container ccert__inner">
          <div class="ccert__text">
            <h2 class="section-title">{page.cert.title}</h2>
            {page.cert.lines.map((l) => (<p class="ccert__line">{l}</p>))}
            <a class="btn-orange" href={site.header.phoneHref}>{page.cert.cta}</a>
          </div>
          {page.cert.photos?.[0] && (
            <ZoomImg src={asset(page.cert.photos[0])} group={`category-cert-${page.slug}`} imageClass="ccert__img"
                     alt="Подарочный сертификат «Чё за Квест»" loading="lazy" decoding="async" width="500" height="356" reveal />
          )}
        </div>
      </section>
    )}

    {page.showReviews && <Reviews title={page.reviewsTitle || 'Отзывы о «Чё за Квест?»'} limit={8} />}

    <CallbackForm id="c" />

    <!-- ============ ПЛОЩАДКИ ============ -->
    <VenuesSection id={`venues-${page.slug}`} base={base}
      title={page.venues?.title || 'Наши площадки'} subtitle={page.venues?.subtitle} />
  </main>
  )}

  {!sourceHorror && <Footer />}
</Layout>

<script>
  import '../scripts/main.js';
  import '../scripts/rows.js';
</script>
