---
// Шаблон страницы «Контакты». Телефон и мессенджеры берутся из site.json — на живом сайте
// номер подменяет call-tracking, в переносе везде стоит базовый.
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CallbackForm from '../components/CallbackForm.astro';
import VenuesSection from '../components/VenuesSection.astro';
import site from '../data/site.json';
import { absoluteAssetUrl, absoluteUrl, breadcrumbJsonLd, withCollectionBreadcrumbs } from '../lib/seo.js';
import { siteHref } from '../lib/urls.js';
import '../styles/page.css';
import '../styles/quest.css';

const { page, venues = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (h) => siteHref(base, h);

const path = '/' + page.slug;
const seo = page.seo;
const breadcrumbs = withCollectionBreadcrumbs(page.breadcrumbs || []);
const raw = page.contacts?.raw || [];
const links = page.contacts?.links || [];
const email = links.find((l) => l.href.startsWith('mailto:'));
const vk = links.find((l) => l.href.includes('vk.com'));
const hours = raw.find((t) => /(?:график работы|часы работы|работаем)/iu.test(t)) || 'График работы уточняйте при бронировании';

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': absoluteUrl('/#organization'),
    name: 'Чё за Квест',
    url: absoluteUrl('/'),
    logo: absoluteAssetUrl(site.header.logo),
    telephone: site.header.phone,
    email: email ? email.href.replace('mailto:', '') : undefined,
    sameAs: vk ? [vk.href] : undefined,
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: site.header.phone,
      contactType: 'reservations',
      areaServed: 'RU',
      availableLanguage: 'Russian',
    },
    location: venues.map((venue) => ({
      '@type': 'Place',
      '@id': absoluteUrl(`/${venue.slug}#location`),
      name: `Чё за Квест — ${venue.address}`,
      url: absoluteUrl(`/${venue.slug}`),
    })),
  },
  breadcrumbs.length > 0 && breadcrumbJsonLd(breadcrumbs, path),
].filter(Boolean);
---
<Layout title={seo.title} description={seo.description} keywords={seo.keywords}
        path={path} jsonld={jsonld} preloadImage={null}>
  <Header />

  <main>
    <Breadcrumbs items={breadcrumbs} />

    <section class="info">
      <div class="container">
        <h1 class="section-title">{seo.h1}</h1>
        <div class="info__grid">
          <div class="info__card">
            <div class="info__label">Телефон</div>
            <a class="info__value info__value--big" href={site.header.phoneHref}>{site.header.phone}</a>
            <div class="info__hours">{hours}</div>
          </div>
          {email && (
            <div class="info__card">
              <div class="info__label">Почта</div>
              <a class="info__value" href={email.href}>{email.href.replace('mailto:', '')}</a>
            </div>
          )}
          <div class="info__card">
            <div class="info__label">Мессенджеры и соцсети</div>
            <div class="info__row">
              <a class="info__chip" href={site.header.wa} target="_blank" rel="noopener">WhatsApp</a>
              {vk && <a class="info__chip" href={vk.href} target="_blank" rel="noopener">ВКонтакте</a>}
            </div>
          </div>
        </div>

        {venues.length > 0 && (
          <div class="info__venues">
            <h2 class="section-title">Наши площадки</h2>
            <ul class="cvenues__list">
              {venues.map((v) => (<li><a href={link('/' + v.slug)}>{v.address}</a></li>))}
            </ul>
          </div>
        )}

      </div>
    </section>

    <VenuesSection id={`venues-${page.slug}`} base={base} />

    <CallbackForm id="i" />
  </main>

  <Footer />
</Layout>

<script>
  import '../scripts/main.js';
</script>
